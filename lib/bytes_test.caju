import "std/bytes"
import { describe, it, expect, before_each } from "std/testing"

describe("bytes.Buffer", fn() {
  let b: *bytes.Buffer = nil
  before_each(fn() {
    b = bytes.new_buffer(0)
    for i := 0; i < 300; i++ { b.byte(i) }
    b.u32(0xDEADBEEF)
    b.u64(-2)
    b.write("caju")
  })
  it("grows as bytes, integers and texts are written", fn() {
    expect(b.len()).to_equal(316)
  })
  it("keeps only the low 8 bits of a byte", fn() {
    expect(b.get(255)).to_equal(255)
    expect(b.get(256)).to_equal(0)
  })
  it("writes integers in little-endian order", fn() {
    expect(b.get_u32(300)).to_equal(3735928559)
    expect(b.get_u64(304)).to_equal(-2)
  })
  it("overwrites a 32-bit integer in place", fn() {
    b.set_u32(0, 0x01020304)
    expect(b.get(0)).to_equal(4)
    expect(b.get(3)).to_equal(1)
  })
  it("returns a slice of its bytes as text", fn() {
    expect(b.slice(312, 316)).to_equal("caju")
  })
  it("appends another buffer", fn() {
    c := bytes.new_buffer(4)
    c.write("xy")
    c.append(b)
    expect(c.len()).to_equal(318)
    expect(c.slice(0, 2)).to_equal("xy")
    expect(len(c.string())).to_equal(318)
  })
})
