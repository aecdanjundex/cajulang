# used by testing_test.caju: a test file with passing, failing and skipped tests
import { describe, it, skip, expect, before_each } from "std/testing"

let count: int = 0

describe("a sample", fn() {
  before_each(fn() { count++ })
  it("passes", fn() { expect(count).to_equal(1) })
  it("fails with a message", fn() { expect([]int{1, 2}).to_equal([]int{1, 3}) })
  describe("inside", fn() {
    it("stops at a runtime error", fn() {
      xs := []int{}
      print(xs[2])
    })
    skip("is not written yet", fn() {})
  })
})
