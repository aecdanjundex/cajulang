# std/json: JSON (RFC 8259) in the style of Go's encoding/json.
#
#   s, err := json.marshal(v)                  # any value -> JSON text
#   s, err := json.marshal_indent(v, "  ")     # the same, one item per line
#   err := json.unmarshal(text, &v)            # JSON text -> the value v points to
#   doc, err := json.parse(text)               # JSON text -> a *json.Value tree
#   doc.get_str("user.name", "")               # getters with dotted paths, like std/toml
#   json.valid(text), json.quote(s)
#
# Types (marshal and unmarshal):
#   struct, *struct      object with the field names, in the order they are declared; an embedded
#                        struct (a field named after its type) has its fields promoted
#   []T, [N]T            array (a nil list is null)
#   map[str]T, map[int]T object; marshal writes the keys in alphabetical order
#   str, bool, int (all sizes), num, float32
#   any, interfaces      the value inside; error values become their message (marshal only)
#   *json.Value          the tree itself (a field of this type keeps that part of the document)
#   nil, nil pointer, nil map -> null
# Functions and other types are an error. map[str]any{"id": 1, "tags": []str{"a"}} works as an
# ad hoc object (like gin.H).
#
# unmarshal into any gives map[str]any for objects, []any for arrays, int for numbers written
# without fraction or exponent (that fit 64 bits) and num for the other numbers, str, bool, nil.
# Keys without a matching field are ignored (a field also matches without regard to case), fields
# missing from the text keep their value, and null leaves non-nullable values as they are.
#
# The reflection works on the runtime's type descriptors (see rt/values.caju): [0] kind, [8] count,
# [16] element, [24] key, [32] name, [40] fields (name, descriptor, value?) and [48] integer kind.
# Speed (bench/json/RESULTS.md): marshal keeps a plan per struct type and its own byte buffer;
# unmarshal checks the text against the target type first (vtyped) and then decodes it straight
# into memory (Fast), falling back to the tree (parse + Dec) for anything vtyped refuses, so the
# errors and the values stay the same as through the tree.

import "std/strings"
import "std/strconv"
import "std/math"
import "std/toml"

# ---------------------------------------------------------------- the tree

# a JSON value; kind is "object", "array", "string", "number", "bool" or "null"
export struct Value {
  kind: str
  s: str                       # string; for numbers, the text as written
  n: num                       # number
  i: int                       # number, when is_int
  is_int: bool                 # a number without fraction or exponent that fits 64 bits
  b: bool                      # bool
  items: []*Value              # array
  keys: []str                  # object: the keys in order (each once)
  fields: map[str]*Value       # object
}

# the value of one key of an object, or nil
export fn (v: *Value) field(key: str) -> *Value {
  if v == nil || v.kind != "object" { return nil }
  return v.fields[key]
}

# the value at a dotted path ("user.name"; "items.0.id" indexes arrays; "" is v itself), or nil
export fn (v: *Value) get(path: str) -> *Value {
  if path == "" { return v }
  cur := v
  for _, part := range strings.split(path, ".") {
    if cur == nil { return nil }
    if cur.kind == "object" {
      cur = cur.fields[part]
    } else if cur.kind == "array" {
      k, err := strconv.atoi(part)
      if err != nil || k < 0 || k >= len(cur.items) { return nil }
      cur = cur.items[k]
    } else { return nil }
  }
  return cur
}

export fn (v: *Value) get_str(path: str, def: str) -> str {
  x := v.get(path)
  if x == nil || x.kind != "string" { return def }
  return x.s
}
# an integer (a number with a fraction is truncated)
export fn (v: *Value) get_int(path: str, def: int) -> int {
  x := v.get(path)
  if x == nil || x.kind != "number" { return def }
  if x.is_int { return x.i }
  return int(x.n)
}
export fn (v: *Value) get_float(path: str, def: num) -> num {
  x := v.get(path)
  if x == nil || x.kind != "number" { return def }
  return x.n
}
export fn (v: *Value) get_bool(path: str, def: bool) -> bool {
  x := v.get(path)
  if x == nil || x.kind != "bool" { return def }
  return x.b
}
# the items of an array (nil if the path is not an array)
export fn (v: *Value) get_array(path: str) -> []*Value {
  x := v.get(path)
  if x == nil || x.kind != "array" { return nil }
  return x.items
}
# the keys of an object, in order (empty if the path is not an object)
export fn (v: *Value) get_keys(path: str) -> []str {
  x := v.get(path)
  if x == nil || x.kind != "object" { return []str{} }
  return x.keys
}
export fn (v: *Value) is_null() -> bool { return v == nil || v.kind == "null" }
# the value as plain Caju values: map[str]any, []any, int, num, str, bool or nil
export fn (v: *Value) to_any() -> any {
  if v == nil { return nil }
  switch v.kind {
  case "object":
    m := map[str]any{}
    for _, k := range v.keys { m[k] = v.fields[k].to_any() }
    return m
  case "array":
    l := make([]any, len(v.items))
    for i, x := range v.items { l[i] = x.to_any() }
    return l
  case "string": return v.s
  case "number":
    if v.is_int { return v.i }
    return v.n
  case "bool": return v.b
  }
  return nil
}
# the value as JSON text
export fn (v: *Value) string() -> str {
  e := new_enc("")
  e.tree(v, 0)
  return e.result()
}

# ---------------------------------------------------------------- parsing

struct Parser {
  s: str
  i: int
  depth: int
  err: str
}

const MAX_DEPTH = 1000

export fn parse(text: str) -> (*Value, error) {
  p := &Parser{s: text, i: 0, depth: 0, err: ""}
  p.space()
  v := p.value()
  if len(p.err) == 0 {
    p.space()
    if p.i < len(p.s) { p.fail("invalid character " + p.show() + " after the value") }
  }
  if len(p.err) != 0 { return nil, errors.New(p.err) }
  return v, nil
}

export fn valid(text: str) -> bool { return vscan(text) != nil }

# records the first error, with the line and column of the current position
fn (p: *Parser) fail(msg: str) {
  if len(p.err) != 0 { return }
  line := 1
  col := 1
  for k := 0; k < p.i && k < len(p.s); k++ {
    if p.s[k] == 10 {
      line++
      col = 1
    } else if (int(p.s[k]) & 192) != 128 { col++ }
  }
  p.err = "json: syntax error at line " + str(line) + ", column " + str(col) + ": " + msg
}

# the character at the current position, for messages
fn (p: *Parser) show() -> str {
  if p.i >= len(p.s) { return "end of input" }
  c := int(p.s[p.i])
  if c < 32 { return "'\\x" + strconv.format_int(c, 16) + "'" }
  k := p.i + 1
  while k < len(p.s) && (int(p.s[k]) & 192) == 128 { k++ }
  return "'" + p.s[p.i:k] + "'"
}

fn (p: *Parser) space() {
  s := p.s
  n := len(s)
  i := p.i
  while i < n {
    c := s[i]
    if c != 32 && c != 10 && c != 13 && c != 9 { break }
    i++
  }
  p.i = i
}

fn (p: *Parser) value() -> *Value {
  if p.i >= len(p.s) {
    p.fail("unexpected end of input, expecting a value")
    return nil
  }
  c := int(p.s[p.i])
  if c == 123 { return p.object() }
  if c == 91 { return p.array() }
  if c == 34 {
    s := p.string()
    return &Value{kind: "string", s: s}
  }
  if c == 45 || (c >= 48 && c <= 57) { return p.number() }
  if p.word("true") { return &Value{kind: "bool", b: true} }
  if p.word("false") { return &Value{kind: "bool", b: false} }
  if p.word("null") { return &Value{kind: "null"} }
  p.fail("invalid character " + p.show() + " looking for the beginning of a value")
  return nil
}

fn (p: *Parser) word(w: str) -> bool {
  m := len(w)
  if p.i + m > len(p.s) { return false }
  q := __strp(p.s) + 8 + p.i
  for k := 0; k < m; k++ { if __load8(q + k) != int(w[k]) { return false } }
  p.i += m
  return true
}

fn (p: *Parser) object() -> *Value {
  p.depth++
  if p.depth > MAX_DEPTH {
    p.fail("nesting deeper than " + str(MAX_DEPTH) + " levels")
    return nil
  }
  v := &Value{kind: "object", keys: []str{}, fields: map[str]*Value{}}
  p.i++
  p.space()
  if p.i < len(p.s) && p.s[p.i] == 125 {
    p.i++
    p.depth--
    return v
  }
  while len(p.err) == 0 {
    p.space()
    if p.i >= len(p.s) || p.s[p.i] != 34 {
      p.fail("invalid character " + p.show() + " looking for the beginning of an object key")
      return nil
    }
    k := p.string()
    p.space()
    if p.i >= len(p.s) || p.s[p.i] != 58 {
      p.fail("invalid character " + p.show() + " after an object key (expecting ':')")
      return nil
    }
    p.i++
    p.space()
    x := p.value()
    if len(p.err) != 0 { return nil }
    if _, seen := v.fields[k]; !seen { v.keys = append(v.keys, k) }
    v.fields[k] = x
    p.space()
    if p.i < len(p.s) && p.s[p.i] == 44 {
      p.i++
      continue
    }
    if p.i < len(p.s) && p.s[p.i] == 125 {
      p.i++
      p.depth--
      return v
    }
    p.fail("invalid character " + p.show() + " after an object value (expecting ',' or '}')")
  }
  return nil
}

fn (p: *Parser) array() -> *Value {
  p.depth++
  if p.depth > MAX_DEPTH {
    p.fail("nesting deeper than " + str(MAX_DEPTH) + " levels")
    return nil
  }
  v := &Value{kind: "array", items: []*Value{}}
  p.i++
  p.space()
  if p.i < len(p.s) && p.s[p.i] == 93 {
    p.i++
    p.depth--
    return v
  }
  while len(p.err) == 0 {
    p.space()
    x := p.value()
    if len(p.err) != 0 { return nil }
    v.items = append(v.items, x)
    p.space()
    if p.i < len(p.s) && p.s[p.i] == 44 {
      p.i++
      continue
    }
    if p.i < len(p.s) && p.s[p.i] == 93 {
      p.i++
      p.depth--
      return v
    }
    p.fail("invalid character " + p.show() + " after an array item (expecting ',' or ']')")
  }
  return nil
}

fn is_digit(c: int) -> bool { return c >= 48 && c <= 57 }

fn (p: *Parser) number() -> *Value {
  s := p.s
  n := len(s)
  start := p.i
  i := p.i
  if s[i] == 45 { i++ }
  if i >= n || !is_digit(int(s[i])) {
    p.i = i
    p.fail("invalid character " + p.show() + " in a number (expecting a digit)")
    return nil
  }
  if s[i] == 48 {
    i++
    if i < n && is_digit(int(s[i])) {
      p.i = i
      p.fail("invalid character " + p.show() + " after a leading zero")
      return nil
    }
  } else {
    while i < n && is_digit(int(s[i])) { i++ }
  }
  integral := true
  if i < n && s[i] == 46 {
    integral = false
    i++
    if i >= n || !is_digit(int(s[i])) {
      p.i = i
      p.fail("invalid character " + p.show() + " after a decimal point (expecting a digit)")
      return nil
    }
    while i < n && is_digit(int(s[i])) { i++ }
  }
  if i < n && (s[i] == 101 || s[i] == 69) {
    integral = false
    i++
    if i < n && (s[i] == 43 || s[i] == 45) { i++ }
    if i >= n || !is_digit(int(s[i])) {
      p.i = i
      p.fail("invalid character " + p.show() + " in an exponent (expecting a digit)")
      return nil
    }
    while i < n && is_digit(int(s[i])) { i++ }
  }
  p.i = i
  text := sub_ascii(s, start, i)
  v := &Value{kind: "number", s: text}
  if integral {
    k, err := strconv.parse_int(text, 10)
    if err == nil {
      v.is_int = true
      v.i = k
      v.n = num(k)
      return v
    }
  }
  f, err2 := strconv.parse_float(text)
  if err2 != nil {
    p.i = start
    p.fail("number " + text + " out of range")
    return nil
  }
  v.n = f
  return v
}

fn hex_val(c: int) -> int {
  if c >= 48 && c <= 57 { return c - 48 }
  if c >= 97 && c <= 102 { return c - 87 }
  if c >= 65 && c <= 70 { return c - 55 }
  return -1
}

# four hex digits at p.i (after "\u"), or -1
fn (p: *Parser) hex4() -> int {
  if p.i + 4 > len(p.s) { return -1 }
  r := 0
  for k := 0; k < 4; k++ {
    h := hex_val(int(p.s[p.i + k]))
    if h < 0 { return -1 }
    r = r * 16 + h
  }
  p.i += 4
  return r
}

# a string at p.i (the opening quote), without the quotes and with the escapes decoded
fn (p: *Parser) string() -> str {
  s := p.s
  n := len(s)
  p.i++
  start := p.i
  # fast path: no escapes
  i := p.i
  high := false
  q := __strp(s) + 8
  while i < n {
    ch := __load8(q + i)
    if ch == 34 || ch == 92 || ch < 32 { break }
    if ch >= 128 { high = true }
    i++
  }
  if i < n && __load8(q + i) == 34 {
    p.i = i + 1
    if high { return s[start:i] }
    return sub_ascii(s, start, i)
  }
  b := &strings.Builder{}
  b.write(s[start:i])
  p.i = i
  while true {
    if p.i >= n {
      p.fail("unexpected end of input in a string")
      return ""
    }
    c := int(s[p.i])
    if c == 34 {
      p.i++
      return b.string()
    }
    if c < 32 {
      p.fail("invalid character " + p.show() + " in a string (control characters must be escaped)")
      return ""
    }
    if c != 92 {
      j := p.i
      while j < n && s[j] != 34 && s[j] != 92 && s[j] >= 32 { j++ }
      b.write(s[p.i:j])
      p.i = j
      continue
    }
    p.i++
    if p.i >= n {
      p.fail("unexpected end of input in a string")
      return ""
    }
    e := int(s[p.i])
    p.i++
    switch e {
    case 34: b.write_byte(34)
    case 92: b.write_byte(92)
    case 47: b.write_byte(47)
    case 98: b.write_byte(8)
    case 102: b.write_byte(12)
    case 110: b.write_byte(10)
    case 114: b.write_byte(13)
    case 116: b.write_byte(9)
    case 117:
      r := p.hex4()
      if r < 0 {
        p.fail("invalid \\u escape (expecting 4 hex digits)")
        return ""
      }
      if r >= 0xD800 && r < 0xDC00 {
        # a high surrogate: a low one must follow, else the character is invalid (U+FFFD)
        lo := -1
        if p.i + 6 <= n && s[p.i] == 92 && s[p.i + 1] == 117 {
          save := p.i
          p.i += 2
          lo = p.hex4()
          if lo < 0xDC00 || lo >= 0xE000 {
            lo = -1
            p.i = save
          }
        }
        if lo < 0 { r = 0xFFFD } else { r = 0x10000 + ((r - 0xD800) << 10) + (lo - 0xDC00) }
      } else if r >= 0xDC00 && r < 0xE000 { r = 0xFFFD }
      b.write_rune(r)
    default:
      p.i--
      p.fail("invalid escape " + p.show() + " in a string")
      return ""
    }
  }
  return ""
}

# ---------------------------------------------------------------- memory helpers

# copies n bytes from src to dst, 8 at a time
fn copy_mem(dst: int, src: int, n: int) {
  i := 0
  while i + 8 <= n {
    __store64(dst + i, __load64(src + i))
    i += 8
  }
  while i < n {
    __store8(dst + i, __load8(src + i))
    i++
  }
}

# bytes [a, b) of s as a new string, for a part known to be ASCII (no UTF-8 check needed)
fn sub_ascii(s: str, a: int, b: int) -> str {
  m := __newstr(b - a)
  copy_mem(m + 8, __strp(s) + 8 + a, b - a)
  return __pstr(m)
}

# ---------------------------------------------------------------- quoting

const HEX = "0123456789abcdef"

# s as a JSON string, with quotes and escapes (UTF-8 text is kept as it is)
export fn quote(s: str) -> str {
  e := new_enc("")
  e.put_quoted(s)
  return e.result()
}

# ---------------------------------------------------------------- descriptors

fn dkind(d: int) -> int { return __load64(d) }
fn dname(d: int) -> str { return __pstr(__load64(d + 32)) }
fn delem(d: int) -> int { return __load64(d + 16) }
fn dkey(d: int) -> int { return __load64(d + 24) }
fn dcount(d: int) -> int { return __load64(d + 8) }
fn field_name(d: int, i: int) -> str { return __pstr(__load64(__load64(d + 40) + 24 * i)) }
fn field_desc(d: int, i: int) -> int { return __load64(__load64(d + 40) + 24 * i + 8) }

# the descriptor of *Value (a field of this type holds a part of the tree)
let value_desc: int = 0
fn value_ptr_desc() -> int {
  if value_desc == 0 { value_desc = __load64(__anyp(&Value{kind: "null"})) }
  return value_desc
}

# an embedded struct: a field named after its own type (struct or pointer to struct)
fn embedded(d: int, i: int) -> bool {
  fd := field_desc(d, i)
  if dkind(fd) == 9 { fd = delem(fd) }
  if dkind(fd) != 8 { return false }
  nm := dname(fd)
  dot := strings.last_index(nm, ".")
  if dot >= 0 { nm = nm[dot + 1:] }
  return nm == field_name(d, i)
}

# what marshal and unmarshal need to know about a struct type, computed once per type
struct Plan {
  n: int
  names: []str
  keys: []str          # "name": (compact output)
  ckeys: []str         # ,"name": (compact output, after another field)
  qnames: []str        # "name"
  descs: []int
  emb: []bool
  fast_dec: bool       # the direct decoder handles it (no embedded fields, ASCII names that
                       # differ also without regard to case, at most 62 fields)
  flat: bool           # only str, int and bool fields, none embedded (Enc.flat writes it)
  kinds: []int         # the kind of each field
  kbytes: int          # bytes of {, the keys with their commas and }
  vkinds: []int        # for the decoder: 5 str, 1 int or int64, 4 bool, 0 anything else
  prog: int            # flat plans: [name bytes, name length, vkind] per field, for vflat
}

let plans = map[int]*Plan{}

fn ascii(s: str) -> bool {
  for i := 0; i < len(s); i++ { if int(s[i]) >= 128 { return false } }
  return true
}

let plan_last_d: int = 0
let plan_last: *Plan = nil

fn plan_of(d: int) -> *Plan {
  if d == plan_last_d { return plan_last }
  if pl, ok := plans[d]; ok {
    plan_last_d = d
    plan_last = pl
    return pl
  }
  n := dcount(d)
  pl := &Plan{n: n, names: []str{}, keys: []str{}, ckeys: []str{}, qnames: []str{}, descs: []int{}, emb: []bool{}, fast_dec: n <= 62, flat: n > 0, kinds: []int{}, kbytes: 2, vkinds: []int{}}
  lows := map[str]bool{}
  for i := 0; i < n; i++ {
    nm := field_name(d, i)
    q := quote(nm)
    pl.names = append(pl.names, nm)
    pl.qnames = append(pl.qnames, q)
    pl.keys = append(pl.keys, q + ":")
    pl.ckeys = append(pl.ckeys, "," + q + ":")
    pl.descs = append(pl.descs, field_desc(d, i))
    em := embedded(d, i)
    pl.emb = append(pl.emb, em)
    fk := dkind(field_desc(d, i))
    pl.kinds = append(pl.kinds, fk)
    if em || (fk != 1 && fk != 4 && fk != 5) { pl.flat = false }
    if i == 0 { pl.kbytes += len(q) + 1 } else { pl.kbytes += len(q) + 2 }
    vk := 0
    if fk == 5 || fk == 4 { vk = fk }
    if fk == 1 {
      _, _, ranged := int_range_of(field_desc(d, i))
      if !ranged { vk = 1 }
    }
    pl.vkinds = append(pl.vkinds, vk)
    low := strings.to_lower(nm)
    if em || !ascii(nm) || lows[low] { pl.fast_dec = false }
    lows[low] = true
  }
  if pl.flat {
    pl.prog = __alloc(24 * n)
    for i := 0; i < n; i++ {
      __store64(pl.prog + 24 * i, __strp(pl.names[i]) + 8)
      __store64(pl.prog + 24 * i + 8, len(pl.names[i]))
      __store64(pl.prog + 24 * i + 16, pl.vkinds[i])
    }
  }
  plans[d] = pl
  plan_last_d = d
  plan_last = pl
  return pl
}

# a word of type d as an any (a new box)
fn word_any(w: int, d: int) -> any {
  b := __alloc(16)
  __store64(b, d)
  __store64(b + 8, w)
  return __pany(b)
}

# element i of a list or array data block (bool elements take one byte)
fn eload(data: int, i: int, ed: int) -> int {
  if dkind(ed) == 4 { return __load8(data + i) }
  return __load64(data + 8 * i)
}
fn estore(data: int, i: int, ed: int, w: int) {
  if dkind(ed) == 4 {
    __store8(data + i, w)
    return
  }
  __store64(data + 8 * i, w)
}

# ---------------------------------------------------------------- marshal

# the encoder writes into its own string block (mem: [length][bytes][0], see __newstr)
struct Enc {
  mem: int
  n: int
  cap: int
  indent: str
  pretty: bool         # indent != ""
  err: str
  last_d: int          # the struct type encoded last and its plan (lists of the same struct)
  last_plan: *Plan
}

# a buffer kept between calls (taken while an encoder uses it: a nested marshal, from an
# Error method, gets its own)
let spare_mem: int = 0
let spare_cap: int = 0

fn new_enc(indent: str) -> *Enc {
  e := &Enc{indent: indent, pretty: indent != "", err: ""}
  if spare_mem != 0 {
    e.mem = spare_mem
    e.cap = spare_cap
    spare_mem = 0
  }
  return e
}

fn (e: *Enc) grow(extra: int) {
  if e.n + extra <= e.cap { return }
  c := e.cap * 2
  if c < 256 { c = 256 }
  while c < e.n + extra { c = c * 2 }
  m := __newstr(c)
  if e.n > 0 { copy_mem(m + 8, e.mem + 8, e.n) }
  e.mem = m
  e.cap = c
}

fn (e: *Enc) put(s: str) {
  n := len(s)
  if e.n + n > e.cap { e.grow(n) }
  dst := e.mem + 8 + e.n
  src := __strp(s) + 8
  i := 0
  while i + 8 <= n {
    __store64(dst + i, __load64(src + i))
    i += 8
  }
  while i < n {
    __store8(dst + i, __load8(src + i))
    i++
  }
  e.n += n
}

fn (e: *Enc) put_byte(c: int) {
  if e.n >= e.cap { e.grow(1) }
  __store8(e.mem + 8 + e.n, c)
  e.n++
}

# the text written, as a new string; the buffer goes back for the next encoder
fn (e: *Enc) result() -> str {
  m := __newstr(e.n)
  if e.n > 0 { copy_mem(m + 8, e.mem + 8, e.n) }
  if e.cap > 0 && e.cap <= 1048576 {
    spare_mem = e.mem
    spare_cap = e.cap
  }
  e.mem = 0
  e.cap = 0
  return __pstr(m)
}

fn (e: *Enc) put_int(x0: int) {
  x := x0
  if x < 0 {
    if x == (1 << 63) {
      e.put(str(x))
      return
    }
    e.put_byte(45)
    x = -x
  }
  if x < 10 {
    e.put_byte(48 + x)
    return
  }
  nd := 0
  t := x
  while t > 0 {
    nd++
    t = t / 10
  }
  if e.n + nd > e.cap { e.grow(nd) }
  q := e.mem + 8 + e.n + nd - 1
  while x > 0 {
    __store8(q, 48 + x % 10)
    x = x / 10
    q--
  }
  e.n += nd
}

# bytes [a, b) of s; a part with non-ASCII bytes goes through s[a:b], which checks the UTF-8
fn (e: *Enc) put_run(s: str, a: int, b: int, high: bool) {
  if a >= b { return }
  if high {
    e.put(s[a:b])
    return
  }
  if e.n + b - a > e.cap { e.grow(b - a) }
  copy_mem(e.mem + 8 + e.n, __strp(s) + 8 + a, b - a)
  e.n += b - a
}

# ---- leaf writers for the flat-struct path: they take and return the write position and call
# nothing, so all their variables live in registers

# n bytes from p to o; returns o + n
fn wcopy(o0: int, p0: int, n: int) -> int {
  o := o0
  p := p0
  e := o0 + n
  while o + 8 <= e {
    __store64(o, __load64(p))
    o += 8
    p += 8
  }
  while o < e {
    __store8(o, __load8(p))
    o++
    p++
  }
  return e
}

# the string block s between quotes at o; returns the new position, or 0 when s has a byte that
# needs an escape or is not ASCII (the caller then takes the general path). 8 bytes at a time:
# a byte is bad when it has the high bit, is below 0x20, or equals 0x22 or 0x5c.
fn wquote(o0: int, s: int) -> int {
  o := o0
  __store8(o, 34)
  o++
  if s == 0 {
    __store8(o, 34)
    return o + 1
  }
  p := s + 8
  e := p + __load64(s)
  lo := (16843009 << 32) | 16843009
  while p + 8 <= e {
    x := __load64(p)
    q := x ^ (lo * 34)
    b := x ^ (lo * 92)
    bad := (x | ((x - (lo << 5)) & (x ^ -1)) | ((q - lo) & (q ^ -1)) | ((b - lo) & (b ^ -1))) & (lo << 7)
    if bad != 0 { return 0 }
    __store64(o, x)
    o += 8
    p += 8
  }
  while p < e {
    c := __load8(p)
    if c < 32 || c == 34 || c == 92 || c >= 128 { return 0 }
    __store8(o, c)
    o++
    p++
  }
  __store8(o, 34)
  return o + 1
}

# the decimal digits of x at o; returns the new position
fn wint(o0: int, x0: int) -> int {
  o := o0
  x := x0
  if x < 0 {
    if x == (1 << 63) { return 0 }
    __store8(o, 45)
    o++
    x = -x
  }
  nd := 1
  t := x
  while t >= 10 {
    nd++
    t = t / 10
  }
  q := o + nd - 1
  while x >= 10 {
    __store8(q, 48 + x % 10)
    x = x / 10
    q--
  }
  __store8(q, 48 + x)
  return o + nd
}

# a struct with only str, int and bool fields, compact: room for the whole object is reserved
# once, then the leaf writers fill it
fn (e: *Enc) flat(w: int, pl: *Plan) {
  n := pl.n
  bound := pl.kbytes
  for i := 0; i < n; i++ {
    k := pl.kinds[i]
    if k == 5 {
      fw := __load64(w + 8 * i)
      if fw != 0 { bound += 6 * __load64(fw) + 2 } else { bound += 2 }
    } else { bound += 21 }
  }
  if e.n + bound > e.cap { e.grow(bound) }
  base := e.mem + 8
  o := base + e.n
  __store8(o, 123)
  o++
  for i := 0; i < n; i++ {
    key := pl.ckeys[i]
    if i == 0 { key = pl.keys[i] }
    o = wcopy(o, __strp(key) + 8, len(key))
    fw := __load64(w + 8 * i)
    k := pl.kinds[i]
    if k == 5 {
      q := wquote(o, fw)
      if q == 0 {
        e.n = o - base
        e.put_quoted(__pstr(fw))
        o = base + e.n
      } else { o = q }
    } else if k == 1 {
      q := wint(o, fw)
      if q == 0 {
        e.n = o - base
        e.put_int(fw)
        o = base + e.n
      } else { o = q }
    } else if fw != 0 {
      o = wcopy(o, __strp("true") + 8, 4)
    } else { o = wcopy(o, __strp("false") + 8, 5) }
  }
  __store8(o, 125)
  e.n = o + 1 - base
}

fn (e: *Enc) put_quoted(s: str) {
  n := len(s)
  if e.n + n + 2 > e.cap { e.grow(n + 2) }
  p := __strp(s) + 8
  j := 0
  while j < n {
    c := __load8(p + j)
    if c < 32 || c == 34 || c == 92 || c >= 128 { break }
    j++
  }
  if j == n {
    o := e.mem + 8 + e.n
    __store8(o, 34)
    i0 := 0
    while i0 + 8 <= n {
      __store64(o + 1 + i0, __load64(p + i0))
      i0 += 8
    }
    while i0 < n {
      __store8(o + 1 + i0, __load8(p + i0))
      i0++
    }
    __store8(o + 1 + n, 34)
    e.n += n + 2
    return
  }
  e.put_byte(34)
  start := 0
  high := false
  i := 0
  while i < n {
    c := __load8(p + i)
    if c >= 128 {
      high = true
      i++
      continue
    }
    if c >= 32 && c != 34 && c != 92 {
      i++
      continue
    }
    e.put_run(s, start, i, high)
    high = false
    switch c {
    case 34: e.put("\\\"")
    case 92: e.put("\\\\")
    case 10: e.put("\\n")
    case 13: e.put("\\r")
    case 9: e.put("\\t")
    case 8: e.put("\\b")
    case 12: e.put("\\f")
    default:
      e.put("\\u00")
      e.put_byte(int(HEX[c >> 4]))
      e.put_byte(int(HEX[c & 15]))
    }
    i++
    start = i
  }
  e.put_run(s, start, n, high)
  e.put_byte(34)
}

export fn marshal(v: any) -> (str, error) { return encode(v, "") }

export fn marshal_indent(v: any, indent: str) -> (str, error) { return encode(v, indent) }

fn encode(v: any, indent: str) -> (str, error) {
  e := new_enc(indent)
  box := __anyp(v)
  if box == 0 { e.put("null") } else { e.word(__load64(box + 8), __load64(box), 0) }
  out := e.result()
  if len(e.err) != 0 { return "", errors.New(e.err) }
  return out, nil
}

fn (e: *Enc) newline(depth: int) {
  if !e.pretty { return }
  e.put_byte(10)
  for k := 0; k < depth; k++ { e.put(e.indent) }
}

fn (e: *Enc) colon() {
  if !e.pretty { e.put_byte(58) } else { e.put(": ") }
}

# a number as JSON: the shortest text that reads back the same, without ".0" for integers
fn format_num(x: num) -> str {
  if x == 0.0 { return "0" }
  if x == math.trunc(x) && x < 1e21 && x > -1e21 {
    if x < 9.2e18 && x > -9.2e18 { return str(int(x)) }
  }
  q := short_fixed(x)
  if q != "" { return q }
  t := toml.format_float(x)
  if strings.has_suffix(t, ".0") { t = t[0:len(t) - 2] }
  return t
}

let POW10 = []num{1.0, 10.0, 100.0, 1000.0, 10000.0, 100000.0, 1000000.0, 10000000.0, 100000000.0}

# x with the fewest decimal places (up to 8) that reads back as x, for 0.0001 <= |x| < 1e15 (the
# range toml.format_float writes without an exponent); "" when that does not settle it
fn short_fixed(x0: num) -> str {
  x := x0
  neg := x < 0.0
  if neg { x = -x }
  if x < 0.0001 || x >= 1e15 { return "" }
  for k := 1; k <= 8; k++ {
    m := x * POW10[k]
    if m >= 9e15 { return "" }
    r := int(math.floor(m + 0.5))
    ip := r
    fp := 0
    pw := 1
    for j := 0; j < k; j++ { pw = pw * 10 }
    ip = r / pw
    fp = r % pw
    if fp == 0 { continue }
    fs := str(fp)
    while len(fs) < k { fs = "0" + fs }
    while fs[len(fs) - 1] == 48 { fs = fs[0:len(fs) - 1] }
    t := str(ip) + "." + fs
    if neg { t = "-" + t }
    back, err := strconv.parse_float(t)
    if err == nil && back == x0 { return t }
  }
  return ""
}

fn (e: *Enc) word(w: int, d: int, depth: int) {
  if len(e.err) != 0 { return }
  if depth > MAX_DEPTH {
    e.err = "json: unsupported value: nesting deeper than " + str(MAX_DEPTH) + " levels (a cycle?)"
    return
  }
  if d == value_ptr_desc() {
    if w == 0 {
      e.put("null")
      return
    }
    t := word_any(w, d).(*Value)
    e.tree(t, depth)
    return
  }
  k := dkind(d)
  switch k {
  case 1:
    e.put_int(w)
  case 2:
    if w >= 0 { e.put_int(w) } else { e.put(str(uint64(w))) }
  case 3:
    x := __bitsf(w)
    if math.is_nan(x) || math.is_inf(x) {
      e.err = "json: unsupported value: " + str(x)
      return
    }
    if x == math.trunc(x) && x < 9.2e18 && x > -9.2e18 { e.put_int(int(x)) } else { e.put(format_num(x)) }
  case 4:
    if w != 0 { e.put("true") } else { e.put("false") }
  case 5:
    e.put_quoted(__pstr(w))
  case 6:
    if w == 0 {
      e.put("null")
      return
    }
    e.list(__load64(w), __load64(w + 8), delem(d), depth)
  case 7:
    e.list(w, dcount(d), delem(d), depth)
  case 8:
    if !e.pretty {
      pl := e.last_plan
      if d != e.last_d {
        pl = plan_of(d)
        e.last_d = d
        e.last_plan = pl
      }
      if pl.flat {
        e.flat(w, pl)
        return
      }
    }
    e.put_byte(123)
    if !e.fields(w, d, depth, true) { e.newline(depth) }
    e.put_byte(125)
  case 9:
    if w == 0 {
      e.put("null")
      return
    }
    ed := delem(d)
    if dkind(ed) == 7 || dkind(ed) == 8 { e.word(w, ed, depth) } else { e.word(__load64(w), ed, depth) }
  case 10:
    if w == 0 {
      e.put("null")
      return
    }
    e.map_obj(w, d, depth)
  case 11, 12, 13:
    if w == 0 {
      e.put("null")
      return
    }
    bd := d
    bw := w
    if k != 13 {
      bd = __load64(w)
      bw = __load64(w + 8)
    }
    if dkind(bd) == 13 || (k == 12 && dname(d) == "error") {
      a := word_any(bw, bd)
      if er, ok := a.(error); ok {
        e.put_quoted(er.Error())
        return
      }
    }
    e.word(bw, bd, depth)
  default:
    e.err = "json: unsupported type: " + dname(d)
  }
}

# the fields of a struct object (embedded structs promoted), after "{" or a previous field
# (first: nothing written yet); returns whether still nothing was written
fn (e: *Enc) fields(w: int, d: int, depth: int, first0: bool) -> bool {
  first := first0
  pl := e.last_plan
  if d != e.last_d {
    pl = plan_of(d)
    e.last_d = d
    e.last_plan = pl
  }
  n := pl.n
  for i := 0; i < n; i++ {
    fd := pl.descs[i]
    fw := __load64(w + 8 * i)
    if pl.emb[i] {
      if dkind(fd) == 9 {
        if fw == 0 { continue }
        fd = delem(fd)
      }
      first = e.fields(fw, fd, depth, first)
      if len(e.err) != 0 { return first }
      e.last_d = d
      e.last_plan = pl
      continue
    }
    if !e.pretty {
      if first { e.put(pl.keys[i]) } else { e.put(pl.ckeys[i]) }
      first = false
    } else {
      if !first { e.put_byte(44) }
      first = false
      e.newline(depth + 1)
      e.put(pl.qnames[i])
      e.put(": ")
    }
    k := dkind(fd)
    if k == 5 {
      e.put_quoted(__pstr(fw))
      continue
    }
    if k == 1 {
      e.put_int(fw)
      continue
    }
    if k == 4 {
      if fw != 0 { e.put("true") } else { e.put("false") }
      continue
    }
    e.word(fw, fd, depth + 1)
    if len(e.err) != 0 { return first }
    if e.last_d != d {
      e.last_d = d
      e.last_plan = pl
    }
  }
  return first
}

fn (e: *Enc) list(data: int, n: int, ed: int, depth: int) {
  e.put_byte(91)
  if !e.pretty && dkind(ed) == 8 && depth < MAX_DEPTH {
    pl := plan_of(ed)
    if pl.flat {
      for i := 0; i < n; i++ {
        if i > 0 { e.put_byte(44) }
        e.flat(__load64(data + 8 * i), pl)
      }
      e.put_byte(93)
      return
    }
  }
  for i := 0; i < n; i++ {
    if i > 0 { e.put_byte(44) }
    if e.pretty { e.newline(depth + 1) }
    e.word(eload(data, i, ed), ed, depth + 1)
    if len(e.err) != 0 { return }
  }
  if n > 0 { e.newline(depth) }
  e.put_byte(93)
}

fn (e: *Enc) map_obj(m: int, d: int, depth: int) {
  kd := dkey(d)
  vd := delem(d)
  kk := dkind(kd)
  if kk != 5 && kk != 1 && kk != 2 {
    e.err = "json: unsupported type: " + dname(d) + " (map keys must be strings or integers)"
    return
  }
  used := __load64(m + 16)
  entries := __load64(m + 8)
  dead := __load64(m + 56)
  keys := make([]str, used)
  vals := make([]int, used)
  cnt := 0
  for i := 0; i < used; i++ {
    if dead != 0 && __load8(dead + i) != 0 { continue }
    kw := __load64(entries + 16 * i)
    ks := ""
    if kk == 5 { ks = __pstr(kw) } else if kk == 2 { ks = str(uint64(kw)) } else { ks = str(kw) }
    keys[cnt] = ks
    vals[cnt] = __load64(entries + 16 * i + 8)
    cnt++
  }
  keys = keys[0:cnt]
  vals = vals[0:cnt]
  sort_pairs(keys, vals)
  e.put_byte(123)
  for i := 0; i < len(keys); i++ {
    if i > 0 { e.put_byte(44) }
    e.newline(depth + 1)
    e.put_quoted(keys[i])
    e.colon()
    e.word(vals[i], vd, depth + 1)
    if len(e.err) != 0 { return }
  }
  if len(keys) > 0 { e.newline(depth) }
  e.put_byte(125)
}

fn (e: *Enc) tree(v: *Value, depth: int) {
  if v == nil {
    e.put("null")
    return
  }
  switch v.kind {
  case "object":
    e.put_byte(123)
    for i, k := range v.keys {
      if i > 0 { e.put_byte(44) }
      e.newline(depth + 1)
      e.put_quoted(k)
      e.colon()
      e.tree(v.fields[k], depth + 1)
    }
    if len(v.keys) > 0 { e.newline(depth) }
    e.put_byte(125)
  case "array":
    e.put_byte(91)
    for i, x := range v.items {
      if i > 0 { e.put_byte(44) }
      e.newline(depth + 1)
      e.tree(x, depth + 1)
    }
    if len(v.items) > 0 { e.newline(depth) }
    e.put_byte(93)
  case "string": e.put_quoted(v.s)
  case "number":
    if v.s != "" { e.put(v.s) } else if v.is_int { e.put(str(v.i)) } else { e.put(format_num(v.n)) }
  case "bool":
    if v.b { e.put("true") } else { e.put("false") }
  default: e.put("null")
  }
}

# sorts the keys in place, moving each value with its key (merge sort: maps can be large)
fn sort_pairs(a: []str, v: []int) {
  n := len(a)
  if n < 2 { return }
  if n <= 12 {
    for i := 1; i < n; i++ {
      x := a[i]
      y := v[i]
      j := i - 1
      while j >= 0 && a[j] > x {
        a[j + 1] = a[j]
        v[j + 1] = v[j]
        j--
      }
      a[j + 1] = x
      v[j + 1] = y
    }
    return
  }
  mid := n / 2
  la := make([]str, mid)
  lv := make([]int, mid)
  ra := make([]str, n - mid)
  rv := make([]int, n - mid)
  copy(la, a[0:mid])
  copy(lv, v[0:mid])
  copy(ra, a[mid:n])
  copy(rv, v[mid:n])
  sort_pairs(la, lv)
  sort_pairs(ra, rv)
  i := 0
  j := 0
  k := 0
  while i < mid && j < n - mid {
    if ra[j] < la[i] {
      a[k] = ra[j]
      v[k] = rv[j]
      j++
    } else {
      a[k] = la[i]
      v[k] = lv[i]
      i++
    }
    k++
  }
  while i < mid {
    a[k] = la[i]
    v[k] = lv[i]
    i++
    k++
  }
  while j < n - mid {
    a[k] = ra[j]
    v[k] = rv[j]
    j++
    k++
  }
}

# ---------------------------------------------------------------- unmarshal

struct Dec {
  err: str
}

export fn unmarshal(text: str, v: any) -> error {
  box := __anyp(v)
  if box == 0 { return errors.New("json: unmarshal needs a non-nil pointer (got nil)") }
  d := __load64(box)
  if dkind(d) != 9 { return errors.New("json: unmarshal needs a non-nil pointer (got " + dname(d) + ")") }
  p := __load64(box + 8)
  if p == 0 { return errors.New("json: unmarshal needs a non-nil pointer (got a nil " + dname(d) + ")") }
  ed := delem(d)
  # the direct decoder runs only when a first pass (vtyped) found the text valid and every value
  # fit for its place, so it never stops halfway; otherwise the tree decoder gives the errors
  vs := vtyped(text, ed)
  if vs != nil {
    f := &Fast{s: text, p: __strp(text) + 8, n: len(text), i: 0, bad: false, arrs: vs.arrs, na: vs.na, ac: 0, keys: vs.keys, kc: 0}
    if dkind(ed) == 7 || dkind(ed) == 8 {
      f.word(ed, p)
    } else {
      w := f.word(ed, __load64(p))
      if !f.bad { __store64(p, w) }
    }
    if len(vs.keys) <= 65536 { spare_keys = vs.keys }
    if len(vs.arrs) <= 65536 { spare_arrs = vs.arrs }
    if !f.bad { return nil }
  }
  tree, err := parse(text)
  if err != nil { return err }
  dec := &Dec{err: ""}
  if dkind(ed) == 7 || dkind(ed) == 8 {
    dec.word(tree, ed, p, "")
  } else {
    w := dec.word(tree, ed, __load64(p), "")
    if len(dec.err) == 0 { __store64(p, w) }
  }
  if len(dec.err) != 0 { return errors.New(dec.err) }
  return nil
}

fn json_kind(v: *Value) -> str {
  if v.kind == "number" { return "number " + v.s }
  return v.kind
}

fn (dec: *Dec) mismatch(v: *Value, d: int, ctx: str) {
  if len(dec.err) != 0 { return }
  where := "value"
  if ctx != "" { where = "field " + ctx }
  dec.err = "json: cannot unmarshal " + json_kind(v) + " into " + where + " of type " + dname(d)
}

# the range of an integer type by its descriptor's integer kind ([48], types.KIND_CODE: 1 int8,
# 2 int16, 3 int32, 6 uint8, 7 uint16, 8 uint32), or ok false for int/int64/uint64/uint
fn int_range_of(d: int) -> (int, int, bool) {
  switch __load64(d + 48) {
  case 1: return -128, 127, true
  case 2: return -32768, 32767, true
  case 3: return -2147483648, 2147483647, true
  case 6: return 0, 255, true
  case 7: return 0, 65535, true
  case 8: return 0, 4294967295, true
  }
  return 0, 0, false
}

# the range of an integer type by its name, or ok false for int/int64/uint64/uint
fn int_range(name: str) -> (int, int, bool) {
  switch name {
  case "int8": return -128, 127, true
  case "int16": return -32768, 32767, true
  case "int32": return -2147483648, 2147483647, true
  case "uint8": return 0, 255, true
  case "uint16": return 0, 65535, true
  case "uint32": return 0, 4294967295, true
  }
  return 0, 0, false
}

# the word for v decoded as type d; old is the current word (structs and arrays are filled in
# place, and null keeps it for the types that cannot be nil)
fn (dec: *Dec) word(v: *Value, d: int, old: int, ctx: str) -> int {
  if len(dec.err) != 0 { return old }
  if d == value_ptr_desc() { return __load64(__anyp(v) + 8) }
  k := dkind(d)
  if v.kind == "null" {
    if k == 6 || k == 9 || k == 10 || k == 11 || k == 12 { return 0 }
    return old
  }
  switch k {
  case 1, 2:
    if v.kind != "number" || !v.is_int {
      dec.mismatch(v, d, ctx)
      return old
    }
    lo, hi, ranged := int_range(dname(d))
    if (ranged && (v.i < lo || v.i > hi)) || (k == 2 && v.i < 0) {
      dec.mismatch(v, d, ctx)
      return old
    }
    return v.i
  case 3:
    if v.kind != "number" {
      dec.mismatch(v, d, ctx)
      return old
    }
    if dname(d) == "float32" { return __fbits(num(float32(v.n))) }
    return __fbits(v.n)
  case 4:
    if v.kind != "bool" {
      dec.mismatch(v, d, ctx)
      return old
    }
    if v.b { return 1 }
    return 0
  case 5:
    if v.kind != "string" {
      dec.mismatch(v, d, ctx)
      return old
    }
    return __strp(v.s)
  case 6:
    if v.kind != "array" {
      dec.mismatch(v, d, ctx)
      return old
    }
    ed := delem(d)
    n := len(v.items)
    s := __make_slice(ed, n, n)
    data := __load64(s)
    for i := 0; i < n; i++ {
      estore(data, i, ed, dec.word(v.items[i], ed, eload(data, i, ed), ctx))
      if len(dec.err) != 0 { return old }
    }
    return s
  case 7:
    if v.kind != "array" {
      dec.mismatch(v, d, ctx)
      return old
    }
    ed := delem(d)
    data := old
    if data == 0 { data = __zero(d) }
    n := dcount(d)
    for i := 0; i < n; i++ {
      if i < len(v.items) {
        estore(data, i, ed, dec.word(v.items[i], ed, eload(data, i, ed), ctx))
      } else {
        estore(data, i, ed, __zero(ed))
      }
      if len(dec.err) != 0 { return old }
    }
    return data
  case 8:
    if v.kind != "object" {
      dec.mismatch(v, d, ctx)
      return old
    }
    obj := old
    if obj == 0 { obj = __zero(d) }
    dec.fields(v, d, obj, ctx)
    return obj
  case 9:
    ed := delem(d)
    if dkind(ed) == 7 || dkind(ed) == 8 {
      obj := old
      if obj == 0 { obj = __zero(ed) }
      return dec.word(v, ed, obj, ctx)
    }
    cell := old
    if cell == 0 {
      cell = __alloc(8)
      __store64(cell, __zero(ed))
    }
    w := dec.word(v, ed, __load64(cell), ctx)
    __store64(cell, w)
    return cell
  case 10:
    if v.kind != "object" {
      dec.mismatch(v, d, ctx)
      return old
    }
    kd := dkey(d)
    vd := delem(d)
    kk := dkind(kd)
    if kk != 5 && kk != 1 && kk != 2 {
      dec.err = "json: cannot unmarshal into " + dname(d) + " (map keys must be strings or integers)"
      return old
    }
    m := old
    if m == 0 {
      if kk == 5 { m = __map_new(2) } else { m = __map_new(0) }
    }
    for _, key := range v.keys {
      kw := 0
      if kk == 5 {
        kw = __strp(key)
      } else {
        x, err := strconv.parse_int(key, 10)
        if err != nil {
          dec.err = "json: cannot unmarshal key " + quote(key) + " into a map key of type " + dname(kd)
          return old
        }
        kw = x
      }
      w := dec.word(v.fields[key], vd, __zero(vd), ctx)
      if len(dec.err) != 0 { return old }
      __map_set(m, kw, w)
    }
    return m
  case 11:
    return __anyp(v.to_any())
  }
  dec.mismatch(v, d, ctx)
  return old
}

# the fields of a struct object, from a JSON object (embedded structs promoted)
fn (dec: *Dec) fields(v: *Value, d: int, obj: int, ctx: str) {
  sname := dname(d)
  dot := strings.last_index(sname, ".")
  if dot >= 0 { sname = sname[dot + 1:] }
  n := dcount(d)
  for i := 0; i < n; i++ {
    fd := field_desc(d, i)
    if embedded(d, i) {
      inner := __load64(obj + 8 * i)
      if dkind(fd) == 9 {
        if inner == 0 {
          inner = __zero(delem(fd))
          __store64(obj + 8 * i, inner)
        }
        fd = delem(fd)
      }
      dec.fields(v, fd, inner, ctx)
      if len(dec.err) != 0 { return }
      continue
    }
    name := field_name(d, i)
    x := v.fields[name]
    if x == nil {
      low := strings.to_lower(name)
      for _, key := range v.keys {
        if strings.to_lower(key) == low {
          x = v.fields[key]
          break
        }
      }
    }
    if x == nil { continue }
    c2 := sname + "." + name
    if ctx != "" { c2 = ctx + "." + name }
    w := dec.word(x, fd, __load64(obj + 8 * i), c2)
    if len(dec.err) != 0 { return }
    __store64(obj + 8 * i, w)
  }
}

# ---------------------------------------------------------------- validation without a tree

# does text parse (the same grammar and limits as parse), without building anything; nil when
# it does not, else the item counts of its lists (see VScan.arrs)
fn vscan(text: str) -> *VScan {
  v := &VScan{s: text, p: __strp(text) + 8, n: len(text), i: 0}
  v.ws()
  if !v.value(0) { return nil }
  v.ws()
  if v.i != v.n { return nil }
  return v
}

# like vscan, and also: every value decodes into its place by type d the way the tree decoder
# would, with nothing the direct decoder leaves to it (type mismatches, numbers out of range,
# escaped keys, repeated fields, embedded structs...); nil when not
# key and list tables kept between unmarshal calls (taken while a decoder uses them)
let spare_keys: []int = nil
let spare_arrs: []int = nil

fn vtyped(text: str, d: int) -> *VScan {
  v := &VScan{s: text, p: __strp(text) + 8, n: len(text), i: 0, keys: spare_keys, arrs: spare_arrs}
  spare_keys = nil
  spare_arrs = nil
  v.ws()
  if !v.typed(d, 0) { return nil }
  v.ws()
  if v.i != v.n { return nil }
  return v
}

struct VScan {
  s: str
  p: int
  n: int
  i: int
  arrs: []int          # [offset, count] of each list, in the order they start
  na: int              # used part of arrs
  keys: []int          # [field or -1, offset of the value] of each key of a struct object
  kdata: int           # the data block of keys while its length is klen (for vflat)
  klen: int
  nk: int              # used part of keys
  rd: int              # the integer type whose range is in rlo, rhi, rok
  rlo: int
  rhi: int
  rok: bool
  last_d: int          # the struct type checked last and its plan
  last_plan: *Plan
}

fn (v: *VScan) ws() {
  p := v.p
  n := v.n
  i := v.i
  while i < n {
    c := __load8(p + i)
    if c != 32 && c != 10 && c != 13 && c != 9 { break }
    i++
  }
  v.i = i
}

fn (v: *VScan) lit(w: str) -> bool {
  m := len(w)
  if v.i + m > v.n { return false }
  for k := 0; k < m; k++ { if __load8(v.p + v.i + k) != int(w[k]) { return false } }
  v.i += m
  return true
}

fn (v: *VScan) value(depth: int) -> bool {
  p := v.p
  i := v.i
  c := __load8(p + i)
  if c == 123 || c == 91 {
    if depth + 1 > MAX_DEPTH { return false }
    close := 93
    if c == 123 { close = 125 }
    slot := -1
    if c == 91 {
      # the number of items, read by the direct decoder: [offset after "[", count]
      slot = v.add_arr(i + 1)
    }
    i++
    while true {
      b := __load8(p + i)
      if b != 32 && b != 10 && b != 13 && b != 9 { break }
      i++
    }
    if __load8(p + i) == close {
      v.i = i + 1
      return true
    }
    count := 0
    while true {
      while true {
        b := __load8(p + i)
        if b != 32 && b != 10 && b != 13 && b != 9 { break }
        i++
      }
      if c == 123 {
        if __load8(p + i) != 34 { return false }
        v.i = i
        if !v.string() { return false }
        i = v.i
        while true {
          b := __load8(p + i)
          if b != 32 && b != 10 && b != 13 && b != 9 { break }
          i++
        }
        if __load8(p + i) != 58 { return false }
        i++
        while true {
          b := __load8(p + i)
          if b != 32 && b != 10 && b != 13 && b != 9 { break }
          i++
        }
      }
      v.i = i
      if !v.value(depth + 1) { return false }
      count++
      i = v.i
      while true {
        b := __load8(p + i)
        if b != 32 && b != 10 && b != 13 && b != 9 { break }
        i++
      }
      c2 := __load8(p + i)
      if c2 == 44 {
        i++
        continue
      }
      if c2 == close {
        v.i = i + 1
        if slot >= 0 { v.arrs[slot + 1] = count }
        return true
      }
      return false
    }
  }
  if i >= v.n { return false }
  if c == 34 { return v.string() }
  if c == 45 || (c >= 48 && c <= 57) { return v.number() }
  if c == 116 { return v.lit("true") }
  if c == 102 { return v.lit("false") }
  if c == 110 { return v.lit("null") }
  return false
}

# a new [offset, count] entry in arrs (count 0 for now); returns its position
fn (v: *VScan) add_arr(off: int) -> int {
  na := v.na
  if na + 2 > len(v.arrs) {
    bigger := make([]int, 2 * len(v.arrs) + 16)
    copy(bigger, v.arrs)
    v.arrs = bigger
  }
  v.arrs[na] = off
  v.arrs[na + 1] = 0
  v.na = na + 2
  return na
}

fn (v: *VScan) skip_ws() {
  p := v.p
  i := v.i
  while true {
    b := __load8(p + i)
    if b != 32 && b != 10 && b != 13 && b != 9 { break }
    i++
  }
  v.i = i
}

# the value at v.i, valid and fit for type d (see vtyped)
fn (v: *VScan) typed(d: int, depth: int) -> bool {
  if v.i >= v.n { return false }
  if d == value_ptr_desc() { return v.value(depth) }
  p := v.p
  c := __load8(p + v.i)
  if c == 110 { return v.lit("null") }
  k := dkind(d)
  switch k {
  case 1, 2:
    start := v.i
    if !v.number() { return false }
    i := start
    neg := false
    if __load8(p + i) == 45 {
      neg = true
      i++
    }
    x := 0
    nd := 0
    while i < v.i {
      b := __load8(p + i)
      if b < 48 || b > 57 { return false }
      x = x * 10 + (b - 48)
      nd++
      i++
    }
    if nd > 18 { return false }
    if neg { x = -x }
    if d != v.rd {
      v.rd = d
      v.rlo, v.rhi, v.rok = int_range_of(d)
    }
    if (v.rok && (x < v.rlo || x > v.rhi)) || (k == 2 && x < 0) { return false }
    return true
  case 3:
    if c != 45 && (c < 48 || c > 57) { return false }
    return v.number()
  case 4:
    if c == 116 { return v.lit("true") }
    if c == 102 { return v.lit("false") }
    return false
  case 5:
    if c != 34 { return false }
    return v.string()
  case 6, 7:
    if c != 91 || depth + 1 > MAX_DEPTH { return false }
    ed := delem(d)
    lim := -1
    if k == 7 { lim = dcount(d) }
    slot := v.add_arr(v.i + 1)
    v.i++
    if __load8(v.p + v.i) <= 32 { v.skip_ws() }
    if __load8(p + v.i) == 93 {
      v.i++
      return true
    }
    count := 0
    while true {
      if __load8(v.p + v.i) <= 32 { v.skip_ws() }
      if lim < 0 || count < lim {
        if !v.typed(ed, depth + 1) { return false }
      } else if !v.value(depth + 1) { return false }
      count++
      if __load8(v.p + v.i) <= 32 { v.skip_ws() }
      c2 := __load8(p + v.i)
      v.i++
      if c2 == 93 {
        v.arrs[slot + 1] = count
        return true
      }
      if c2 != 44 { return false }
    }
  case 8:
    if c != 123 || depth + 1 > MAX_DEPTH { return false }
    return v.object(d, depth)
  case 9:
    return v.typed(delem(d), depth)
  case 10:
    if c != 123 || depth + 1 > MAX_DEPTH || dkind(dkey(d)) != 5 { return false }
    vd := delem(d)
    v.i++
    if __load8(v.p + v.i) <= 32 { v.skip_ws() }
    if __load8(p + v.i) == 125 {
      v.i++
      return true
    }
    while true {
      if __load8(v.p + v.i) <= 32 { v.skip_ws() }
      if __load8(p + v.i) != 34 || !v.string() { return false }
      if __load8(v.p + v.i) <= 32 { v.skip_ws() }
      if __load8(p + v.i) != 58 { return false }
      v.i++
      if __load8(v.p + v.i) <= 32 { v.skip_ws() }
      if !v.typed(vd, depth + 1) { return false }
      if __load8(v.p + v.i) <= 32 { v.skip_ws() }
      c2 := __load8(p + v.i)
      v.i++
      if c2 == 125 { return true }
      if c2 != 44 { return false }
    }
  case 11:
    return v.value(depth)
  }
  return false
}

# an object for a struct of type d: the same key matching as Fast.object
# ---- leaf scanners for the decoders (no calls: their variables live in registers)

# the index of the first byte from i that is ", \\, a control byte or not ASCII (n if none);
# 8 bytes at a time while they all are plain
fn plain_end(p: int, i0: int, n: int) -> int {
  i := i0
  lo := (16843009 << 32) | 16843009
  while i + 8 <= n {
    x := __load64(p + i)
    q := x ^ (lo * 34)
    b := x ^ (lo * 92)
    bad := (x | ((x - (lo << 5)) & (x ^ -1)) | ((q - lo) & (q ^ -1)) | ((b - lo) & (b ^ -1))) & (lo << 7)
    if bad != 0 { break }
    i += 8
  }
  while i < n {
    c := __load8(p + i)
    if c < 32 || c == 34 || c == 92 || c >= 128 { return i }
    i++
  }
  return n
}

# the end of a plain integer (-?digits, at most 18, no leading zero, not followed by . e E) at
# i, or -1 for anything else (the general path decides)
fn int_end(p: int, i0: int, n: int) -> int {
  j := i0
  if j < n && __load8(p + j) == 45 { j++ }
  if j >= n { return -1 }
  c := __load8(p + j)
  if c == 48 {
    j++
    if j < n {
      c2 := __load8(p + j)
      if c2 >= 48 && c2 <= 57 { return -1 }
    }
  } else {
    if c < 49 || c > 57 { return -1 }
    st := j
    while j < n {
      c2 := __load8(p + j)
      if c2 < 48 || c2 > 57 { break }
      j++
    }
    if j - st > 18 { return -1 }
  }
  if j < n {
    c3 := __load8(p + j)
    if c3 == 46 || c3 == 101 || c3 == 69 { return -1 }
  }
  return j
}

# the value of a plain integer that int_end accepted at i
fn int_at(p: int, i0: int) -> int {
  j := i0
  neg := false
  if __load8(p + j) == 45 {
    neg = true
    j++
  }
  x := 0
  while true {
    c := __load8(p + j)
    if c < 48 || c > 57 { break }
    x = x * 10 + c - 48
    j++
  }
  if neg { return -x }
  return x
}

# the end of true or false at i (the byte decides which), or -1
fn bool_end(p: int, i: int, n: int) -> int {
  c := __load8(p + i)
  if c == 116 && i + 4 <= n && __load8(p + i + 1) == 114 && __load8(p + i + 2) == 117 && __load8(p + i + 3) == 101 { return i + 4 }
  if c == 102 && i + 5 <= n && __load8(p + i + 1) == 97 && __load8(p + i + 2) == 108 && __load8(p + i + 3) == 115 && __load8(p + i + 4) == 101 { return i + 5 }
  return -1
}

# the object of a flat struct at i0 (its "{"), in one leaf pass: keys must match field names
# exactly and each once, values must be plain (strings without escapes or non-ASCII bytes,
# integers int_end accepts, true or false). Writes the [field, value offset] pairs at kout (room
# for nf pairs) and returns the index after the object, with the number of pairs in vflat_pairs;
# -1 leaves the object to the general path.
let vflat_pairs: int = 0
fn vflat(p: int, i0: int, n: int, prog: int, nf: int, kout: int) -> int {
  i := i0 + 1
  ko := kout
  seen := 0
  hint := 0
  lo := (16843009 << 32) | 16843009
  while true {
    c := __load8(p + i)
    while c == 32 || c == 10 || c == 13 || c == 9 {
      i++
      c = __load8(p + i)
    }
    if c != 34 { return -1 }
    a := i + 1
    j := a
    while true {
      b := __load8(p + j)
      if b == 34 { break }
      if b == 92 || b >= 128 || b < 32 { return -1 }
      j++
    }
    m := j - a
    fi := -1
    k := hint
    tries := 0
    while tries < nf {
      if k >= nf { k = 0 }
      e := prog + 24 * k
      if __load64(e + 8) == m {
        q := __load64(e)
        t := 0
        while t < m && __load8(q + t) == __load8(p + a + t) { t++ }
        if t == m {
          fi = k
          break
        }
      }
      k++
      tries++
    }
    if fi < 0 { return -1 }
    bit := 1 << fi
    if (seen & bit) != 0 { return -1 }
    seen = seen | bit
    hint = fi + 1
    i = j + 1
    c = __load8(p + i)
    while c == 32 || c == 10 || c == 13 || c == 9 {
      i++
      c = __load8(p + i)
    }
    if c != 58 { return -1 }
    i++
    c = __load8(p + i)
    while c == 32 || c == 10 || c == 13 || c == 9 {
      i++
      c = __load8(p + i)
    }
    __store64(ko, fi)
    __store64(ko + 8, i)
    ko += 16
    vk := __load64(prog + 24 * fi + 16)
    if vk == 5 {
      if c != 34 { return -1 }
      i++
      while i + 8 <= n {
        x := __load64(p + i)
        qx := x ^ (lo * 34)
        bx := x ^ (lo * 92)
        bad := (x | ((x - (lo << 5)) & (x ^ -1)) | ((qx - lo) & (qx ^ -1)) | ((bx - lo) & (bx ^ -1))) & (lo << 7)
        if bad != 0 { break }
        i += 8
      }
      while true {
        b := __load8(p + i)
        if b == 34 { break }
        if b == 92 || b >= 128 || b < 32 { return -1 }
        i++
      }
      i++
    } else if vk == 1 {
      if c == 45 { i++ }
      c = __load8(p + i)
      if c == 48 {
        i++
        c = __load8(p + i)
        if c >= 48 && c <= 57 { return -1 }
      } else {
        if c < 49 || c > 57 { return -1 }
        st := i
        while c >= 48 && c <= 57 {
          i++
          c = __load8(p + i)
        }
        if i - st > 18 { return -1 }
      }
      if c == 46 || c == 101 || c == 69 { return -1 }
    } else if vk == 4 {
      if c == 116 && i + 4 <= n && __load8(p + i + 1) == 114 && __load8(p + i + 2) == 117 && __load8(p + i + 3) == 101 {
        i += 4
      } else if c == 102 && i + 5 <= n && __load8(p + i + 1) == 97 && __load8(p + i + 2) == 108 && __load8(p + i + 3) == 115 && __load8(p + i + 4) == 101 {
        i += 5
      } else { return -1 }
    } else { return -1 }
    c = __load8(p + i)
    while c == 32 || c == 10 || c == 13 || c == 9 {
      i++
      c = __load8(p + i)
    }
    i++
    if c == 125 {
      vflat_pairs = (ko - kout) / 16
      return i
    }
    if c != 44 { return -1 }
  }
  return -1
}

fn (v: *VScan) object(d: int, depth: int) -> bool {
  pl := v.last_plan
  if d != v.last_d {
    pl = plan_of(d)
    v.last_d = d
    v.last_plan = pl
  }
  if !pl.fast_dec { return false }
  p := v.p
  if pl.flat {
    nk0 := v.nk
    if nk0 + 2 * pl.n > len(v.keys) {
      bigger := make([]int, 2 * len(v.keys) + 2 * pl.n + 16)
      copy(bigger, v.keys)
      v.keys = bigger
    }
    if v.klen != len(v.keys) {
      v.kdata = __load64(__load64(__anyp(v.keys) + 8))
      v.klen = len(v.keys)
    }
    r := vflat(p, v.i, v.n, pl.prog, pl.n, v.kdata + 8 * nk0)
    if r >= 0 {
      v.i = r
      v.nk = nk0 + 2 * vflat_pairs
      return true
    }
  }
  v.i++
  v.skip_ws()
  if __load8(p + v.i) == 125 {
    v.i++
    return true
  }
  exact := 0
  loose := 0
  hint := 0
  while true {
    if __load8(v.p + v.i) <= 32 { v.skip_ws() }
    if __load8(p + v.i) != 34 { return false }
    a := v.i + 1
    j := a
    while true {
      b := __load8(p + j)
      if b == 34 { break }
      if b == 92 || b >= 128 || b < 32 { return false }
      j++
    }
    i := j + 1
    if __load8(p + i) <= 32 {
      v.i = i
      v.skip_ws()
      i = v.i
    }
    if __load8(p + i) != 58 { return false }
    i++
    if __load8(p + i) <= 32 {
      v.i = i
      v.skip_ws()
      i = v.i
    }
    v.i = i
    fi := -1
    if hint < pl.n {
      nm := pl.names[hint]
      m := j - a
      if len(nm) == m {
        q := __strp(nm) + 8
        k := 0
        while k + 8 <= m && __load64(q + k) == __load64(p + a + k) { k += 8 }
        while k < m && __load8(q + k) == __load8(p + a + k) { k++ }
        if k == m { fi = hint }
      }
    }
    if fi < 0 { fi = find_field(pl, p, a, j, false, pl.n) }
    take := false
    if fi >= 0 {
      bit := 1 << fi
      if ((exact | loose) & bit) != 0 { return false }
      exact = exact | bit
      take = true
    } else {
      fi = find_field(pl, p, a, j, true, 0)
      if fi >= 0 {
        bit := 1 << fi
        if (loose & bit) != 0 { return false }
        if (exact & bit) == 0 {
          loose = loose | bit
          take = true
        }
      }
    }
    if !take { fi = -1 }
    nk := v.nk
    if nk + 2 > len(v.keys) {
      bigger := make([]int, 2 * len(v.keys) + 16)
      copy(bigger, v.keys)
      v.keys = bigger
    }
    v.keys[nk] = fi
    v.keys[nk + 1] = v.i
    v.nk = nk + 2
    if take {
      hint = fi + 1
      vk := pl.vkinds[fi]
      e2 := -1
      if vk == 5 {
        if __load8(p + i) == 34 {
          j2 := plain_end(p, i + 1, v.n)
          if __load8(p + j2) == 34 { e2 = j2 + 1 }
        }
      } else if vk == 1 {
        e2 = int_end(p, i, v.n)
      } else if vk == 4 { e2 = bool_end(p, i, v.n) }
      if e2 >= 0 {
        v.i = e2
      } else if !v.typed(pl.descs[fi], depth + 1) { return false }
      if v.last_d != d {
        v.last_d = d
        v.last_plan = pl
      }
    } else if !v.value(depth + 1) { return false }
    if __load8(v.p + v.i) <= 32 { v.skip_ws() }
    c2 := __load8(p + v.i)
    v.i++
    if c2 == 125 { return true }
    if c2 != 44 { return false }
  }
  return false
}

fn (v: *VScan) string() -> bool {
  p := v.p
  n := v.n
  i := v.i + 1
  while i < n {
    c := __load8(p + i)
    if c == 34 {
      v.i = i + 1
      return true
    }
    if c < 32 { return false }
    if c == 92 {
      if i + 1 >= n { return false }
      e := __load8(p + i + 1)
      if e == 117 {
        if i + 6 > n { return false }
        for k := 2; k < 6; k++ { if hex_val(__load8(p + i + k)) < 0 { return false } }
        i += 6
        continue
      }
      if e != 34 && e != 92 && e != 47 && e != 98 && e != 102 && e != 110 && e != 114 && e != 116 { return false }
      i += 2
      continue
    }
    i++
  }
  return false
}

fn (v: *VScan) digits() -> int {
  k := 0
  while v.i < v.n {
    c := __load8(v.p + v.i)
    if c < 48 || c > 57 { break }
    v.i++
    k++
  }
  return k
}

fn (v: *VScan) number() -> bool {
  start := v.i
  if __load8(v.p + v.i) == 45 { v.i++ }
  if v.i >= v.n { return false }
  nd := 0
  if __load8(v.p + v.i) == 48 {
    v.i++
    nd = 1
    if v.i < v.n && __load8(v.p + v.i) >= 48 && __load8(v.p + v.i) <= 57 { return false }
  } else {
    nd = v.digits()
    if nd == 0 { return false }
  }
  simple := nd <= 18
  if __load8(v.p + v.i) == 46 {
    simple = false
    v.i++
    if v.digits() == 0 { return false }
  }
  if __load8(v.p + v.i) == 101 || __load8(v.p + v.i) == 69 {
    simple = false
    v.i++
    if __load8(v.p + v.i) == 43 || __load8(v.p + v.i) == 45 { v.i++ }
    if v.digits() == 0 { return false }
  }
  if !simple {
    # the tree parser turns the text into a num and fails when it is out of range
    _, err := strconv.parse_float(v.s[start:v.i])
    if err != nil { return false }
  }
  return true
}

# ---------------------------------------------------------------- direct decoder

# decodes valid JSON text straight into memory, following the type descriptors; bad means it met
# something it leaves to the tree decoder (unmarshal then runs that one from the start)
struct Fast {
  s: str
  p: int
  n: int
  i: int
  bad: bool
  arrs: []int          # item counts of the lists (VScan.arrs, na used) and the next one to look at
  na: int
  ac: int
  keys: []int          # the field and value offset of each struct key (VScan.keys), the next one
  kc: int
  last_d: int          # the struct type decoded last and its plan
  last_plan: *Plan
  rd: int              # the integer type whose range is in rlo, rhi, rok
  rlo: int
  rhi: int
  rok: bool
}

fn (f: *Fast) ws() {
  p := f.p
  n := f.n
  i := f.i
  while i < n {
    c := __load8(p + i)
    if c != 32 && c != 10 && c != 13 && c != 9 { break }
    i++
  }
  f.i = i
}


# the number of items of the list that starts at f.i (after "["), from the validation
fn (f: *Fast) count_items() -> int {
  arrs := f.arrs
  k := f.ac
  while k < f.na && arrs[k] < f.i { k += 2 }
  f.ac = k + 2
  return arrs[k + 1]
}

# skips one value (the text is valid)
fn (f: *Fast) skip() {
  p := f.p
  i := f.i
  c := __load8(p + i)
  if c == 34 {
    i++
    while true {
      c2 := __load8(p + i)
      if c2 == 92 {
        i += 2
        continue
      }
      i++
      if c2 == 34 { break }
    }
    f.i = i
    return
  }
  if c == 123 || c == 91 {
    depth := 0
    while true {
      c2 := __load8(p + i)
      if c2 == 34 {
        f.i = i
        f.skip()
        i = f.i
        continue
      }
      i++
      if c2 == 123 || c2 == 91 { depth++ } else if c2 == 125 || c2 == 93 {
        depth--
        if depth == 0 { break }
      }
    }
    f.i = i
    return
  }
  n := f.n
  while i < n {
    c2 := __load8(p + i)
    if c2 == 44 || c2 == 125 || c2 == 93 || c2 == 32 || c2 == 10 || c2 == 13 || c2 == 9 { break }
    i++
  }
  f.i = i
}

# a subtree, through the tree parser
fn (f: *Fast) tree() -> *Value {
  pr := &Parser{s: f.s, i: f.i, depth: 0, err: ""}
  v := pr.value()
  f.i = pr.i
  return v
}

# a string value at f.i (the opening quote), as a string word
fn (f: *Fast) str_word() -> int {
  p := f.p
  a := f.i + 1
  j := plain_end(p, a, f.n)
  while true {
    c := __load8(p + j)
    if c == 34 { break }
    if c == 92 || c >= 128 {
      # escapes or UTF-8: the tree parser's string reader (same result as parse)
      pr := &Parser{s: f.s, i: f.i, depth: 0, err: ""}
      t := pr.string()
      f.i = pr.i
      return __strp(t)
    }
    j++
  }
  m := __newstr(j - a)
  copy_mem(m + 8, p + a, j - a)
  f.i = j + 1
  return m
}

# an integer at f.i; ok false when it is not a plain integer of up to 18 digits
fn (f: *Fast) int_text() -> (int, bool) {
  p := f.p
  n := f.n
  i := f.i
  neg := false
  if __load8(p + i) == 45 {
    neg = true
    i++
  }
  x := 0
  nd := 0
  while i < n {
    c := __load8(p + i)
    if c < 48 || c > 57 { break }
    x = x * 10 + (c - 48)
    nd++
    i++
  }
  if nd == 0 || nd > 18 { return 0, false }
  if i < n {
    c := __load8(p + i)
    if c == 46 || c == 101 || c == 69 { return 0, false }
  }
  f.i = i
  if neg { return -x, true }
  return x, true
}

fn (f: *Fast) word(d: int, old: int) -> int {
  if f.bad { return old }
  if __load8(f.p + f.i) <= 32 { f.ws() }
  if d == value_ptr_desc() { return __load64(__anyp(f.tree()) + 8) }
  k := dkind(d)
  c := __load8(f.p + f.i)
  if c == 110 {
    f.i += 4
    if k == 6 || k == 9 || k == 10 || k == 11 || k == 12 { return 0 }
    return old
  }
  switch k {
  case 1, 2:
    if c != 45 && (c < 48 || c > 57) {
      f.bad = true
      return old
    }
    x, ok := f.int_text()
    if !ok {
      f.bad = true
      return old
    }
    if d != f.rd {
      f.rd = d
      f.rlo, f.rhi, f.rok = int_range_of(d)
    }
    if (f.rok && (x < f.rlo || x > f.rhi)) || (k == 2 && x < 0) {
      f.bad = true
      return old
    }
    return x
  case 3:
    if c != 45 && (c < 48 || c > 57) {
      f.bad = true
      return old
    }
    start := f.i
    fx := 0.0
    k2, ok2 := f.int_text()
    if ok2 {
      fx = num(k2)
    } else {
      f.skip()
      y, err := strconv.parse_float(f.s[start:f.i])
      if err != nil {
        f.bad = true
        return old
      }
      fx = y
    }
    if dname(d) == "float32" { return __fbits(num(float32(fx))) }
    return __fbits(fx)
  case 4:
    if c == 116 {
      f.i += 4
      return 1
    }
    if c == 102 {
      f.i += 5
      return 0
    }
    f.bad = true
    return old
  case 5:
    if c != 34 {
      f.bad = true
      return old
    }
    return f.str_word()
  case 6:
    if c != 91 {
      f.bad = true
      return old
    }
    ed := delem(d)
    f.i++
    count := f.count_items()
    s := __make_slice(ed, count, count)
    data := __load64(s)
    for idx := 0; idx < count; idx++ {
      w := f.word(ed, eload(data, idx, ed))
      if f.bad { return old }
      estore(data, idx, ed, w)
      if __load8(f.p + f.i) <= 32 { f.ws() }
      f.i++
    }
    if count == 0 {
      if __load8(f.p + f.i) <= 32 { f.ws() }
      f.i++
    }
    return s
  case 7:
    if c != 91 {
      f.bad = true
      return old
    }
    ed := delem(d)
    data := old
    if data == 0 { data = __zero(d) }
    n := dcount(d)
    f.i++
    if __load8(f.p + f.i) <= 32 { f.ws() }
    idx := 0
    if __load8(f.p + f.i) == 93 {
      f.i++
    } else {
      while true {
        if __load8(f.p + f.i) <= 32 { f.ws() }
        if idx < n {
          w := f.word(ed, eload(data, idx, ed))
          if f.bad { return old }
          estore(data, idx, ed, w)
        } else { f.skip() }
        idx++
        if __load8(f.p + f.i) <= 32 { f.ws() }
        c2 := __load8(f.p + f.i)
        f.i++
        if c2 != 44 { break }
      }
    }
    while idx < n {
      estore(data, idx, ed, __zero(ed))
      idx++
    }
    return data
  case 8:
    if c != 123 {
      f.bad = true
      return old
    }
    return f.object(d, old)
  case 9:
    ed := delem(d)
    if dkind(ed) == 7 || dkind(ed) == 8 {
      obj := old
      if obj == 0 { obj = __zero(ed) }
      return f.word(ed, obj)
    }
    cell := old
    if cell == 0 {
      cell = __alloc(8)
      __store64(cell, __zero(ed))
    }
    w := f.word(ed, __load64(cell))
    __store64(cell, w)
    return cell
  case 10:
    if c != 123 || dkind(dkey(d)) != 5 {
      f.bad = true
      return old
    }
    return f.map_obj(d, old)
  case 11:
    return __anyp(f.tree().to_any())
  }
  f.bad = true
  return old
}

fn lower(c: int) -> int {
  if c >= 65 && c <= 90 { return c + 32 }
  return c
}

# do the m bytes at q equal the m bytes at r?
fn same_bytes(q: int, r: int, m: int) -> bool {
  k := 0
  while k + 8 <= m {
    if __load64(q + k) != __load64(r + k) { return false }
    k += 8
  }
  while k < m {
    if __load8(q + k) != __load8(r + k) { return false }
    k++
  }
  return true
}

# the field whose name is the key (bytes [a, b) at p), exactly (ci false) or without regard to
# case (ci true), or -1; the field at hint is tried first (keys usually come in field order)
fn find_field(pl: *Plan, p: int, a: int, b: int, ci: bool, hint: int) -> int {
  m := b - a
  if !ci && hint < pl.n {
    nm := pl.names[hint]
    if len(nm) == m && same_bytes(__strp(nm) + 8, p + a, m) { return hint }
  }
  for i := 0; i < pl.n; i++ {
    nm := pl.names[i]
    if len(nm) != m { continue }
    q := __strp(nm) + 8
    if !ci {
      if same_bytes(q, p + a, m) { return i }
      continue
    }
    k := 0
    while k < m && lower(__load8(q + k)) == lower(__load8(p + a + k)) { k++ }
    if k == m { return i }
  }
  return -1
}

# a JSON object into a struct of type d (filled in place); vtyped already matched each key to its
# field (Fast.keys), with the same rules as the tree decoder
fn (f: *Fast) object(d: int, old: int) -> int {
  pl := f.last_plan
  if d != f.last_d {
    pl = plan_of(d)
    f.last_d = d
    f.last_plan = pl
  }
  obj := old
  if obj == 0 { obj = __zero(d) }
  f.i++
  if __load8(f.p + f.i) <= 32 { f.ws() }
  if __load8(f.p + f.i) == 125 {
    f.i++
    return obj
  }
  keys := f.keys
  while true {
    kc := f.kc
    fi := keys[kc]
    f.i = keys[kc + 1]
    f.kc = kc + 2
    if fi >= 0 {
      fd := pl.descs[fi]
      if __load8(f.p + f.i) == 34 && dkind(fd) == 5 {
        __store64(obj + 8 * fi, f.str_word())
      } else {
        w := f.word(fd, __load64(obj + 8 * fi))
        if f.bad { return obj }
        __store64(obj + 8 * fi, w)
        if f.last_d != d {
          f.last_d = d
          f.last_plan = pl
        }
      }
    } else { f.skip() }
    if __load8(f.p + f.i) <= 32 { f.ws() }
    c := __load8(f.p + f.i)
    f.i++
    if c != 44 { break }
  }
  return obj
}

# a JSON object into a map with string keys
fn (f: *Fast) map_obj(d: int, old: int) -> int {
  vd := delem(d)
  m := old
  if m == 0 { m = __map_new(2) }
  f.i++
  if __load8(f.p + f.i) <= 32 { f.ws() }
  if __load8(f.p + f.i) == 125 {
    f.i++
    return m
  }
  while true {
    if __load8(f.p + f.i) <= 32 { f.ws() }
    key := __pstr(f.str_word())
    if __load8(f.p + f.i) <= 32 { f.ws() }
    f.i++
    w := f.word(vd, __zero(vd))
    if f.bad { return m }
    __map_set(m, __strp(key), w)
    if __load8(f.p + f.i) <= 32 { f.ws() }
    c := __load8(f.p + f.i)
    f.i++
    if c != 44 { break }
  }
  return m
}
