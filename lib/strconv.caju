# std/strconv: numbers to strings and back.

import "std/strings"
import "std/math"

# decimal text of an integer
export fn itoa(x: int) -> str { return str(x) }

# integer text in a base from 2 to 36 (lowercase letters above 9)
export fn format_int(x: int, base: int) -> str {
  if x == 0 { return "0" }
  digits := "0123456789abcdefghijklmnopqrstuvwxyz"
  neg := x < 0
  b := []uint8{}
  # works for the most negative number too: take digits of the negative value
  for x != 0 {
    d := x % base
    if d < 0 { d = -d }
    b = append(b, digits[d])
    x = x / base
  }
  out := strings.Builder{}
  if neg { out.write_byte(45) }
  for i := len(b) - 1; i >= 0; i-- { out.write_byte(int(b[i])) }
  return out.string()
}

fn digit_value(c: int) -> int {
  if c >= 48 && c <= 57 { return c - 48 }
  if c >= 97 && c <= 122 { return c - 97 + 10 }
  if c >= 65 && c <= 90 { return c - 65 + 10 }
  return 99
}

# parses an integer in a base (0 = decide from the prefix: 0x, 0o, 0b, else 10); accepts a sign and _
# between digits. Values that do not fit in 64 bits are an error.
export fn parse_int(s: str, base: int) -> (int, error) {
  i := 0
  n := len(s)
  neg := false
  if i < n && (s[i] == 43 || s[i] == 45) {
    neg = s[i] == 45
    i++
  }
  if base == 0 {
    base = 10
    if i + 1 < n && s[i] == 48 {
      c := int(s[i + 1]) | 32
      if c == 120 { base = 16; i += 2 } else if c == 111 { base = 8; i += 2 } else if c == 98 { base = 2; i += 2 }
    }
  }
  if i >= n { return 0, errors.New("invalid number: \"" + s + "\"") }
  # accumulate as a negative number, which has room for the most negative value
  let v: int = 0
  limit := -9223372036854775807 - 1
  any_digit := false
  for ; i < n; i++ {
    c := int(s[i])
    if c == 95 { continue }
    d := digit_value(c)
    if d >= base { return 0, errors.New("invalid number: \"" + s + "\"") }
    if v < (limit + d) / base { return 0, errors.New("number out of range: \"" + s + "\"") }
    v = v * base - d
    any_digit = true
  }
  if !any_digit { return 0, errors.New("invalid number: \"" + s + "\"") }
  if !neg {
    if v == limit { return 0, errors.New("number out of range: \"" + s + "\"") }
    v = -v
  }
  return v, nil
}
export fn atoi(s: str) -> (int, error) { return parse_int(s, 10) }

# ---------------------------------------------------------------- decimal text to num
# Correctly rounded (round half to even), like strtod. Small cases use exact float operations;
# the rest uses big integers.

# big natural numbers: little-endian limbs of 32 bits
fn big_from(x: int) -> []int {
  if x == 0 { return []int{} }
  return []int{x & 0xFFFFFFFF, (x >> 32) & 0xFFFFFFFF}
}
fn big_trim(a: []int) -> []int {
  n := len(a)
  while n > 0 && a[n - 1] == 0 { n-- }
  return a[0:n]
}
fn big_mul_add(a: []int, m: int, add: int) -> []int {
  out := make([]int, len(a) + 1)
  carry := add
  for i := 0; i < len(a); i++ {
    t := a[i] * m + carry
    out[i] = t & 0xFFFFFFFF
    carry = (t >> 32) & 0xFFFFFFFF
  }
  out[len(a)] = carry
  return big_trim(out)
}
fn big_shl(a: []int, k: int) -> []int {
  if len(a) == 0 { return a }
  words := k / 32
  bits := k % 32
  out := make([]int, len(a) + words + 1)
  for i := 0; i < len(a); i++ {
    v := a[i] << bits
    out[i + words] = out[i + words] | (v & 0xFFFFFFFF)
    out[i + words + 1] = (v >> 32) & 0xFFFFFFFF
  }
  return big_trim(out)
}
fn big_cmp(a: []int, b: []int) -> int {
  if len(a) != len(b) {
    if len(a) < len(b) { return -1 }
    return 1
  }
  for i := len(a) - 1; i >= 0; i-- {
    if a[i] != b[i] {
      if a[i] < b[i] { return -1 }
      return 1
    }
  }
  return 0
}
# a - b, with a >= b
fn big_sub(a: []int, b: []int) -> []int {
  out := make([]int, len(a))
  borrow := 0
  for i := 0; i < len(a); i++ {
    t := a[i] - borrow
    if i < len(b) { t -= b[i] }
    borrow = 0
    if t < 0 {
      t += 0x100000000
      borrow = 1
    }
    out[i] = t
  }
  return big_trim(out)
}
fn big_bits(a: []int) -> int {
  if len(a) == 0 { return 0 }
  top := a[len(a) - 1]
  n := 0
  while top > 0 {
    n++
    top = top >> 1
  }
  return 32 * (len(a) - 1) + n
}
fn big_pow10(a: []int, e: int) -> []int {
  for i := 0; i < e; i++ { a = big_mul_add(a, 10, 0) }
  return a
}
# floor(n / d) when it fits in 55 bits, and whether the remainder is zero / half / more than half
fn big_div_round(n: []int, d: []int) -> (int, int) {
  q := 0
  r := n
  for b := 55; b >= 0; b-- {
    t := big_shl(d, b)
    if big_cmp(t, r) <= 0 {
      r = big_sub(r, t)
      q = q | (1 << b)
    }
  }
  # compare 2r with d: -1 below half, 0 exactly half, 1 above half
  return q, big_cmp(big_shl(r, 1), d)
}

let POW10 = []num{1.0, 10.0, 100.0, 1000.0, 10000.0, 100000.0, 1000000.0, 10000000.0, 100000000.0, 1000000000.0,
  10000000000.0, 100000000000.0, 1000000000000.0, 10000000000000.0, 100000000000000.0, 1000000000000000.0,
  10000000000000000.0, 100000000000000000.0, 1000000000000000000.0, 10000000000000000000.0,
  100000000000000000000.0, 1000000000000000000000.0, 10000000000000000000000.0}

# parses decimal text: digits, an optional fraction and an optional exponent (1.5, .5, 2e10, 1_000.25)
export fn parse_float(s: str) -> (num, error) {
  bad := errors.New("invalid number: \"" + s + "\"")
  i := 0
  n := len(s)
  neg := false
  if i < n && (s[i] == 43 || s[i] == 45) {
    neg = s[i] == 45
    i++
  }
  digits := []int{}          # significant digits as a big number
  ndig := 0                  # significant digits seen (leading zeros skipped)
  small := 0                 # the same digits while there are at most 18 of them
  e10 := 0
  seen := false
  dot := false
  for ; i < n; i++ {
    c := int(s[i])
    if c == 95 { continue }
    if c == 46 {
      if dot { return 0.0, bad }
      dot = true
      continue
    }
    if c < 48 || c > 57 { break }
    seen = true
    if dot { e10-- }
    if ndig == 0 && c == 48 { continue }
    digits = big_mul_add(digits, 10, c - 48)
    if ndig < 18 { small = small * 10 + c - 48 }
    ndig++
  }
  if !seen { return 0.0, bad }
  if i < n && (s[i] == 101 || s[i] == 69) {
    i++
    eneg := false
    if i < n && (s[i] == 43 || s[i] == 45) {
      eneg = s[i] == 45
      i++
    }
    if i >= n { return 0.0, bad }
    ev := 0
    for ; i < n; i++ {
      c := int(s[i])
      if c == 95 { continue }
      if c < 48 || c > 57 { return 0.0, bad }
      if ev < 100000 { ev = ev * 10 + c - 48 }
    }
    if eneg { e10 -= ev } else { e10 += ev }
  }
  if i != n { return 0.0, bad }
  sign := 1.0
  if neg { sign = -1.0 }
  if ndig == 0 { return sign * 0.0, nil }
  # exact: at most 15 digits (below 2^53) and a power of ten that is exact as a double
  if ndig <= 15 && e10 >= -22 && e10 <= 22 {
    m := num(small)
    if e10 >= 0 { return sign * m * POW10[e10], nil }
    return sign * m / POW10[-e10], nil
  }
  # out of range for sure
  if ndig + e10 > 310 { return sign * math.inf(), nil }
  if ndig + e10 < -330 { return sign * 0.0, nil }
  # value = digits * 10^e10 = num_ / den; find q, e2 with value ≈ q * 2^e2 and 2^52 <= q < 2^53
  num_ := digits
  den := big_from(1)
  if e10 >= 0 { num_ = big_pow10(num_, e10) } else { den = big_pow10(den, -e10) }
  e2 := big_bits(num_) - big_bits(den) - 53
  q := 0
  half := 0
  while true {
    if e2 < -1074 { e2 = -1074 }
    nn := num_
    dd := den
    if e2 >= 0 { dd = big_shl(den, e2) } else { nn = big_shl(num_, -e2) }
    q, half = big_div_round(nn, dd)
    if q >= (1 << 53) {
      e2++
      continue
    }
    if q < (1 << 52) && e2 > -1074 {
      e2--
      continue
    }
    break
  }
  if half > 0 || (half == 0 && (q & 1) == 1) { q++ }
  if q == (1 << 53) {
    q = 1 << 52
    e2++
  }
  if e2 + 52 > 1023 { return sign * math.inf(), nil }
  bits := q
  if q >= (1 << 52) { bits = ((e2 + 52 + 1023) << 52) | (q - (1 << 52)) }
  if neg { bits = bits | (1 << 63) }
  return math.from_bits(bits), nil
}

# shortest-looking text of a num (the same format print uses)
export fn format_float(x: num) -> str { return str(x) }

# a string literal in Caju syntax, with quotes and escapes
export fn quote(s: str) -> str {
  b := strings.Builder{}
  b.write_byte(34)
  for i := 0; i < len(s); i++ {
    c := int(s[i])
    if c == 34 { b.write("\\\"") } else if c == 92 { b.write("\\\\") } else if c == 10 { b.write("\\n") } else if c == 9 { b.write("\\t") } else if c == 13 { b.write("\\r") } else if c < 32 {
      b.write("\\x")
      b.write_byte(int("0123456789abcdef"[c >> 4]))
      b.write_byte(int("0123456789abcdef"[c & 15]))
    } else { b.write_byte(c) }
  }
  b.write_byte(34)
  return b.string()
}
