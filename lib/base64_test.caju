import "std/base64"
import "std/hex"
import "std/strings"
import { describe, it, expect } from "std/testing"

# every byte value, 0 to 255
fn all_bytes() -> str {
  b := strings.Builder{}
  for i := 0; i < 256; i++ { b.write_byte(i) }
  return b.string()
}

let samples = []str{"", "f", "fo", "foo", "foob", "fooba", "foobar", "Olá, mundo!"}

describe("base64.encode", fn() {
  it("encodes the RFC 4648 examples with padding", fn() {
    got := []str{}
    for _, s := range samples { got = append(got, base64.encode(s)) }
    expect(got).to_equal([]str{"", "Zg==", "Zm8=", "Zm9v", "Zm9vYg==", "Zm9vYmE=", "Zm9vYmFy", "T2zDoSwgbXVuZG8h"})
  })
  it("encodes every byte value with + and /", fn() {
    expect(base64.encode(all_bytes())).to_equal("")
  })
})

describe("base64.url_encode", fn() {
  it("leaves the padding out", fn() {
    got := []str{}
    for _, s := range samples { got = append(got, base64.url_encode(s)) }
    expect(got).to_equal([]str{"", "Zg", "Zm8", "Zm9v", "Zm9vYg", "Zm9vYmE", "Zm9vYmFy", "T2zDoSwgbXVuZG8h"})
  })
  it("encodes every byte value with - and _", fn() {
    expect(base64.url_encode(all_bytes())).to_equal("AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8gISIjJCUmJygpKissLS4vMDEyMzQ1Njc4OTo7PD0-P0BBQkNERUZHSElKS0xNTk9QUVJTVFVWV1hZWltcXV5fYGFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHl6e3x9fn-AgYKDhIWGh4iJiouMjY6PkJGSk5SVlpeYmZqbnJ2en6ChoqOkpaanqKmqq6ytrq-wsbKztLW2t7i5uru8vb6_wMHCw8TFxsfIycrLzM3Oz9DR0tPU1dbX2Nna29zd3t_g4eLj5OXm5-jp6uvs7e7v8PHy8_T19vf4-fr7_P3-_w")
  })
})

describe("base64.decode", fn() {
  it("gives back what encode wrote", fn() {
    x, err := base64.decode(base64.encode(all_bytes()))
    expect(err).to_be_nil()
    expect(x == all_bytes()).to_be_true()
  })
  it("decodes a text without padding", fn() {
    x, err := base64.decode("Zm9vYmFy")
    expect(err).to_be_nil()
    expect(x).to_equal("foobar")
  })
  it("returns an error when the length is not a multiple of 4", fn() {
    x, err := base64.decode("Zm9vYg")
    expect(x).to_equal("")
    expect(err).to_be_error("base64: length is not a multiple of 4")
  })
  it("returns an error for a character outside the alphabet", fn() {
    _, err := base64.decode("Zm9v!mFy")
    expect(err).to_be_error("base64: invalid character at position 4")
  })
  it("returns an error for too much padding", fn() {
    _, err := base64.decode("Zm9vY===")
    expect(err).to_be_error("base64: too much padding")
  })
  it("returns an error for padding in the middle", fn() {
    _, err := base64.decode("Zg=a")
    expect(err).to_be_error("base64: invalid character at position 2")
  })
  it("returns an error when the last character has extra bits set", fn() {
    _, err := base64.decode("Zh==")
    expect(err).to_be_error("base64: non-zero trailing bits")
  })
})

describe("base64.url_decode", fn() {
  it("gives back what url_encode wrote", fn() {
    x, err := base64.url_decode(base64.url_encode(all_bytes()))
    expect(err).to_be_nil()
    expect(x == all_bytes()).to_be_true()
  })
  it("accepts padding", fn() {
    x, err := base64.url_decode("Zm9vYg==")
    expect(err).to_be_nil()
    expect(x).to_equal("foob")
  })
  it("uses - and _ instead of + and /", fn() {
    x, err := base64.url_decode("-_8")
    expect(err).to_be_nil()
    expect(hex.encode(x)).to_equal("fbff")
    y, err2 := base64.url_decode("+/8")
    expect(y).to_equal("")
    expect(err2).to_be_error("base64: invalid character at position 0")
  })
})
