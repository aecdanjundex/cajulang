# std/base64: base64 encoding (RFC 4648), standard alphabet with padding and URL alphabet
# without padding.

let STD = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
let URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

fn enc(s: str, alpha: str, pad: bool) -> str {
  n := len(s)
  full := n / 3
  rest := n - full * 3
  out := full * 4
  if rest > 0 {
    if pad { out += 4 } else { out += rest + 1 }
  }
  m := __newstr(out)
  p := __strp(s) + 8
  a := __strp(alpha) + 8
  o := m + 8
  i := 0
  while i < full * 3 {
    v := (__load8(p + i) << 16) | (__load8(p + i + 1) << 8) | __load8(p + i + 2)
    __store8(o, __load8(a + ((v >> 18) & 63)))
    __store8(o + 1, __load8(a + ((v >> 12) & 63)))
    __store8(o + 2, __load8(a + ((v >> 6) & 63)))
    __store8(o + 3, __load8(a + (v & 63)))
    o += 4
    i += 3
  }
  if rest == 1 {
    v := __load8(p + i) << 16
    __store8(o, __load8(a + ((v >> 18) & 63)))
    __store8(o + 1, __load8(a + ((v >> 12) & 63)))
    if pad {
      __store8(o + 2, 61)
      __store8(o + 3, 61)
    }
  } else if rest == 2 {
    v := (__load8(p + i) << 16) | (__load8(p + i + 1) << 8)
    __store8(o, __load8(a + ((v >> 18) & 63)))
    __store8(o + 1, __load8(a + ((v >> 12) & 63)))
    __store8(o + 2, __load8(a + ((v >> 6) & 63)))
    if pad { __store8(o + 3, 61) }
  }
  return __pstr(m)
}

# the value of a base64 character, or -1
fn value(c: int, url: bool) -> int {
  if c >= 65 && c <= 90 { return c - 65 }
  if c >= 97 && c <= 122 { return c - 71 }
  if c >= 48 && c <= 57 { return c + 4 }
  if url {
    if c == 45 { return 62 }
    if c == 95 { return 63 }
  } else {
    if c == 43 { return 62 }
    if c == 47 { return 63 }
  }
  return -1
}

fn dec(s: str, url: bool) -> (str, error) {
  n := len(s)
  # padding: required for the standard alphabet, optional for the URL one
  while n > 0 && s[n - 1] == 61 { n-- }
  if len(s) - n > 2 { return "", errors.New("base64: too much padding") }
  if !url && len(s) % 4 != 0 { return "", errors.New("base64: length is not a multiple of 4") }
  if url && len(s) != n && len(s) % 4 != 0 { return "", errors.New("base64: bad padding") }
  if n % 4 == 1 { return "", errors.New("base64: bad length") }
  out := (n / 4) * 3
  if n % 4 == 2 { out += 1 }
  if n % 4 == 3 { out += 2 }
  m := __newstr(out)
  p := __strp(s) + 8
  o := m + 8
  v := 0
  bits := 0
  i := 0
  while i < n {
    x := value(__load8(p + i), url)
    if x < 0 { return "", errors.New("base64: invalid character at position " + str(i)) }
    v = (v << 6) | x
    bits += 6
    if bits >= 8 {
      bits -= 8
      __store8(o, (v >> bits) & 255)
      o++
    }
    i++
  }
  # the leftover bits must be zero (canonical encoding)
  if (v & ((1 << bits) - 1)) != 0 { return "", errors.New("base64: non-zero trailing bits") }
  return __pstr(m), nil
}

# standard alphabet, with "=" padding
export fn encode(s: str) -> str { return enc(s, STD, true) }
export fn decode(s: str) -> (str, error) { return dec(s, false) }

# URL and file name safe alphabet ("-" and "_"), without padding; decoding accepts padding too
export fn url_encode(s: str) -> str { return enc(s, URL, false) }
export fn url_decode(s: str) -> (str, error) { return dec(s, true) }
