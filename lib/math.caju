# std/math: floating-point helpers and integer utilities.

export const PI = 3.141592653589793
export const E = 2.718281828459045
export const MAX_INT = 9223372036854775807
export const MIN_INT = -9223372036854775807 - 1

# the IEEE 754 bits of a num, and back
export fn bits(x: num) -> int { return __fbits(x) }
export fn from_bits(b: int) -> num { return __bitsf(b) }

export fn inf() -> num { return __bitsf(0x7FF0000000000000) }
export fn nan() -> num { return __bitsf(0x7FF8000000000000) }
export fn is_nan(x: num) -> bool { return x != x }
export fn is_inf(x: num) -> bool { return x == inf() || x == -inf() }

export fn sqrt(x: num) -> num { return __sqrt(x) }
export fn mod(x: num, y: num) -> num { return __fmod(x, y) }
export fn abs(x: num) -> num {
  if x < 0.0 { return -x }
  return x
}
export fn floor(x: num) -> num {
  if is_nan(x) || is_inf(x) || abs(x) >= 4503599627370496.0 { return x }
  t := num(int(x))
  if t > x { return t - 1.0 }
  return t
}
export fn ceil(x: num) -> num { return -floor(-x) }
export fn trunc(x: num) -> num {
  if is_nan(x) || is_inf(x) || abs(x) >= 4503599627370496.0 { return x }
  return num(int(x))
}
export fn round(x: num) -> num {
  if x < 0.0 { return -floor(-x + 0.5) }
  return floor(x + 0.5)
}
export fn pow(x: num, y: num) -> num { return x ** y }

export fn min_int(a: int, b: int) -> int {
  if a < b { return a }
  return b
}
export fn max_int(a: int, b: int) -> int {
  if a > b { return a }
  return b
}
export fn abs_int(a: int) -> int {
  if a < 0 { return -a }
  return a
}
