import "std/os"
import "std/strings"
import { describe, it, expect, after_each, run_file } from "std/testing"

describe("os.args and os.getenv", fn() {
  it("gives the program name as the first argument", fn() {
    expect(len(os.args())).to_be_at_least(1)
  })
  it("reads environment variables", fn() {
    expect(os.getenv("CAJU_SKIP_SLEEP")).to_equal("1")
  })
  it("returns an empty text for a variable that is not set", fn() {
    expect(os.getenv("NO_SUCH_VARIABLE_X")).to_equal("")
    _, ok := os.lookup_env("NO_SUCH_VARIABLE_X")
    expect(ok).to_be_false()
  })
})

describe("os files", fn() {
  file := "/tmp/caju-os-test-" + str(os.getpid())
  after_each(fn() { if os.exists(file) { os.remove(file) } })
  it("writes a file and reads it back", fn() {
    expect(os.write_file(file, "line 1\nline 2\n", 0o644)).to_be_nil()
    expect(os.exists(file)).to_be_true()
    data, err := os.read_file(file)
    expect(err).to_be_nil()
    expect(data).to_have_length(14)
    expect(strings.split(strings.trim_space(data), "\n")).to_equal([]str{"line 1", "line 2"})
  })
  it("removes a file", fn() {
    os.write_file(file, "x", 0o644)
    expect(os.remove(file)).to_be_nil()
    expect(os.exists(file)).to_be_false()
  })
  it("returns an error for a file that does not exist", fn() {
    _, err := os.read_file("/no/such/file")
    expect(err).to_be_error("open /no/such/file: no such file or directory")
  })
})

describe("os.nanotime", fn() {
  it("never goes back", fn() {
    t0 := os.nanotime()
    expect(os.nanotime()).to_be_at_least(t0)
  })
})

describe("os.stdout and os.exit", fn() {
  it("keeps the order of print and os.stdout and ends with the exit code", fn() {
    r := run_file("testdata/os_exit.caju")
    expect(r.output).to_equal("before\nraw stdout\nafter")
    expect(r.code).to_equal(3)
  })
})

describe("os.run", fn() {
  it("runs a program and collects its output", fn() {
    p, err := os.run([]str{"echo", "hello", "from", "a child"}, nil, false)
    expect(err).to_be_nil()
    expect(p.code).to_equal(0)
    expect(strings.trim_space(p.output)).to_equal("hello from a child")
  })
  it("merges the standard error and reports the exit code", fn() {
    p, _ := os.run([]str{"sh", "-c", "echo out; echo err 1>&2; exit 7"}, nil, true)
    expect(p.code).to_equal(7)
    expect(strings.split(strings.trim_space(p.output), "\n")).to_equal([]str{"out", "err"})
  })
  it("reports the signal that killed the program", fn() {
    p, _ := os.run([]str{"sh", "-c", "kill -9 $$"}, nil, false)
    expect(p.code).to_equal(137)
    expect(p.signal).to_equal(9)
  })
  it("returns an error for a program that does not exist", fn() {
    _, err := os.run([]str{"/no/such/program"}, nil, false)
    expect(err).to_be_error("run /no/such/program: program not found")
  })
})

describe("os.executable", fn() {
  it("gives the path of the running program", fn() {
    expect(os.executable()).to_start_with("/")
  })
})
