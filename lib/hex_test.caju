import "std/hex"
import "std/strings"
import { describe, it, expect } from "std/testing"

# every byte value, 0 to 255
fn all_bytes() -> str {
  b := strings.Builder{}
  for i := 0; i < 256; i++ { b.write_byte(i) }
  return b.string()
}

describe("hex.encode", fn() {
  it("writes two lowercase digits per byte", fn() {
    expect(hex.encode("")).to_equal("")
    expect(hex.encode("abc")).to_equal("616263")
    expect(hex.encode("Olá")).to_equal("4f6cc3a1")
  })
  it("encodes every byte value", fn() {
    expect(hex.encode(all_bytes())).to_equal("")
  })
})

describe("hex.decode", fn() {
  it("gives back what encode wrote", fn() {
    d, err := hex.decode(hex.encode(all_bytes()))
    expect(err).to_be_nil()
    expect(d == all_bytes()).to_be_true()
  })
  it("accepts uppercase and lowercase digits", fn() {
    d, err := hex.decode("4A6b4c")
    expect(err).to_be_nil()
    expect(d).to_equal("JkL")
  })
  it("returns an error for an odd number of digits", fn() {
    d, err := hex.decode("abc")
    expect(d).to_equal("")
    expect(err).to_be_error("hex: odd length")
  })
  it("returns an error for a character that is not a digit", fn() {
    d, err := hex.decode("zz")
    expect(d).to_equal("")
    expect(err).to_be_error("hex: invalid byte at position 0")
  })
})
