# Runtime nativo, fase 4: alocador com classes de tamanho e coletor de lixo (marcar e varrer).
#
# A memória é uma faixa grande de endereços reservada no começo (a arena), dividida em páginas
# de 64 KB. Uma página pequena guarda objetos de um só tamanho (16 a 16384 bytes); os 2 KB do
# começo têm os bits de marca, de "em uso" e de "sem ponteiros" de cada objeto. Um objeto
# maior ocupa páginas inteiras seguidas.
#
# O coletor é conservador: qualquer palavra na pilha, nas globais ou dentro de um objeto que
# aponte para dentro de um objeto em uso mantém esse objeto vivo. Textos são marcados "sem
# ponteiros" e não são lidos. Objetos nunca mudam de lugar.

let rt_arena: int = 0          # início da arena (alinhado em 64 KB)
let rt_npages: int = 0         # páginas na arena
let rt_top_page: int = 0       # páginas já usadas alguma vez
let rt_pg_kind: int = 0        # byte por página: 0 livre, 1 pequena, 2 começo de grande, 3 resto de grande
let rt_pg_info: int = 0        # palavra por página: tamanho do objeto, nº de páginas, ou a página do começo
let rt_pg_flag: int = 0        # byte por página grande: 1 marcada, 2 sem ponteiros, 4 em uso
let rt_free_pages: int = 0     # páginas livres abaixo de rt_top_page
let rt_cls_size: int = 0       # tamanho de cada classe
let rt_cls_of: int = 0         # byte por (tamanho + 15) / 16 → classe
let rt_free: int = 0           # lista livre de cada classe
let rt_ncls: int = 0
let rt_alloced: int = 0        # bytes pedidos desde a última coleta
let rt_gc_limit: int = 0       # a próxima coleta acontece quando rt_alloced passar disto
let rt_live: int = 0
let rt_gcs: int = 0            # coletas feitas
let rt_mstack: int = 0         # pilha de marcação
let rt_mstack_cap: int = 0
let rt_mstack_n: int = 0
let rt_stack_top: int = 0      # topo da pilha do programa (gravado na entrada)
let rt_data_lo: int = 0        # globais do programa e do runtime
let rt_data_hi: int = 0

fn rt_gc_init() {
  size := 1 << 34
  rt_npages = size >> 16
  base := rt_os_reserve(size + 65536)
  rt_arena = (base + 65535) & -65536
  rt_pg_kind = rt_os_mem(rt_npages)
  rt_pg_flag = rt_os_mem(rt_npages)
  rt_pg_info = rt_os_mem(8 * rt_npages)
  rt_ncls = 0
  rt_cls_size = rt_os_mem(8 * 64)
  rt_free = rt_os_mem(8 * 64)
  rt_cls_of = rt_os_mem(1040)
  # 16 a 256 de 16 em 16; depois uns 4 tamanhos por potência de 2
  s := 16
  while s <= 16384 {
    __store64(rt_cls_size + 8 * rt_ncls, s)
    rt_ncls++
    if s < 256 {
      s += 16
    } else {
      step := 64
      while step * 8 <= s { step *= 2 }
      s += step
    }
  }
  c := 0
  i := 1
  while i <= 1024 {
    while __load64(rt_cls_size + 8 * c) < 16 * i { c++ }
    __store8(rt_cls_of + i, c)
    i++
  }
  rt_mstack_cap = 1 << 16
  rt_mstack = rt_os_mem(8 * rt_mstack_cap)
  rt_gc_limit = 8 << 20
}

# uma página nova (ou uma livre de antes) para objetos pequenos ou para o começo de um grande
fn rt_take_pages(n: int) -> int {
  if rt_free_pages >= n {
    run := 0
    i := 0
    while i < rt_top_page {
      if __load8(rt_pg_kind + i) == 0 {
        run++
        if run == n {
          rt_free_pages -= n
          return i - n + 1
        }
      } else {
        run = 0
      }
      i++
    }
  }
  if rt_top_page + n > rt_npages { rt_fail("runtime", "Memória esgotada") }
  p := rt_top_page
  rt_top_page += n
  rt_os_commit(rt_arena + (p << 16), n << 16)
  return p
}
fn rt_zero_mem(p: int, n: int) {
  e := p + n
  while p < e {
    __store64(p, 0)
    p += 8
  }
}
fn rt_bit_set(base: int, i: int) {
  w := base + 8 * (i >> 6)
  __store64(w, __load64(w) | (1 << (i & 63)))
}
fn rt_bit_clr(base: int, i: int) {
  w := base + 8 * (i >> 6)
  __store64(w, __load64(w) &^ (1 << (i & 63)))
}
fn rt_bit(base: int, i: int) -> bool { return (__load64(base + 8 * (i >> 6)) >> (i & 63)) & 1 != 0 }

# página nova para a classe c: todos os lugares vão para a lista livre
fn rt_refill(c: int) {
  size := __load64(rt_cls_size + 8 * c)
  pi := rt_take_pages(1)
  __store8(rt_pg_kind + pi, 1)
  __store64(rt_pg_info + 8 * pi, size)
  page := rt_arena + (pi << 16)
  rt_zero_mem(page, 2048)
  n := (65536 - 2048) / size
  head := __load64(rt_free + 8 * c)
  i := n - 1
  while i >= 0 {
    o := page + 2048 + size * i
    __store64(o, head)
    head = o
    i--
  }
  __store64(rt_free + 8 * c, head)
}
fn rt_alloc_x(n: int, noscan: bool) -> int {
  if n < 16 { n = 16 }
  rt_alloced += n
  if rt_alloced > rt_gc_limit { rt_gc() }
  if n <= 16384 {
    c := __load8(rt_cls_of + ((n + 15) >> 4))
    p := __load64(rt_free + 8 * c)
    if p == 0 {
      rt_refill(c)
      p = __load64(rt_free + 8 * c)
    }
    __store64(rt_free + 8 * c, __load64(p))
    size := __load64(rt_cls_size + 8 * c)
    page := p & -65536
    slot := (p - page - 2048) / size
    rt_bit_set(page + 512, slot)
    if noscan { rt_bit_set(page + 1024, slot) } else { rt_bit_clr(page + 1024, slot) }
    rt_zero_mem(p, size)
    return p
  }
  np := (n + 65535) >> 16
  pi := rt_take_pages(np)
  __store8(rt_pg_kind + pi, 2)
  __store64(rt_pg_info + 8 * pi, np)
  f := 4
  if noscan { f = 6 }
  __store8(rt_pg_flag + pi, f)
  i := 1
  while i < np {
    __store8(rt_pg_kind + pi + i, 3)
    __store64(rt_pg_info + 8 * (pi + i), pi)
    i++
  }
  p := rt_arena + (pi << 16)
  rt_zero_mem(p, np << 16)
  return p
}
fn rt_alloc(n: int) -> int { return rt_alloc_x(n, false) }
fn rt_alloc_ns(n: int) -> int { return rt_alloc_x(n, true) }

# ---------------------------------------------------------------- coleta
fn rt_mpush(o: int) {
  if rt_mstack_n == rt_mstack_cap {
    nc := 2 * rt_mstack_cap
    ns := rt_os_mem(8 * nc)
    rt_copy(ns, rt_mstack, 8 * rt_mstack_n)
    rt_mstack = ns
    rt_mstack_cap = nc
  }
  __store64(rt_mstack + 8 * rt_mstack_n, o)
  rt_mstack_n++
}
# w parece apontar para dentro de um objeto em uso e ainda não marcado? então marca
fn rt_mark_word(w: int) {
  if w < rt_arena { return }
  pi := (w - rt_arena) >> 16
  if pi >= rt_top_page { return }
  k := __load8(rt_pg_kind + pi)
  if k == 1 {
    page := rt_arena + (pi << 16)
    off := w - page - 2048
    if off < 0 { return }
    size := __load64(rt_pg_info + 8 * pi)
    slot := off / size
    if slot >= (65536 - 2048) / size { return }
    if not rt_bit(page + 512, slot) or rt_bit(page, slot) { return }
    rt_bit_set(page, slot)
    rt_live += size
    if not rt_bit(page + 1024, slot) { rt_mpush(page + 2048 + size * slot) }
    return
  }
  if k == 3 { pi = __load64(rt_pg_info + 8 * pi) } else if k != 2 { return }
  f := __load8(rt_pg_flag + pi)
  if f & 4 == 0 or f & 1 != 0 { return }
  __store8(rt_pg_flag + pi, f | 1)
  rt_live += __load64(rt_pg_info + 8 * pi) << 16
  if f & 2 == 0 { rt_mpush(rt_arena + (pi << 16)) }
}
fn rt_scan(lo: int, hi: int) {
  while lo + 8 <= hi {
    rt_mark_word(__load64(lo))
    lo += 8
  }
}
fn rt_gc() {
  rt_gcs++
  rt_live = 0
  # raízes: a pilha (daqui até o topo) e as globais
  rt_scan(__sp(), rt_stack_top)
  rt_scan(rt_data_lo, rt_data_hi)
  while rt_mstack_n > 0 {
    rt_mstack_n--
    o := __load64(rt_mstack + 8 * rt_mstack_n)
    pi := (o - rt_arena) >> 16
    if __load8(rt_pg_kind + pi) == 1 {
      rt_scan(o, o + __load64(rt_pg_info + 8 * pi))
    } else {
      rt_scan(o, o + (__load64(rt_pg_info + 8 * pi) << 16))
    }
  }
  rt_sweep()
  rt_alloced = 0
  rt_gc_limit = rt_live
  if rt_gc_limit < 8 << 20 { rt_gc_limit = 8 << 20 }
}
fn rt_sweep() {
  pi := 0
  while pi < rt_top_page {
    k := __load8(rt_pg_kind + pi)
    if k == 1 {
      page := rt_arena + (pi << 16)
      size := __load64(rt_pg_info + 8 * pi)
      c := __load8(rt_cls_of + ((size + 15) >> 4))
      n := (65536 - 2048) / size
      w := 0
      while w * 64 < n {
        used := __load64(page + 512 + 8 * w)
        dead := used &^ __load64(page + 8 * w)
        if dead != 0 {
          b := 0
          while b < 64 {
            if (dead >> b) & 1 != 0 {
              o := page + 2048 + size * (64 * w + b)
              __store64(o, __load64(rt_free + 8 * c))
              __store64(rt_free + 8 * c, o)
            }
            b++
          }
          __store64(page + 512 + 8 * w, used &^ dead)
        }
        __store64(page + 8 * w, 0)
        w++
      }
    } else if k == 2 {
      f := __load8(rt_pg_flag + pi)
      np := __load64(rt_pg_info + 8 * pi)
      if f & 1 == 0 {
        i := 0
        while i < np {
          __store8(rt_pg_kind + pi + i, 0)
          i++
        }
        __store8(rt_pg_flag + pi, 0)
        rt_free_pages += np
      } else {
        __store8(rt_pg_flag + pi, f &^ 1)
      }
      pi += np - 1
    }
    pi++
  }
}
