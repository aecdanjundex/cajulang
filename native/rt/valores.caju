# Runtime nativo, fase 2: valores compostos.
# Todo valor ocupa uma palavra de 8 bytes. Struct e array: ponteiro para as palavras dos campos
# (ou elementos); slice: ponteiro para [dados, tamanho, capacidade]; map: ponteiro para a tabela;
# ponteiro para um valor simples: endereço de uma palavra.
#
# Descritor de tipo (gerado pelo compilador): [0] tipo, [8] n (elementos do array / campos),
# [16] elemento, [24] chave, [32] nome, [40] campos ([nome, descritor, valor?] × n), [48] código do inteiro.
# Tipos: 1 int, 2 uint, 3 num, 4 bool, 5 str, 6 slice, 7 array, 8 struct, 9 ponteiro, 10 map, 11 outro.

fn rt_cell(v: int) -> int {
  p := rt_alloc(8)
  __store64(p, v)
  return p
}
fn rt_dk(d: int) -> int { return __load64(d) }
fn rt_is_value(d: int) -> bool {
  k := __load64(d)
  return k == 7 or k == 8
}

# ---------------------------------------------------------------- zero, cópia, igualdade
fn rt_zero(d: int) -> int {
  k := __load64(d)
  if k == 5 { return __strp("") }
  if k == 8 {
    n := __load64(d + 8)
    p := rt_alloc(8 * n + 8)
    f := __load64(d + 40)
    i := 0
    while i < n {
      __store64(p + 8 * i, rt_zero(__load64(f + 24 * i + 8)))
      i++
    }
    return p
  }
  if k == 7 {
    n := __load64(d + 8)
    e := __load64(d + 16)
    p := rt_alloc(8 * n + 8)
    i := 0
    while i < n {
      __store64(p + 8 * i, rt_zero(e))
      i++
    }
    return p
  }
  return 0
}
# structs e arrays são valores: atribuir copia (os campos que também são valores, junto)
fn rt_copy_val(v: int, d: int) -> int {
  k := __load64(d)
  if v == 0 { return v }
  if k == 8 {
    n := __load64(d + 8)
    f := __load64(d + 40)
    p := rt_alloc(8 * n + 8)
    i := 0
    while i < n {
      w := __load64(v + 8 * i)
      fd := __load64(f + 24 * i + 8)
      if __load64(f + 24 * i + 16) != 0 { w = rt_copy_val(w, fd) }
      __store64(p + 8 * i, w)
      i++
    }
    return p
  }
  if k == 7 {
    n := __load64(d + 8)
    e := __load64(d + 16)
    p := rt_alloc(8 * n + 8)
    deep := rt_is_value(e)
    i := 0
    while i < n {
      w := __load64(v + 8 * i)
      if deep { w = rt_copy_val(w, e) }
      __store64(p + 8 * i, w)
      i++
    }
    return p
  }
  return v
}
# grava src por cima de dst, mantendo o objeto (ponteiros para ele continuam valendo)
fn rt_copy_into(dst: int, src: int, d: int) {
  k := __load64(d)
  if dst == 0 or src == 0 { return }
  n := __load64(d + 8)
  i := 0
  while i < n {
    fd := __load64(d + 16)
    deep := false
    if k == 8 {
      f := __load64(d + 40)
      fd = __load64(f + 24 * i + 8)
      deep = __load64(f + 24 * i + 16) != 0
    } else {
      deep = rt_is_value(fd)
    }
    w := __load64(dst + 8 * i)
    if deep and w != 0 {
      rt_copy_into(w, __load64(src + 8 * i), fd)
    } else {
      __store64(dst + 8 * i, __load64(src + 8 * i))
    }
    i++
  }
}
fn rt_eq_flat(a: int, b: int, d: int) -> bool {
  k := __load64(d)
  if k == 11 or k == 12 { return rt_dyn_eq(a, b) }
  if k == 3 { return __bitsf(a) == __bitsf(b) }
  if k == 5 { return rt_streq(__pstr(a), __pstr(b)) }
  return a == b
}
# igualdade da VM: structs e arrays campo a campo, ponteiros pela identidade
fn rt_eq(a: int, b: int, d: int) -> bool {
  if a == b { return true }
  k := __load64(d)
  if k != 7 and k != 8 { return rt_eq_flat(a, b, d) }
  if a == 0 or b == 0 { return false }
  n := __load64(d + 8)
  i := 0
  while i < n {
    fd := __load64(d + 16)
    deep := true
    if k == 8 {
      f := __load64(d + 40)
      fd = __load64(f + 24 * i + 8)
      deep = __load64(f + 24 * i + 16) != 0
    }
    x := __load64(a + 8 * i)
    y := __load64(b + 8 * i)
    if deep {
      if not rt_eq(x, y, fd) { return false }
    } else if x != y and not rt_eq_flat(x, y, fd) {
      return false
    }
    i++
  }
  return true
}

# ---------------------------------------------------------------- slices
fn rt_hdr(data: int, n: int, c: int) -> int {
  h := rt_alloc(24)
  __store64(h, data)
  __store64(h + 8, n)
  __store64(h + 16, c)
  return h
}
fn rt_slen(s: int) -> int {
  if s == 0 { return 0 }
  return __load64(s + 8)
}
fn rt_scap(s: int) -> int {
  if s == 0 { return 0 }
  return __load64(s + 16)
}
fn rt_sdata(s: int) -> int {
  if s == 0 { return 0 }
  return __load64(s)
}
fn rt_make_slice(ed: int, n: int, c: int) -> int {
  data := rt_alloc(8 * c + 8)
  i := 0
  while i < c {
    __store64(data + 8 * i, rt_zero(ed))
    i++
  }
  return rt_hdr(data, n, c)
}
fn rt_grow_cap(old: int, need: int) -> int {
  if need > 2 * old { return need }
  if old < 256 {
    if 2 * old > need { return 2 * old }
    return need
  }
  c := old
  while c < need { c = c + (c + 768) / 4 }
  return c
}
# append: escreve no mesmo vetor se couber; senão, um vetor maior
fn rt_append(s: int, src: int, n: int, ed: int) -> int {
  data := rt_sdata(s)
  ln := rt_slen(s)
  cp := rt_scap(s)
  total := ln + n
  if rt_is_value(ed) {
    # structs e arrays entram como cópias
    cp2 := rt_alloc(8 * n + 8)
    j := 0
    while j < n {
      __store64(cp2 + 8 * j, rt_copy_val(__load64(src + 8 * j), ed))
      j++
    }
    src = cp2
  }
  if total <= cp {
    rt_copy(data + 8 * ln, src, 8 * n)
    return rt_hdr(data, total, cp)
  }
  nc := rt_grow_cap(cp, total)
  nd := rt_alloc(8 * nc + 8)
  rt_copy(nd, data, 8 * ln)
  rt_copy(nd + 8 * ln, src, 8 * n)
  z := rt_zero(ed)
  fresh := rt_is_value(ed)
  i := total
  while i < nc {
    if fresh {
      __store64(nd + 8 * i, rt_zero(ed))
    } else {
      __store64(nd + 8 * i, z)
    }
    i++
  }
  return rt_hdr(nd, total, nc)
}
fn rt_copy_slice(d: int, s: int, ed: int) -> int {
  if d == 0 { return 0 }
  n := rt_slen(d)
  m := rt_slen(s)
  if m < n { n = m }
  dd := rt_sdata(d)
  sd := rt_sdata(s)
  i := 0
  while i < n {
    __store64(dd + 8 * i, rt_copy_val(__load64(sd + 8 * i), ed))
    i++
  }
  return n
}
fn rt_copy_str(d: int, s: str) -> int {
  if d == 0 { return 0 }
  p := __strp(s)
  n := rt_slen(d)
  m := __load64(p)
  if m < n { n = m }
  dd := rt_sdata(d)
  i := 0
  while i < n {
    __store64(dd + 8 * i, __load8(p + 8 + i))
    i++
  }
  return n
}
fn rt_nil_index(onde: str, i: int, escrita: bool) {
  if escrita { rt_fail(onde, "Atribuição num map ou slice nil") }
  rt_fail(onde, "Índice " + rt_int_str(i) + " num slice nil")
}
fn rt_make_check(onde: str, n: int, c: int) {
  if n < 0 { rt_fail(onde, "Tamanho inválido no make: " + rt_int_str(n)) }
  if c < 0 { rt_fail(onde, "Tamanho inválido no make: " + rt_int_str(c)) }
  if c < n { rt_fail(onde, "make: a capacidade (" + rt_int_str(c) + ") é menor que o tamanho (" + rt_int_str(n) + ")") }
  if c > 100000000 { rt_fail(onde, "make: tamanho grande demais") }
}
fn rt_index_fail(onde: str, i: int, n: int, oque: str) {
  rt_fail(onde, "Índice " + rt_int_str(i) + " fora " + oque + " de tamanho " + rt_int_str(n))
}
fn rt_slice_fail(onde: str, lo: int, hi: int, n: int, c: int, comcap: bool) {
  msg := "Fatia [" + rt_int_str(lo) + ":" + rt_int_str(hi) + "] fora dos limites (tamanho " + rt_int_str(n)
  if comcap { msg = msg + ", capacidade " + rt_int_str(c) }
  rt_fail(onde, msg + ")")
}
# s[lo:hi] de um slice (hi = -1 quando não foi escrito)
fn rt_sub_slice(onde: str, s: int, lo: int, hi: int) -> int {
  n := rt_slen(s)
  c := rt_scap(s)
  if hi == -1 { hi = n }
  if lo < 0 or hi < lo or hi > c { rt_slice_fail(onde, lo, hi, n, c, s != 0) }
  if s == 0 { return 0 }
  return rt_hdr(rt_sdata(s) + 8 * lo, hi - lo, c - lo)
}
fn rt_sub_array(onde: str, a: int, n: int, lo: int, hi: int) -> int {
  if hi == -1 { hi = n }
  if lo < 0 or hi < lo or hi > n { rt_slice_fail(onde, lo, hi, n, n, false) }
  return rt_hdr(a + 8 * lo, hi - lo, n - lo)
}
fn rt_sub_str(onde: str, s: str, lo: int, hi: int) -> str {
  p := __strp(s)
  n := __load64(p)
  if hi == -1 { hi = n }
  if lo < 0 or hi < lo or hi > n { rt_slice_fail(onde, lo, hi, n, n, false) }
  return rt_utf8_fix(p + 8 + lo, hi - lo)
}

# ---------------------------------------------------------------- UTF-8
# bytes → texto, trocando sequências inválidas por U+FFFD (como o TextDecoder)
fn rt_utf8_fix(p: int, n: int) -> str {
  out := rt_alloc_ns(3 * n + 8)
  o := 0
  i := 0
  while i < n {
    b := __load8(p + i)
    if b < 128 {
      __store8(out + o, b)
      o++
      i++
      continue
    }
    need := 0
    lo := 128
    hi := 191
    if b >= 194 and b <= 223 { need = 1 }
    if b >= 224 and b <= 239 { need = 2 }
    if b >= 240 and b <= 244 { need = 3 }
    if b == 224 { lo = 160 }
    if b == 237 { hi = 159 }
    if b == 240 { lo = 144 }
    if b == 244 { hi = 143 }
    if need == 0 {
      o = rt_put_fffd(out, o)
      i++
      continue
    }
    j := 1
    good := true
    while j <= need {
      if i + j >= n {
        good = false
        break
      }
      c := __load8(p + i + j)
      if j == 1 {
        if c < lo or c > hi {
          good = false
          break
        }
      } else if c < 128 or c > 191 {
        good = false
        break
      }
      j++
    }
    if good {
      rt_copy(out + o, p + i, need + 1)
      o = o + need + 1
      i = i + need + 1
    } else {
      o = rt_put_fffd(out, o)
      i = i + j
    }
  }
  return rt_mkstr(out, o)
}
fn rt_put_fffd(out: int, o: int) -> int {
  __store8(out + o, 239)
  __store8(out + o + 1, 191)
  __store8(out + o + 2, 189)
  return o + 3
}
fn rt_rune_put(out: int, o: int, r: int) -> int {
  if r < 0 or r > 1114111 or (r >= 55296 and r <= 57343) { return rt_put_fffd(out, o) }
  if r < 128 {
    __store8(out + o, r)
    return o + 1
  }
  if r < 2048 {
    __store8(out + o, 192 | (r >> 6))
    __store8(out + o + 1, 128 | (r & 63))
    return o + 2
  }
  if r < 65536 {
    __store8(out + o, 224 | (r >> 12))
    __store8(out + o + 1, 128 | ((r >> 6) & 63))
    __store8(out + o + 2, 128 | (r & 63))
    return o + 3
  }
  __store8(out + o, 240 | (r >> 18))
  __store8(out + o + 1, 128 | ((r >> 12) & 63))
  __store8(out + o + 2, 128 | ((r >> 6) & 63))
  __store8(out + o + 3, 128 | (r & 63))
  return o + 4
}
fn rt_rune_str(r: int) -> str {
  o := rt_rune_put(rt_tmp, 0, r)
  return rt_mkstr(rt_tmp, o)
}
let rt_rune_n: int = 0
# runa que começa no byte i de um texto válido; o tamanho fica em rt_rune_n
fn rt_rune_at(p: int, i: int) -> int {
  b := __load8(p + i)
  if b < 128 {
    rt_rune_n = 1
    return b
  }
  if b < 224 {
    rt_rune_n = 2
    return ((b & 31) << 6) | (__load8(p + i + 1) & 63)
  }
  if b < 240 {
    rt_rune_n = 3
    return ((b & 15) << 12) | ((__load8(p + i + 1) & 63) << 6) | (__load8(p + i + 2) & 63)
  }
  rt_rune_n = 4
  return ((b & 7) << 18) | ((__load8(p + i + 1) & 63) << 12) | ((__load8(p + i + 2) & 63) << 6) | (__load8(p + i + 3) & 63)
}
fn rt_str_bytes(s: str) -> int {
  p := __strp(s)
  n := __load64(p)
  data := rt_alloc(8 * n + 8)
  i := 0
  while i < n {
    __store64(data + 8 * i, __load8(p + 8 + i))
    i++
  }
  return rt_hdr(data, n, n)
}
fn rt_str_runes(s: str) -> int {
  p := __strp(s) + 8
  n := __load64(p - 8)
  data := rt_alloc(8 * n + 8)
  k := 0
  i := 0
  while i < n {
    __store64(data + 8 * k, rt_rune_at(p, i))
    i = i + rt_rune_n
    k++
  }
  return rt_hdr(data, k, k)
}
fn rt_bytes_str(s: int) -> str {
  n := rt_slen(s)
  d := rt_sdata(s)
  tmp := rt_alloc_ns(n + 8)
  i := 0
  while i < n {
    __store8(tmp + i, __load64(d + 8 * i) & 255)
    i++
  }
  return rt_utf8_fix(tmp, n)
}
fn rt_runes_str(s: int) -> str {
  n := rt_slen(s)
  d := rt_sdata(s)
  out := rt_alloc_ns(4 * n + 8)
  o := 0
  i := 0
  while i < n {
    o = rt_rune_put(out, o, __load64(d + 8 * i))
    i++
  }
  return rt_mkstr(out, o)
}

# ---------------------------------------------------------------- maps
# [0] quantidade, [8] entradas, [16] entradas usadas, [24] capacidade, [32] índice, [40] tamanho do índice, [48] tipo da chave
# entrada: [chave, valor, viva]; índice: 0 = vazio, -1 = apagado, senão posição da entrada + 1
fn rt_map_new(kk: int) -> int {
  m := rt_alloc(56)
  __store64(m, 0)
  __store64(m + 8, rt_alloc(24 * 8))
  __store64(m + 16, 0)
  __store64(m + 24, 8)
  __store64(m + 32, rt_alloc(8 * 16))
  __store64(m + 40, 16)
  __store64(m + 48, kk)
  i := 0
  while i < 16 {
    __store64(__load64(m + 32) + 8 * i, 0)
    i++
  }
  return m
}
fn rt_mix(h: int) -> int {
  h = h ^ (h >> 33)
  h = h * -(49064778 * 1000000000 + 989728563)
  h = h ^ (h >> 33)
  return h
}
fn rt_hash(k: int, kk: int) -> int {
  if kk == 1 {
    x := __bitsf(k)
    if x == 0.0 { return rt_mix(0) }
    if x != x { return rt_mix(4095 << 51) }
    return rt_mix(k)
  }
  if kk == 2 {
    p := __strp(__pstr(k))
    n := __load64(p)
    h := 1469598103 * 1000000000 + 934665603
    i := 0
    while i < n {
      h = (h ^ __load8(p + 8 + i)) * 1099511628211
      i++
    }
    return rt_mix(h)
  }
  return rt_mix(k)
}
fn rt_keq(a: int, b: int, kk: int) -> bool {
  if kk == 1 {
    x := __bitsf(a)
    y := __bitsf(b)
    return x == y or (x != x and y != y)
  }
  if kk == 2 { return rt_streq(__pstr(a), __pstr(b)) }
  return a == b
}
fn rt_map_find(m: int, k: int) -> int {
  if m == 0 { return -1 }
  kk := __load64(m + 48)
  idx := __load64(m + 32)
  mask := __load64(m + 40) - 1
  e := __load64(m + 8)
  h := rt_hash(k, kk) & mask
  for {
    s := __load64(idx + 8 * h)
    if s == 0 { return -1 }
    if s > 0 and rt_keq(__load64(e + 24 * (s - 1)), k, kk) { return s - 1 }
    h = (h + 1) & mask
  }
  return -1
}
fn rt_map_reindex(m: int, size: int) {
  idx := rt_alloc(8 * size)
  i := 0
  while i < size {
    __store64(idx + 8 * i, 0)
    i++
  }
  kk := __load64(m + 48)
  e := __load64(m + 8)
  n := __load64(m + 16)
  mask := size - 1
  i = 0
  while i < n {
    if __load64(e + 24 * i + 16) != 0 {
      h := rt_hash(__load64(e + 24 * i), kk) & mask
      while __load64(idx + 8 * h) != 0 { h = (h + 1) & mask }
      __store64(idx + 8 * h, i + 1)
    }
    i++
  }
  __store64(m + 32, idx)
  __store64(m + 40, size)
}
fn rt_map_set(onde: str, m: int, k: int, v: int) {
  if m == 0 { rt_fail(onde, "Atribuição num map ou slice nil") }
  i := rt_map_find(m, k)
  e := __load64(m + 8)
  if i >= 0 {
    __store64(e + 24 * i + 8, v)
    return
  }
  n := __load64(m + 16)
  if n == __load64(m + 24) {
    nc := 2 * n
    ne := rt_alloc(24 * nc)
    rt_copy(ne, e, 24 * n)
    __store64(m + 8, ne)
    __store64(m + 24, nc)
    e = ne
  }
  __store64(e + 24 * n, k)
  __store64(e + 24 * n + 8, v)
  __store64(e + 24 * n + 16, 1)
  __store64(m + 16, n + 1)
  __store64(m, __load64(m) + 1)
  size := __load64(m + 40)
  if 2 * (n + 1) >= size {
    rt_map_reindex(m, 2 * size)
  } else {
    kk := __load64(m + 48)
    idx := __load64(m + 32)
    mask := size - 1
    h := rt_hash(k, kk) & mask
    while __load64(idx + 8 * h) > 0 { h = (h + 1) & mask }
    __store64(idx + 8 * h, n + 1)
  }
}
fn rt_map_del(m: int, k: int) {
  i := rt_map_find(m, k)
  if i < 0 { return }
  e := __load64(m + 8)
  __store64(e + 24 * i + 16, 0)
  __store64(m, __load64(m) - 1)
  kk := __load64(m + 48)
  idx := __load64(m + 32)
  mask := __load64(m + 40) - 1
  h := rt_hash(k, kk) & mask
  while __load64(idx + 8 * h) != i + 1 { h = (h + 1) & mask }
  __store64(idx + 8 * h, -1)
}
fn rt_map_len(m: int) -> int {
  if m == 0 { return 0 }
  return __load64(m)
}
fn rt_map_val(m: int, i: int) -> int { return __load64(__load64(m + 8) + 24 * i + 8) }
fn rt_map_key(m: int, i: int) -> int { return __load64(__load64(m + 8) + 24 * i) }
fn rt_map_live(m: int, i: int) -> bool { return __load64(__load64(m + 8) + 24 * i + 16) != 0 }
fn rt_map_used(m: int) -> int {
  if m == 0 { return 0 }
  return __load64(m + 16)
}

# ---------------------------------------------------------------- texto de um valor (print, str, +)
let rt_sb: int = 0
let rt_sb_n: int = 0
let rt_sb_cap: int = 0
fn rt_sb_put(p: int, n: int) {
  if rt_sb_n + n > rt_sb_cap {
    nc := 2 * rt_sb_cap + n + 64
    nb := rt_alloc_ns(nc)
    rt_copy(nb, rt_sb, rt_sb_n)
    rt_sb = nb
    rt_sb_cap = nc
  }
  rt_copy(rt_sb + rt_sb_n, p, n)
  rt_sb_n = rt_sb_n + n
}
fn rt_sb_str(s: str) {
  p := __strp(s)
  rt_sb_put(p + 8, __load64(p))
}
fn rt_cmp_key(a: int, b: int, d: int) -> int {
  k := __load64(d)
  if k == 5 { return rt_strcmp(__pstr(a), __pstr(b)) }
  if k == 3 {
    x := __bitsf(a)
    y := __bitsf(b)
    if x < y { return -1 }
    if x > y { return 1 }
    return 0
  }
  if k == 2 {
    a = a ^ (1 << 63)
    b = b ^ (1 << 63)
  }
  if a < b { return -1 }
  if a > b { return 1 }
  return 0
}
fn rt_fmt(v: int, d: int, nested: bool) {
  k := __load64(d)
  if k == 1 {
    rt_sb_str(rt_int_str(v))
  } else if k == 2 {
    rt_sb_str(rt_uint_str(uint64(v)))
  } else if k == 3 {
    rt_sb_str(rt_num_str(__bitsf(v)))
  } else if k == 4 {
    if v != 0 { rt_sb_str("true") } else { rt_sb_str("false") }
  } else if k == 5 {
    if nested { rt_sb_str("\"") }
    rt_sb_str(__pstr(v))
    if nested { rt_sb_str("\"") }
  } else if v == 0 {
    rt_sb_str("nil")
  } else if k == 11 or k == 12 {
    bd := __load64(v)
    x := __load64(v + 8)
    if __load64(bd) == 9 and __load64(__load64(bd + 16)) == 8 {
      rt_sb_str("&")
      rt_fmt(x, __load64(bd + 16), nested)
    } else {
      rt_fmt(x, bd, nested)
    }
  } else if k == 13 {
    rt_sb_str(__pstr(v))
  } else if k == 14 {
    rt_sb_str("fn")
  } else if k == 6 or k == 7 {
    n := __load64(d + 8)
    data := v
    if k == 6 {
      n = __load64(v + 8)
      data = __load64(v)
    }
    e := __load64(d + 16)
    rt_sb_str("[")
    i := 0
    while i < n {
      if i > 0 { rt_sb_str(" ") }
      rt_fmt(__load64(data + 8 * i), e, true)
      i++
    }
    rt_sb_str("]")
  } else if k == 8 {
    rt_sb_str(__pstr(__load64(d + 32)))
    rt_sb_str("{")
    n := __load64(d + 8)
    f := __load64(d + 40)
    i := 0
    while i < n {
      if i > 0 { rt_sb_str(", ") }
      rt_sb_str(__pstr(__load64(f + 24 * i)))
      rt_sb_str(": ")
      rt_fmt(__load64(v + 8 * i), __load64(f + 24 * i + 8), true)
      i++
    }
    rt_sb_str("}")
  } else if k == 9 {
    e := __load64(d + 16)
    if rt_is_value(e) {
      rt_fmt(v, e, nested)
    } else {
      rt_sb_str("&")
      rt_fmt(__load64(v), e, true)
    }
  } else if k == 10 {
    kd := __load64(d + 24)
    vd := __load64(d + 16)
    n := __load64(v + 16)
    ord := rt_alloc(8 * n + 8)
    c := 0
    i := 0
    while i < n {
      if rt_map_live(v, i) {
        j := c
        while j > 0 and rt_cmp_key(rt_map_key(v, __load64(ord + 8 * (j - 1))), rt_map_key(v, i), kd) > 0 {
          __store64(ord + 8 * j, __load64(ord + 8 * (j - 1)))
          j--
        }
        __store64(ord + 8 * j, i)
        c++
      }
      i++
    }
    rt_sb_str("map[")
    i = 0
    while i < c {
      if i > 0 { rt_sb_str(" ") }
      x := __load64(ord + 8 * i)
      rt_fmt(rt_map_key(v, x), kd, true)
      rt_sb_str(":")
      rt_fmt(rt_map_val(v, x), vd, true)
      i++
    }
    rt_sb_str("]")
  } else {
    rt_sb_str("?")
  }
}
fn rt_val_str(v: int, d: int) -> str {
  rt_sb_n = 0
  rt_fmt(v, d, false)
  return rt_mkstr(rt_sb, rt_sb_n)
}
fn rt_out_val(v: int, d: int) { rt_out_str(rt_val_str(v, d)) }
