print(1.0 / 7, 0.1 + 0.2, 1e21, 1e20, 123456789012.5, 1e-7, 0.000001, 1.5e-10)
print(5e-324, 1.7976931348623157e308, -0.0, 2.0 ** 53 + 1, 9007199254740993.0)
print(1.0 / 3 * 3, 100.0 / 3, 2.0 ** 70, 2.0 ** -20, 12345678901234567890.0)
print(0.5, 0.25, 999999999999.5, 9999999999995.0, 1.0e15 + 0.3)
let x = 1.0
for i = 1 to 30 {
  x = x * 1.37
  print(i, x, 1.0 / x, x * 1000000.0)
}
let s = 0.0
for k = 1 to 200 { s = s + 1.0 / num(k * k) }
print(s, s * 6, 2.0 ** 0.5, 10.0 ** 0.3, 7.0 % 2.5, -7.0 % 2.5)
let a: int8 = 100
a = a + 100
let b: uint8 = 200
b = b * 3
let c: int32 = 2147483647
c = c + 1
let d: uint16 = 1
d = d - 2
print(a, b, c, d, int8(300), uint32(-1), 7 / 2, -7 / 2, -7 % 3, 1 << 62, -8 >> 1)
let u: uint64 = 0
u = u - 1
print(u, u / 10, u % 7, u >> 60)
print(int(3.99), int(-3.99), int(1e30) == 0, num(7) / 2)
print("a" < "b", "abc" == "abc", "x" != "y", "é" > "e", 1 < 2.5, 2.5 >= 2.5)
print(not true, not 0, true and false, false or true, "" + 1 + true + 2.5)
let t = 0
for t2 := 0; t2 < 10; t2++ {
  if t2 == 3 { continue }
  if t2 == 8 { break }
  t += t2
}
print(t)
switch t {
case 1, 2: print("um ou dois")
case 25: print("vinte e cinco")
  fallthrough
case 99: print("caiu")
default: print("outro")
}
fn fat(n: int) -> int {
  if n <= 1 { return 1 }
  return n * fat(n - 1)
}
fn media(a: num, b: num) -> num { return (a + b) / 2 }
print(fat(20), media(1, 2), fat(10) + 0.5)
