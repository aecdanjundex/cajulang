# 3 milhões de objetos: só uns poucos ficam vivos ao mesmo tempo
struct No { v: int, nome: str, prox: *No }
let lista: *No = nil
total := 0
for i := 0; i < 3000000; i++ {
  lista = &No{v: i, nome: "n" + str(i % 100), prox: lista}
  if i % 10000 == 9999 {
    for p := lista; p != nil; p = p.prox { total += p.v % 7 }
    lista = nil
  }
}
print(total)
# maps e slices que crescem e somem
soma := 0
for r := 0; r < 200; r++ {
  m := map[int][]int{}
  for k := 0; k < 500; k++ { m[k] = append(m[k], k, r) }
  soma += len(m) + m[499][1]
}
print(soma)
# uma estrutura que fica viva o tempo todo, conferida no fim
fixos := []*No{}
for i := 0; i < 1000; i++ { fixos = append(fixos, &No{v: i, nome: "fixo"}) }
let lixo: *No = nil
for i := 0; i < 1000000; i++ { lixo = &No{v: i} }
ok := true
for i, n := range fixos { if n.v != i or n.nome != "fixo" { ok = false } }
print(ok)
