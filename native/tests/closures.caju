fn gerador() -> fn() -> fn() -> int {
  base := 100
  return fn() -> fn() -> int {
    k := 0
    return fn() -> int {
      k++
      base++
      return base * 10 + k
    }
  }
}
g := gerador()
a := g()
b := g()
print(a(), a(), b(), a())
let fat: fn(int) -> int = nil
fat = fn(n: int) -> int {
  if n <= 1 { return 1 }
  return n * fat(n - 1)
}
print(fat(10))
fn ajusta(n: int) -> fn() -> int {
  return fn() -> int { n *= 2; return n }
}
d := ajusta(3)
print(d(), d(), d())
conta := 0
incr := fn() { conta++ }
for i := 0; i < 5; i++ { incr() }
print(conta)
let fs: []fn() -> int = nil
for i := 0; i < 3; i++ {
  j := i * i
  fs = append(fs, fn() -> int { return i + j })
}
for _, f := range fs { print(f()) }
fs2 := []fn() -> int{}
for i := range 3 { fs2 = append(fs2, fn() -> int { return i }) }
for _, f := range fs2 { print(f()) }
struct Pilha { itens: []int }
fn (p: *Pilha) poe(x: int) { p.itens = append(p.itens, x) }
fn (p: Pilha) topo() -> int { return p.itens[len(p.itens) - 1] }
pl := &Pilha{}
poe := pl.poe
poe(1)
poe(2)
tp := pl.topo
poe(3)
print(pl.itens, tp(), pl.topo())
struct Par { a: int, b: str }
fn dois() -> (int, str) { return 7, "sete" }
let pr: Par = Par{}
let mp: map[str]int = map[str]int{}
pr.a, pr.b = dois()
mp["x"], pr.b = dois()
print(pr, mp)
let xs: []any = []any{Par{1, "a"}, Par{1, "a"}, &Par{2, "b"}}
print(xs[0] == xs[1], xs[1] == xs[2], xs)
fn aplica(f: fn(any) -> any, x: any) -> any { return f(x) }
print(aplica(fn(v: any) -> any { return v + v }, 21), aplica(fn(v: any) -> any { return v + "!" }, "oi"))
fn soma(ns: []int) -> (total: int, n: int) {
  for _, x := range ns { total += x }
  n = len(ns)
  return total, n
}
t, n := soma([]int{1, 2, 3, 4})
print(t, n)
fn media(ns: []int) -> num {
  t, n := soma(ns)
  return num(t) / num(n)
}
print(media([]int{1, 2, 3, 4}))
