fn soma(a, b) { return a + b }
fn divide(a, b) { return a / b }
print(soma(1, 2), soma(1.5, 2), soma("a", 1), soma(2, "b"), divide(7, 2), divide(6, 3))
print(soma(0.5, 0.5), divide(1, 3), soma(-3, 3))
fn maior(a, b) {
  if a > b { return a }
  return b
}
print(maior(3, 9), maior("pera", "maçã"), maior(2.5, 1))
fn eh(x) {
  if x { return "sim" }
  return "não"
}
print(eh(0), eh(1), eh(""), eh("x"), eh(nil), eh(false), eh(0.0), eh([]int{}))
let xs: []any = []any{1, 2.5, "três", true, nil, []int{4}, map[str]int{"a": 1}}
print(xs, len(xs))
for i, x := range xs { print(i, x, x == nil) }
let a: any = 5
let b: any = 5
let c: any = 5.0
print(a == b, a == c, a != c, a == 5, c == 5.0)
let n: int = a
let f: num = c
print(n + 1, f / 2, int(c) + 1, num(a) / 2)
fn par(x: int) -> (int, int) { return x / 2, x % 2 }
q, r := par(17)
print(q, r)
_, r2 := par(4)
print(r2, par(9))
fn nomes() -> (primeiro: str, ultimo: str) {
  primeiro = "Ana"
  ultimo = "Lima"
  return
}
fn passa() -> (str, str) { return nomes() }
p1, p2 := passa()
print(p1, p2)
fn fabrica(base: int) -> (fn(int) -> int, fn() -> int) {
  total := base
  add := fn(x: int) -> int { total += x; return total }
  get := fn() -> int { return total }
  return add, get
}
add, get := fabrica(10)
add(5)
add(7)
print(get())
fn compoe(f: fn(int) -> int, g: fn(int) -> int) -> fn(int) -> int {
  return fn(x: int) -> int { return g(f(x)) }
}
inc := fn(x: int) -> int { return x + 1 }
dbl := fn(x: int) -> int { return x * 2 }
h := compoe(inc, dbl)
print(h(3), compoe(dbl, inc)(3))
fn soma3(x: int) -> int { return x + 3 }
k := compoe(soma3, soma3)
print(k(1))
let fs: []fn() -> str = nil
for _, s := range []str{"a", "b", "c"} { fs = append(fs, fn() -> str { return s + s }) }
for _, fx := range fs { print(fx()) }
struct Op { nome: str, f: fn(int, int) -> int }
ops := []Op{Op{"mais", fn(a: int, b: int) -> int { return a + b }}, Op{"vezes", fn(a: int, b: int) -> int { return a * b }}}
for _, o := range ops { print(o.nome, o.f(6, 7)) }
struct Cont { n: int }
fn (c: Cont) valor() -> int { return c.n }
fn (c: *Cont) mais() { c.n++ }
ct := Cont{1}
v := ct.valor
m := ct.mais
m()
m()
print(v(), ct.n, ct.valor())
interface Falador { fala() -> str }
struct Gato { nome: str }
fn (g: Gato) fala() -> str { return g.nome + ": miau" }
struct Robo { id: int }
fn (r: *Robo) fala() -> str { r.id++; return "bip " + str(r.id) }
let fl: []Falador = []Falador{Gato{"Tom"}, &Robo{7}}
for _, x := range fl { print(x.fala(), x.fala()) }
print(fl)
let g: Falador = Gato{"Mia"}
gg, ok := g.(Gato)
print(gg.nome, ok)
_, ok2 := g.(*Robo)
print(ok2)
fn tipo(x: any) -> str {
  switch y := x.(type) {
  case int, num: return "número " + str(y)
  case str: return "texto " + y
  case Falador: return "falador " + y.fala()
  case nil: return "nada"
  }
  return "outro"
}
print(tipo(1), tipo(2.5), tipo("x"), tipo(Gato{"Lu"}), tipo(nil), tipo(true))
e1 := errors.New("falhou")
let e2: error = nil
print(e1, e2, e1 == nil, e2 == nil, e1.Error())
fn pode(x: int) -> (int, error) {
  if x < 0 { return 0, errors.New("negativo: " + str(x)) }
  return x * 10, nil
}
for _, x := range []int{3, -2} {
  if w, err := pode(x); err != nil { print("erro:", err) } else { print("ok:", w) }
}
let mm: map[str]any = map[str]any{"n": 1, "s": "x", "l": []any{1, "dois"}}
print(mm, mm["n"], mm["zz"])
struct Caixa { conteudo: any }
print(Caixa{3}, Caixa{"oi"}, Caixa{nil}, Caixa{&Robo{1}})
