struct Ponto { x: int, y: int }
struct Linha { a: Ponto, b: Ponto, nome: str }
struct Base { id: int }
struct Filho { Base, tag: str }
fn (p: Ponto) soma() -> int { return p.x + p.y }
fn (p: *Ponto) mover(dx: int) { p.x += dx }
fn (b: *Base) marca(n: int) { b.id = n }
fn (b: Base) mostra() -> str { return "base " + str(b.id) }

let p = Ponto{x: 1, y: 2}
q := p
q.x = 10
print(p, q, p == q, p != q, p.soma())
p.mover(5)
print(p)
pp := &p
pp.mover(1)
(*pp).y = 7
print(p, *pp, pp.soma())
l := Linha{a: p, nome: "l1"}
l.a.x = 99
l.b = l.a
l.b.y = -1
print(l, p)
let arr: [4]int = [4]int{1, 2}
b2 := arr
b2[0] = 50
print(arr, b2, len(arr), arr == b2)
arr[3] += 4
arr[1] *= 3
print(arr)
f := Filho{Base: Base{id: 3}, tag: "x"}
f.marca(8)
print(f.id, f.mostra(), f)
let pts: []Ponto = []Ponto{}
for i := 0; i < 3; i++ { pts = append(pts, Ponto{x: i, y: i * i}) }
pts[1].x = 100
c := pts[2]
c.y = 1000
print(pts, c)
for i, v := range pts { v.x = -1; print(i, v) }
print(pts)
let m: map[str]int = make(map[str]int)
m["a"] = 1
m["b"] += 5
m["a"]++
vz, ok := m["z"]
w, ok2 := m["b"]
print(m, vz, ok, w, ok2, len(m))
delete(m, "a")
print(m)
mp := map[int]Ponto{1: Ponto{x: 1}, 2: Ponto{y: 2}}
print(mp, mp[3])
s := []int{1, 2, 3, 4, 5}
t := s[1:3]
t = append(t, 40)
print(s, t, len(t), cap(t))
u := append([]int{}, s...)
u[0] = 77
print(s, u)
n := copy(u, []int{9, 9})
print(n, u, s[:2], s[3:], s[:])
x, y := 1, 2
x, y = y, x
print(x, y)
a3 := [3]int{1, 2, 3}
sl := a3[:]
sl[0] = 42
print(a3, sl)
txt := "olá, mundo"
for i, r := range txt { print(i, r, str(r)) }
bs := []byte(txt)
rs := []rune(txt)
print(len(bs), len(rs), txt[1], txt[0:2], str(bs[0:3]), str(rs[1:3]))
print(str([]byte{0xff, 65, 0xc3}))
let np: *Ponto = nil
print(np == nil, np)
nn := new(int)
*nn = 5
*nn += 2
print(*nn)
cnt := 0
inc := &cnt
*inc = *inc + 3
print(cnt)
let ns: []int
print(ns == nil, len(ns), ns)
ns = append(ns, 1)
print(ns, ns == nil)
grid := [][]int{}
for i := 0; i < 3; i++ {
  row := make([]int, 3)
  for j := 0; j < 3; j++ { row[j] = i * j }
  grid = append(grid, row)
}
print(grid)
for k := range 3 { print("k", k) }
idx := map[str][]int{}
idx["a"] = append(idx["a"], 1)
idx["a"] = append(idx["a"], 2)
print(idx)
fn troca(p: *int, q: *int) { t := *p; *p = *q; *q = t }
aa, bb := 1, 2
troca(&aa, &bb)
print(aa, bb)
fn zera(xs: []int) { for i := range xs { xs[i] = 0 } }
zera(s)
print(s)
fn conta(n: int) -> *int { r := n * 2; return &r }
r1 := conta(4)
r2 := conta(5)
print(*r1, *r2)
