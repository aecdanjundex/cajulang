fn sum(a, b) { return a + b }
fn divide(a, b) { return a / b }
print(sum(1, 2), sum(1.5, 2), sum("a", 1), sum(2, "b"), divide(7, 2), divide(6, 3))
print(sum(0.5, 0.5), divide(1, 3), sum(-3, 3))
fn largest(a, b) {
  if a > b { return a }
  return b
}
print(largest(3, 9), largest("pear", "café"), largest(2.5, 1))
fn truthy(x) {
  if x { return "yes" }
  return "no"
}
print(truthy(0), truthy(1), truthy(""), truthy("x"), truthy(nil), truthy(false), truthy(0.0), truthy([]int{}))
let xs: []any = []any{1, 2.5, "three", true, nil, []int{4}, map[str]int{"a": 1}}
print(xs, len(xs))
for i, x := range xs { print(i, x, x == nil) }
let a: any = 5
let b: any = 5
let c: any = 5.0
print(a == b, a == c, a != c, a == 5, c == 5.0)
let n: int = a
let f: num = c
print(n + 1, f / 2, int(c) + 1, num(a) / 2)
fn halves(x: int) -> (int, int) { return x / 2, x % 2 }
q, r := halves(17)
print(q, r)
_, r2 := halves(4)
print(r2, halves(9))
fn names() -> (first: str, last: str) {
  first = "Ana"
  last = "Lima"
  return
}
fn forward() -> (str, str) { return names() }
p1, p2 := forward()
print(p1, p2)
fn factory(base: int) -> (fn(int) -> int, fn() -> int) {
  total := base
  add := fn(x: int) -> int { total += x; return total }
  get := fn() -> int { return total }
  return add, get
}
add, get := factory(10)
add(5)
add(7)
print(get())
fn compose(f: fn(int) -> int, g: fn(int) -> int) -> fn(int) -> int {
  return fn(x: int) -> int { return g(f(x)) }
}
inc := fn(x: int) -> int { return x + 1 }
dbl := fn(x: int) -> int { return x * 2 }
h := compose(inc, dbl)
print(h(3), compose(dbl, inc)(3))
fn add3(x: int) -> int { return x + 3 }
k := compose(add3, add3)
print(k(1))
let fs: []fn() -> str = nil
for _, s := range []str{"a", "b", "c"} { fs = append(fs, fn() -> str { return s + s }) }
for _, fx := range fs { print(fx()) }
struct Op { name: str, f: fn(int, int) -> int }
ops := []Op{Op{"plus", fn(a: int, b: int) -> int { return a + b }}, Op{"times", fn(a: int, b: int) -> int { return a * b }}}
for _, o := range ops { print(o.name, o.f(6, 7)) }
struct Counter { n: int }
fn (c: Counter) value() -> int { return c.n }
fn (c: *Counter) plus() { c.n++ }
ct := Counter{1}
v := ct.value
m := ct.plus
m()
m()
print(v(), ct.n, ct.value())
interface Speaker { speak() -> str }
struct Cat { name: str }
fn (g: Cat) speak() -> str { return g.name + ": meow" }
struct Robot { id: int }
fn (r: *Robot) speak() -> str { r.id++; return "beep " + str(r.id) }
let fl: []Speaker = []Speaker{Cat{"Tom"}, &Robot{7}}
for _, x := range fl { print(x.speak(), x.speak()) }
print(fl)
let g: Speaker = Cat{"Mia"}
gg, ok := g.(Cat)
print(gg.name, ok)
_, ok2 := g.(*Robot)
print(ok2)
fn kind(x: any) -> str {
  switch y := x.(type) {
  case int, num: return "number " + str(y)
  case str: return "text " + y
  case Speaker: return "speaker " + y.speak()
  case nil: return "nothing"
  }
  return "other"
}
print(kind(1), kind(2.5), kind("x"), kind(Cat{"Lu"}), kind(nil), kind(true))
e1 := errors.New("failed")
let e2: error = nil
print(e1, e2, e1 == nil, e2 == nil, e1.Error())
fn attempt(x: int) -> (int, error) {
  if x < 0 { return 0, errors.New("negative: " + str(x)) }
  return x * 10, nil
}
for _, x := range []int{3, -2} {
  if w, err := attempt(x); err != nil { print("error:", err) } else { print("ok:", w) }
}
let mm: map[str]any = map[str]any{"n": 1, "s": "x", "l": []any{1, "two"}}
print(mm, mm["n"], mm["zz"])
struct Box { content: any }
print(Box{3}, Box{"hi"}, Box{nil}, Box{&Robot{1}})
