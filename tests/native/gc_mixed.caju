# the collector runs several times while these values are still in use
struct Tree { v: int, left: *Tree, right: *Tree }
fn build(d: int, v: int) -> *Tree {
  if d == 0 { return nil }
  garbage := []int{1, 2, 3, 4, 5, 6, 7, 8}
  a := &Tree{v: v + garbage[0] - 1}
  a.left = build(d - 1, 2 * v)
  a.right = build(d - 1, 2 * v + 1)
  return a
}
fn sum(a: *Tree) -> int {
  if a == nil { return 0 }
  return a.v + sum(a.left) + sum(a.right)
}
pinned := build(12, 1)
names := map[str]any{}
fs := []fn() -> str{}
total := 0
for r := 0; r < 40; r++ {
  t := build(10, r)
  total += sum(t)
  k := "key" + str(r)
  names[k] = []any{r, k, 2.5 * num(r)}
  fs = append(fs, fn() -> str { return k + "!" })
  if r % 7 == 0 { delete(names, "key" + str(r - 7)) }
}
print(total, sum(pinned), len(names), names["key39"], fs[0](), fs[39]())
txt := ""
for i := 0; i < 3000; i++ { txt = txt + str(i % 10) }
print(len(txt), txt[2990:])
