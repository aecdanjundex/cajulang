# Slices are windows over an array: slicing does not copy, and append
# creates a bigger array when the capacity runs out.
grades := []int{7, 9, 4}
grades = append(grades, 10, 6)
print(grades, "length", len(grades), "capacity", cap(grades))

middle := grades[1:3]
middle[0] = 99                   # also changes grades[1]
print(grades, middle)

# range gives the position and the value
sum := 0
for _, n := range grades { sum += n }
print("average", sum / len(grades), "or", float64(sum) / float64(len(grades)))

# map: key → value
stock := map[str]int{"banana": 12, "cashew": 30}
stock["mango"] = 5
stock["banana"] -= 2
delete(stock, "cashew")
if qty, ok := stock["cashew"]; !ok { print("out of cashews:", qty) }
for fruit, qty := range stock { print(fruit, qty) }
print(stock)

# arrays have a fixed size and are copied on assignment
a := [3]str{"x", "y", "z"}
b := a
b[0] = "changed"
print(a, b)

# matrix: slice of slices
tab := make([][]int, 3)
for i := range tab {
  tab[i] = make([]int, 3)
  for j := range tab[i] { tab[i][j] = (i + 1) * (j + 1) }
}
print(tab)
