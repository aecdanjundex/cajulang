import "std/os"
import "std/strings"
a := os.args()
print(len(a) >= 1, os.getenv("CAJU_SKIP_SLEEP"), os.getenv("NO_SUCH_VARIABLE_X") == "")
path := "/tmp/caju-os-test-" + str(os.getpid())
err := os.write_file(path, "line 1\nline 2\n", 0o644)
print(err, os.exists(path))
data, err2 := os.read_file(path)
print(err2, len(data), strings.split(strings.trim_space(data), "\n"))
print(os.remove(path), os.exists(path))
_, err3 := os.read_file("/no/such/file")
print(err3)
t0 := os.nanotime()
print(os.nanotime() >= t0)
print("before")
os.stdout("raw stdout\n")
print("after")
os.exit(3)
print("not printed")
