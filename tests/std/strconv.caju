import "std/strconv"
import "std/math"
print(strconv.format_int(255, 16), strconv.format_int(-255, 2), strconv.format_int(math.MIN_INT, 10))
v, err := strconv.parse_int("0x7fffffffffffffff", 0)
print(v, err)
v, err = strconv.parse_int("-9223372036854775808", 10)
print(v, err)
v, err = strconv.parse_int("9223372036854775808", 10)
print(v, err)
v, err = strconv.atoi("12a")
print(v, err)
fs := []str{"0.1", "1.5", "3.14159", "1e21", "1e-7", "5e-324", "2.2250738585072014e-308", "1.7976931348623157e308", "1e400",
  "9007199254740993", "0.30000000000000004", "123456789012345678901234567890", "4.9406564584124654e-324", "2.4703282292062327e-324",
  "2.4703282292062328e-324", "1_000.5", ".5", "7e22", "1e23", "8.98846567431158e307", "0.000001", "1.0000000000000002"}
for _, s := range fs {
  f, e := strconv.parse_float(s)
  print(s, math.bits(f), e)
}
_, e := strconv.parse_float("1.2.3")
print(e)
print(strconv.quote("a\"b\\c\n\t\x01"))
