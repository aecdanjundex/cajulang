let calls: int = 0
print("loaded")
dllexport fn sum(a: i32, b: i32) -> i32 {
  calls++
  return a + b
}
dllexport fn average(a: f64, b: f64) -> f64 { return (a + b) / 2 }
dllexport fn greeting(name: str) -> str {
  calls++
  return "Hello, " + name + "! call " + str(calls)
}
dllexport fn crash(n: i32) -> i32 {
  xs := []int{1, 2, 3}
  return xs[n]
}
dllexport fn parallel(n: i32) -> i64 {
  c := make(chan int, 4)
  for k := 0; k < 4; k++ {
    go fn(k: int) {
      t := 0
      for i := 0; i < n; i++ { t += i * k }
      c <- t
    }(k)
  }
  total := 0
  for k := 0; k < 4; k++ { total += <-c }
  return total
}
dllexport fn safe(n: i32) -> i32 {
  r := 0
  defer fn() {
    if recover() != nil { r = -1 }
  }()
  if n < 0 { panic("negative") }
  r = n * 2
  return r
}
dllexport fn total() -> i32 { return calls }
