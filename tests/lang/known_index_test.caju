# After a[i] is checked, the native compiler skips the checks of a[i] that follow until a or i
# may have changed (Fn.kn), and a top-level variable stays a local of the top-level code when
# functions only use their own variables of the same name. Everything must behave as with
# every check in place: same results, same errors at the same lines.
import { describe, it, expect, run_source } from "std/testing"

fn qsort(a: []int, lo: int, hi: int) {
  while lo < hi {
    p := a[(lo + hi) / 2]
    i := lo
    j := hi
    while i <= j {
      while a[i] < p { i++ }
      while a[j] > p { j-- }
      if i <= j {
        t := a[i]
        a[i] = a[j]
        a[j] = t
        i++
        j--
      }
    }
    if j - lo < hi - i {
      qsort(a, lo, j)
      lo = i
    } else {
      qsort(a, i, hi)
      hi = j
    }
  }
}

fn swap_all(a: []str, b: []bool) -> int {
  n := 0
  i := 0
  j := len(a) - 1
  while i < j {
    s := a[i]
    a[i] = a[j] + "!"                  # allocates: the collector may run between the checks
    a[j] = s
    x := b[i]
    b[i] = b[j]
    b[j] = x
    i++
    j--
    n++
  }
  return n
}

describe("indexes known to be in range", fn() {
  it("sort with swaps that skip the repeated checks", fn() {
    a := make([]int, 2000)
    seed := 7
    for k := 0; k < len(a); k++ {
      seed = (seed * 1103515245 + 12345) % 2147483648
      a[k] = seed % 1000
    }
    qsort(a, 0, len(a) - 1)
    ok := true
    for k := 1; k < len(a); k++ { if a[k - 1] > a[k] { ok = false } }
    expect(ok).to_equal(true)
  })
  it("swap texts and bools while the collector runs", fn() {
    a := []str{}
    b := []bool{}
    for k := 0; k < 3001; k++ {
      a = append(a, str(k))
      b = append(b, k % 3 == 0)
    }
    for r := 0; r < 20; r++ { swap_all(a, b) }
    expect(a[0]).to_equal("0" + "!!!!!!!!!!")
    expect(a[1500]).to_equal("1500")
    expect(b[0]).to_equal(true)
    expect(b[1]).to_equal(false)
  })
  it("check again after the index changes", fn() {
    r := run_source("a := []int{1, 2, 3}\ni := 1\nx := a[i]\ni = 3\na[i] = x\n")
    expect(r.output).to_equal("Runtime error in main.caju, line 5: Index 3 out of range (length 3).")
    r2 := run_source("a := []int{1, 2, 3}\ni := 2\nx := a[i]\ni++\nprint(a[i] + x)\n")
    expect(r2.output).to_equal("Runtime error in main.caju, line 5: Index 3 out of range (length 3).")
  })
  it("check again after the list changes", fn() {
    r := run_source("a := []int{1, 2, 3}\ni := 2\nx := a[i]\na = []int{5}\nprint(a[i] + x)\n")
    expect(r.output).to_equal("Runtime error in main.caju, line 5: Index 2 out of range (length 1).")
    r2 := run_source("fn f(a: []int, i: int) -> int {\n  x := a[i]\n  a = a[0:1]\n  a[i] = x\n  return x\n}\nprint(f([]int{1, 2}, 1))\n")
    expect(r2.output).to_equal("Runtime error in main.caju, line 4: Index 1 out of range (length 1).")
  })
  it("learn nothing from a branch that may not run", fn() {
    r := run_source("a := []int{1, 2}\ni := 5\nx := 0\nif len(a) > 9 {\n  x = a[i]\n}\na[i] = x\n")
    expect(r.output).to_equal("Runtime error in main.caju, line 7: Index 5 out of range (length 2).")
    r2 := run_source("a := []int{1, 2}\ni := 5\nif i < 0 and a[i] > 0 {\n  print(1)\n}\nprint(a[i])\n")
    expect(r2.output).to_equal("Runtime error in main.caju, line 6: Index 5 out of range (length 2).")
    r3 := run_source("a := []int{1, 2}\ni := 5\nx := i > 0 or a[i] > 0\nprint(x, a[i])\n")
    expect(r3.output).to_equal("Runtime error in main.caju, line 4: Index 5 out of range (length 2).")
    r4 := run_source("a := []int{1, 2}\ni := 5\nswitch len(a) {\ncase 7:\n  print(a[i])\ncase 2:\n  a[i] = 1\n}\n")
    expect(r4.output).to_equal("Runtime error in main.caju, line 7: Index 5 out of range (length 2).")
  })
  it("keep what the condition learned in both branches of an if", fn() {
    a := []int{4, 5, 6}
    i := 2
    s := 0
    if a[i] > 5 { s = a[i] } else { s = -a[i] }
    a[i] = s + 1
    expect(a[i]).to_equal(7)
  })
  it("check after a loop that may leave through a break", fn() {
    r := run_source("a := []int{1, 2, 3, 4, 5}\ni := 0\nwhile a[i] < 100 {\n  i++\n  if i == 5 { break }\n}\nprint(a[i])\n")
    expect(r.output).to_equal("Runtime error in main.caju, line 7: Index 5 out of range (length 5).")
  })
  it("check after a loop that changes the index in its body", fn() {
    r := run_source("a := []int{1, 2, 3}\ni := 0\nx := a[i]\nfor k := 0; k < 3; k++ {\n  i += k\n}\nprint(a[i] + x)\n")
    expect(r.output).to_equal("Runtime error in main.caju, line 7: Index 3 out of range (length 3).")
    r2 := run_source("a := []int{1, 2, 3}\ni := 0\nx := a[i]\nfor _, v := range a {\n  i = v\n}\nprint(a[i] + x)\n")
    expect(r2.output).to_equal("Runtime error in main.caju, line 7: Index 3 out of range (length 3).")
  })
  it("check in both copies of a loop with a constant bound", fn() {
    r := run_source("a := []int{1, 2}\ni := 0\ns := a[i]\nfor k := 0; k < 3; k++ {\n  s += a[k]\n  i = k\n  s += a[i]\n}\nprint(s)\n")
    expect(r.output).to_equal("Runtime error in main.caju, line 5: Index 2 out of range (length 2).")
    r2 := run_source("a := []int{1, 2, 3}\ni := 0\ns := a[i]\nfor k := 0; k < 3; k++ {\n  s += a[k]\n  i = k + 1\n}\nprint(s, a[i])\n")
    expect(r2.output).to_equal("Runtime error in main.caju, line 8: Index 3 out of range (length 3).")
    b := []int{5, 6, 7}
    j := 1
    t := b[j]
    for k := 0; k < 3; k++ { t += b[k] + b[j] }
    expect(t + b[j]).to_equal(6 + 18 + 18 + 6)
  })
  it("use the facts of a loop's condition after it", fn() {
    a := []int{1, 2, 3, 9, 4}
    i := 0
    while a[i] < 5 { i++ }
    a[i] = a[i] * 2
    expect(a[3]).to_equal(18)
  })
  it("report the value's error first when the target is known", fn() {
    r := run_source("a := []int{1, 2, 3}\ni := 0\nj := 7\nx := a[i]\na[i] = a[j] + x\n")
    expect(r.output).to_equal("Runtime error in main.caju, line 5: Index 7 out of range (length 3).")
  })
  it("check an index changed through a pointer or a closure", fn() {
    r := run_source("a := []int{1, 2, 3}\ni := 0\np := &i\nx := a[i]\n*p = 4\nprint(a[i] + x)\n")
    expect(r.output).to_equal("Runtime error in main.caju, line 6: Index 4 out of range (length 3).")
    r2 := run_source("a := []int{1, 2, 3}\ni := 0\nf := fn() { i = 8 }\nx := a[i]\nf()\nprint(a[i] + x)\n")
    expect(r2.output).to_equal("Runtime error in main.caju, line 6: Index 8 out of range (length 3).")
    r3 := run_source("a := []int{1, 2, 3}\ni := 0\nf := fn() { a = []int{} }\nx := a[i]\nf()\nprint(a[i] + x)\n")
    expect(r3.output).to_equal("Runtime error in main.caju, line 6: Index 0 out of range (length 0).")
  })
  it("assign several targets in order", fn() {
    a := []int{1, 2, 3}
    i := 0
    x := a[i]
    i, a[i] = 2, 9
    expect(a).to_equal([]int{9, 2, 3})
    expect(x + i).to_equal(3)
  })
  it("work with arrays", fn() {
    let a: [4]int
    i := 3
    a[i] = 5
    a[i] = a[i] + 1
    expect(a[3]).to_equal(6)
    r := run_source("let a: [2]int\ni := 1\na[i] = 1\ni = 2\na[i] = 2\n")
    expect(r.output).to_equal("Runtime error in main.caju, line 5: Index 2 out of range (length 2).")
  })
})

describe("top-level variables and the functions' own variables", fn() {
  it("keep the top-level variables separate from same-named locals", fn() {
    src := "fn f(i: int) -> int {\n  a := []int{i, i}\n  return a[0] + a[1]\n}\na := []int{1, 2, 3}\ns := 0\nfor i := 0; i < len(a); i++ { s += f(a[i]) }\nprint(s, a[2])\n"
    r := run_source(src)
    expect(r.output).to_equal("12 3")
  })
  it("share a top-level variable that a function really uses", fn() {
    src := "n := 1\nfn bump() { n++ }\nfn twice(n: int) -> int { return n * 2 }\nbump()\nbump()\nprint(n, twice(10))\n"
    r := run_source(src)
    expect(r.output).to_equal("3 20")
    src2 := "k := 5\nfn g() -> int {\n  f := fn() -> int { return k }\n  return f()\n}\nfn h() -> int {\n  k := 1\n  return k\n}\nk = 6\nprint(g(), h())\n"
    r2 := run_source(src2)
    expect(r2.output).to_equal("6 1")
  })
})

fn junk(k: int) -> str {
  s := ""
  for r := 0; r < 40; r++ { s = s + str(k) }   # garbage: the collector runs now and then
  return s
}

describe("loops with the condition also before the body", fn() {
  it("run zero, one and many turns", fn() {
    n := 0
    i := 5
    while i < 5 { n++ }
    for k := 3; k < 3; k++ { n += 10 }
    while i < 6 { i++ }
    x := 0.5
    while x < 100.0 { x = x * 2.0 }
    for k := 0; k < 1000; k++ { n++ }
    expect(n).to_equal(1000)
    expect(i).to_equal(6)
    expect(x).to_equal(128.0)
  })
  it("report an error of the first evaluation at the loop's line", fn() {
    r := run_source("a := []int{1, 2}\ni := 2\nwhile a[i] < 5 {\n  i++\n}\n")
    expect(r.output).to_equal("Runtime error in main.caju, line 3: Index 2 out of range (length 2).")
    r2 := run_source("a := []int{1, 2}\nn := 0\nfor i := 0; a[i] < 5; i++ {\n  n++\n}\n")
    expect(r2.output).to_equal("Runtime error in main.caju, line 3: Index 2 out of range (length 2).")
  })
})

describe("lists in registers in loops that call functions in branches", fn() {
  it("keep the list alive and right across the calls", fn() {
    a := make([]int, 5000)
    for k := 0; k < len(a); k++ { a[k] = k }
    total := 0
    texts := 0
    for k := 0; k < len(a); k++ {
      if k % 7 == 0 { texts += len(junk(k)) }
      total += a[k]
      if a[k] % 1000 == 999 { a = append(a, 0) }
    }
    i := 0
    while i < len(a) - 1 and a[i] <= a[i + 1] {
      if i % 500 == 0 { texts += len(junk(i)) }
      i++
    }
    expect(total).to_equal(12497500)
    expect(texts > 0).to_equal(true)
    expect(i).to_equal(4999)
  })
})

describe("make", fn() {
  it("gives zeroed lists again after the collector reuses their memory", fn() {
    ok := true
    for r := 0; r < 30; r++ {
      a := make([]int, 100000)
      for k := 0; k < len(a); k += 997 { if a[k] != 0 { ok = false } }
      for k := 0; k < len(a); k++ { a[k] = r + 1 }
      s := make([]str, 3000)
      if s[2999] != "" { ok = false }
      b := make([][2]int, 3000)
      if b[2999][1] != 0 { ok = false }
      b[0][1] = 3
    }
    expect(ok).to_equal(true)
  })
})
