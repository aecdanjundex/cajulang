interface Shape { area() -> num }
interface Named { name() -> str }
interface NamedShape { Shape; Named }
struct Square { side: num }
struct Circle { r: num }
fn (q: Square) area() -> num { return q.side * q.side }
fn (q: Square) name() -> str { return "square" }
fn (c: *Circle) area() -> num { return 3 * c.r * c.r }
fn (c: *Circle) name() -> str { return "circle" }
fn describe(f: NamedShape) { print(f.name(), f.area()) }
describe(Square{2})
describe(&Circle{1})
fn kind(x: any) -> str {
  switch v := x.(type) {
  case int: return "int " + str(v + 1)
  case num: return "num " + str(v)
  case str: return "str " + v
  case int8: return "int8"
  case Square: return "square with side " + str(v.side)
  case *Circle: return "pointer to circle " + str(v.r)
  case []int: return "slice of " + str(len(v))
  case nil: return "nil"
  case error: return "error: " + v.Error()
  default: return "other"
  }
}
print(kind(3))
print(kind(2.5))
print(kind(4.0))
print(kind("hi"))
print(kind(int8(5)))
print(kind(Square{3}))
print(kind(&Circle{7}))
print(kind([]int{1, 2}))
print(kind(nil))
print(kind(errors.New("failed")))
print(kind(true))
let f: Shape = Square{4}
q, ok := f.(Square)
print(q, ok)
c, ok2 := f.(*Circle)
print(c, ok2)
n := f.(Named)
print(n.name())
struct Engine { power: int }
fn (m: Engine) start() -> str { return "vroom " + str(m.power) }
fn (m: *Engine) boost() { m.power *= 2 }
struct Car { Engine; model: str }
car := Car{Engine{100}, "beetle"}
print(car.power, car.start())
car.boost()
print(car.power, car.Engine.power)
interface Startable { start() -> str }
let l: Startable = car
print(l.start())
g := car.start
car.power = 1
print(g())
