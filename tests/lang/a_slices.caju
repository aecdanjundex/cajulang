s := []int{1, 2, 3}
s = append(s, 4, 5)
print(s, len(s), cap(s))
t := s[1:3]
t[0] = 99
print(s, t, len(t), cap(t))
m := map[str]int{"one": 1, "two": 2}
m["three"] = 3
print(m, len(m))
v, ok := m["two"]
print(v, ok)
v, ok = m["zero"]
print(v, ok)
delete(m, "one")
for k, x := range m { print(k, x) }
for i, c := range "café" { print(i, c, string(c)) }
let a: [3]int = [3]int{7, 8}
b := a
b[0] = 100
print(a, b, len(a))
z := make([]str, 2, 5)
z[1] = "x"
print(z, len(z), cap(z))
total := 0
for i := 0; i < 10; i++ {
  if i % 2 == 0 { continue }
  if i > 7 { break }
  total += i
}
print("total", total)
bs := []byte("abc")
print(bs, string(bs), []rune("é!"))
n := copy(z, []str{"p", "q", "r"})
print(n, z)
s := s[:0]
print(s, len(s), cap(s))
grid := [][]int{{1, 2}, {3, 4}}
print(grid, grid[1][0])
for range 3 { print("hi") }
for i := range 3 { print(i) }
