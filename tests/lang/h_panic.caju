fn safe(f: fn()) -> (err: error) {
  defer fn() {
    if r := recover(); r != nil {
      err = errors.New("recovered: " + str(r))
    }
  }()
  f()
  return nil
}
print(safe(fn() { panic("ouch") }))
print(safe(fn() { let a = []int{1, 2}; print(a[5]) }))
print(safe(fn() { x := 0; print(10 / x) }))
print(safe(fn() { let mm: map[str]int = nil; mm["a"] = 1 }))
print(safe(fn() { print("nothing wrong") }))
fn order() {
  for i := 0; i < 3; i++ { defer print("defer", i) }
  print("body")
}
order()
fn pair() -> (int, str) {
  defer fn() { recover() }()
  panic(42)
}
a, b := pair()
print(a, b == "")
