import { describe, it, expect, run_file } from "std/testing"

struct Point { x: int, y: int }

describe("print", fn() {
  it("separates the arguments with spaces, formats each value and runs deferred prints at the end", fn() {
    r := run_file("testdata/printing.caju")
    expect(r.output).to_equal("1 2.5 text true nil\n[1 2] [\"a\" \"b\"] map[\"a\":1 \"b\":2]\nPoint{x: 1, y: 2} Point{x: 3, y: 4} oops\nbody\ndefer 2\ndefer 1\ndefer 0")
    expect(r.code).to_equal(0)
  })
})

describe("str", fn() {
  it("formats numbers with up to 12 significant digits", fn() {
    expect(str(1.5)).to_equal("1.5")
    expect(str(1.0 / 3)).to_equal("0.333333333333")
    expect(str(7.0)).to_equal("7")
  })
  it("quotes texts inside lists and maps but not at the top", fn() {
    expect(str("a")).to_equal("a")
    expect(str([]str{"a"})).to_equal("[\"a\"]")
    expect(str(map[str]str{"k": "v"})).to_equal("map[\"k\":\"v\"]")
  })
  it("shows structs with their field names, also through pointers", fn() {
    expect(str(Point{1, 2})).to_equal("Point{x: 1, y: 2}")
    expect(str(&Point{1, 2})).to_equal("Point{x: 1, y: 2}")
  })
})
