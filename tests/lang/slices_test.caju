import { describe, it, expect } from "std/testing"

describe("slices", fn() {
  it("append adds elements and grows the capacity when it runs out", fn() {
    s := []int{1, 2, 3}
    s = append(s, 4, 5)
    expect(s).to_equal([]int{1, 2, 3, 4, 5})
    expect(len(s)).to_equal(5)
    expect(cap(s)).to_equal(6)
  })
  it("a slice of a slice shares its elements", fn() {
    s := []int{1, 2, 3, 4, 5}
    s = append(s[0:3], 4, 5)
    t := s[1:3]
    t[0] = 99
    expect(s).to_equal([]int{1, 99, 3, 4, 5})
    expect(t).to_equal([]int{99, 3})
    expect(len(t)).to_equal(2)
  })
  it("slicing keeps the capacity up to the end of the array", fn() {
    s := []int{1, 2, 3}
    s = append(s, 4, 5)
    t := s[1:3]
    expect(cap(t)).to_equal(5)
    e := s[:0]
    expect(e).to_equal([]int{})
    expect(len(e)).to_equal(0)
    expect(cap(e)).to_equal(6)
  })
  it("middle slices change the original (grades example)", fn() {
    grades := []int{7, 9, 4}
    grades = append(grades, 10, 6)
    expect(grades).to_equal([]int{7, 9, 4, 10, 6})
    expect(cap(grades)).to_equal(6)
    middle := grades[1:3]
    middle[0] = 99
    expect(grades).to_equal([]int{7, 99, 4, 10, 6})
    expect(middle).to_equal([]int{99, 4})
    sum := 0
    for _, n := range grades { sum += n }
    expect(sum / len(grades)).to_equal(25)
    expect(float64(sum) / float64(len(grades))).to_equal(25.2)
  })
  it("make creates a slice with length and capacity", fn() {
    z := make([]str, 2, 5)
    z[1] = "x"
    expect(z).to_equal([]str{"", "x"})
    expect(len(z)).to_equal(2)
    expect(cap(z)).to_equal(5)
  })
  it("copy copies as many elements as fit and returns how many", fn() {
    z := make([]str, 2, 5)
    n := copy(z, []str{"p", "q", "r"})
    expect(n).to_equal(2)
    expect(z).to_equal([]str{"p", "q"})
    s := []int{1, 2, 3}
    m := copy(s, []int{9, 9})
    expect(m).to_equal(2)
    expect(s).to_equal([]int{9, 9, 3})
  })
  it("two appends to the same short slice share the array", fn() {
    s := make([]int, 0, 2)
    t := append(s, 1)
    u := append(s, 2)
    expect(t).to_equal([]int{2})
    expect(u).to_equal([]int{2})
    expect(len(s)).to_equal(0)
    expect(cap(s)).to_equal(2)
    s = append(s, 1, 2, 3)
    expect(s).to_equal([]int{1, 2, 3})
    expect(cap(s)).to_equal(4)
  })
  it("slices of slices make a matrix", fn() {
    grid := [][]int{{1, 2}, {3, 4}}
    expect(grid).to_equal([][]int{{1, 2}, {3, 4}})
    expect(grid[1][0]).to_equal(3)
    tab := make([][]int, 3)
    for i := range tab {
      tab[i] = make([]int, 3)
      for j := range tab[i] { tab[i][j] = (i + 1) * (j + 1) }
    }
    expect(tab).to_equal([][]int{{1, 2, 3}, {2, 4, 6}, {3, 6, 9}})
  })
})

describe("arrays", fn() {
  it("are copied on assignment and padded with zeros", fn() {
    let a: [3]int = [3]int{7, 8}
    b := a
    b[0] = 100
    expect(a).to_equal([3]int{7, 8, 0})
    expect(b).to_equal([3]int{100, 8, 0})
    expect(len(a)).to_equal(3)
  })
  it("of texts are copied too", fn() {
    a := [3]str{"x", "y", "z"}
    b := a
    b[0] = "changed"
    expect(a).to_equal([3]str{"x", "y", "z"})
    expect(b).to_equal([3]str{"changed", "y", "z"})
  })
  it("compare by their elements", fn() {
    arr := [3]int{1, 2, 3}
    arr2 := arr
    arr2[0] = 99
    expect(arr2).to_equal([3]int{99, 2, 3})
    expect(arr == [3]int{1, 2, 3}).to_be_true()
  })
  it("a slice of an array writes into the array", fn() {
    arr := [3]int{1, 2, 3}
    fs := arr[1:]
    fs[0] = 7
    expect(arr).to_equal([3]int{1, 7, 3})
    expect(fs).to_equal([]int{7, 3})
    expect(cap(fs)).to_equal(2)
  })
})
