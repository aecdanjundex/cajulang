# Reading m[k] is a single runtime call (rt_map_get), with a fast path for integer keys
# (rt/values.caju); these tests check the zero values and the keys it must still tell apart.
import { describe, it, expect } from "std/testing"

struct Point { x: int, y: int }

describe("reading a map", fn() {
  it("gives the zero value of the value type when the key is missing", fn() {
    ms := map[str]str{"a": "x"}
    mp := map[str]Point{}
    mn := map[int]num{}
    ml := map[int][]int{}
    ma := map[str]any{}
    expect(ms["b"]).to_equal("")
    expect(mp["none"]).to_equal(Point{0, 0})
    expect(mn[3]).to_equal(0)
    expect(ml[1]).to_be_nil()
    expect(ma["z"]).to_be_nil()
  })
  it("tells a missing key from a zero value with v, ok", fn() {
    m := map[int]int{0: 0, 5: 50}
    v1, ok1 := m[0]
    v2, ok2 := m[7]
    v3, ok3 := m[5]
    expect([]any{v1, ok1, v2, ok2, v3, ok3}).to_equal([]any{0, true, 0, false, 50, true})
  })
  it("finds negative and large integer keys", fn() {
    m := map[int]str{}
    m[-1] = "minus one"
    m[1 << 40] = "big"
    m[0] = "zero"
    expect(m[-1] + "," + m[1 << 40] + "," + m[0]).to_equal("minus one,big,zero")
  })
  it("treats 0.0 and -0.0 as the same num key", fn() {
    m := map[num]int{}
    m[0.0] = 1
    m[-0.0] += 1
    expect(len(m)).to_equal(1)
    expect(m[0.0]).to_equal(2)
  })
  it("keeps every key after the index grows many times", fn() {
    m := map[int]int{}
    for i := 0; i < 50000; i++ { m[i * 7] = i }
    bad := 0
    for i := 0; i < 50000; i++ { if m[i * 7] != i { bad++ } }
    _, missing := m[1]
    expect(bad).to_equal(0)
    expect(missing).to_be_false()
    expect(len(m)).to_equal(50000)
  })
  it("reads struct values from maps by key", fn() {
    m := map[str]Point{"a": Point{1, 2}}
    p := m["a"]
    p.x = 9
    expect(m["a"].x).to_equal(1)
  })
})
