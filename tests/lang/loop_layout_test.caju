# The native compiler lays out loops with the condition after the body (one jump per turn),
# moves the runtime error calls to the end of the function (cold code), returns right where
# `return` is, and shortens or removes jumps when it writes the code. None of this may change
# what a program does or which error (and line) it reports.
import { describe, it, expect, run_source } from "std/testing"

let calls: int = 0
fn next_below(n: int) -> bool {
  calls++
  return calls <= n
}

fn first_even(xs: []int) -> int {
  for i := 0; i < len(xs); i++ {
    if xs[i] % 2 == 0 { return xs[i] }
  }
  return -1
}

fn classify_n(x: int) -> str {
  if x < 0 { return "negative" }
  if x == 0 { return "zero" }
  while x > 100 {
    if x > 1000 { return "huge" }
    x = x / 2
  }
  return "positive"
}

fn safe_div(a: int, b: int) -> int {
  defer fn() { recover() }()
  return a / b
}

describe("rotated loops", fn() {
  it("skip the body when the condition starts false", fn() {
    n := 0
    for i := 5; i < 5; i++ { n++ }
    i := 10
    while i < 3 { n++ }
    for _, x := range []int{} { n += x }
    for k, v := range map[str]int{} { n += len(k) + v }
    for _, c := range "" { n += int(c) }
    expect(n).to_equal(0)
  })
  it("run empty bodies", fn() {
    i := 0
    for i = 0; i < 10; i++ {}
    j := 0
    while j < 7 { j++ }
    expect(i).to_equal(10)
    expect(j).to_equal(7)
  })
  it("break and continue in for, while and range", fn() {
    s := 0
    for i := 0; i < 10; i++ {
      if i == 2 { continue }
      if i == 6 { break }
      s += i
    }
    expect(s).to_equal(13)
    w := 0
    k := 0
    while k < 10 {
      k++
      if k % 3 == 0 { continue }
      if k > 8 { break }
      w += k
    }
    expect(w).to_equal(27)
    r := 0
    for i, x := range []int{4, 5, 6, 7, 8} {
      if x == 5 { continue }
      if i == 3 { break }
      r += x
    }
    expect(r).to_equal(10)
    t := ""
    for _, c := range "abcdef" {
      if c == 'b' { continue }
      if c == 'e' { break }
      t += str(int(c) - 97)
    }
    expect(t).to_equal("023")
  })
  it("break and continue with labels", fn() {
    s := 0
    outer: for i := 0; i < 5; i++ {
      j := 0
      inner: while j < 5 {
        j++
        if j == 2 { continue inner }
        if j == i { continue outer }
        if i == 4 { break outer }
        s += i * 10 + j
      }
    }
    expect(s).to_equal(137)
    n := 0
    rows: for _, row := range [][]int{[]int{1, 2}, []int{3, -1, 5}, []int{6}} {
      for _, x := range row {
        if x < 0 { continue rows }
        n += x
      }
    }
    expect(n).to_equal(12)
  })
  it("evaluate a condition with side effects once per turn", fn() {
    calls = 0
    turns := 0
    while next_below(4) { turns++ }
    expect(turns).to_equal(4)
    expect(calls).to_equal(5)
    calls = 0
    m := 0
    for ; next_below(3); { m++ }
    expect(m).to_equal(3)
    expect(calls).to_equal(4)
  })
  it("stop on conditions with and, or and not", fn() {
    a := []int{3, 1, 4, 1, 5, 9, 2, 6}
    i := 0
    while i < len(a) && a[i] != 9 { i++ }
    expect(i).to_equal(5)
    j := 0
    while !(j >= 3 || a[j] == 4) { j++ }
    expect(j).to_equal(2)
    x := 0.0
    while x < 1.0 { x += 0.25 }
    expect(x).to_equal(1.0)
  })
  it("return from inside loops", fn() {
    expect(first_even([]int{1, 3, 8, 5})).to_equal(8)
    expect(first_even([]int{1, 3})).to_equal(-1)
    expect(classify_n(-3)).to_equal("negative")
    expect(classify_n(0)).to_equal("zero")
    expect(classify_n(500)).to_equal("positive")
    expect(classify_n(5000)).to_equal("huge")
  })
  it("give each turn its own captured loop variable", fn() {
    fs := []fn() -> int{}
    for i := 0; i < 3; i++ { fs = append(fs, fn() -> int { return i }) }
    expect(fs[0]() + fs[1]() * 10 + fs[2]() * 100).to_equal(210)
  })
  it("loop forever until a break", fn() {
    n := 0
    while true {
      n++
      if n == 4 { break }
    }
    for {
      n++
      if n == 9 { break }
    }
    expect(n).to_equal(9)
  })
})

describe("runtime errors in cold code", fn() {
  it("report an index error inside a loop at its line", fn() {
    r := run_source("a := []int{1, 2, 3}\ns := 0\ni := 0\nwhile i < 5 {\n  s += a[i]\n  i++\n}\n")
    expect(r.output).to_equal("Runtime error in main.caju, line 5: Index 3 out of range (length 3).")
  })
  it("report an error in the condition of a rotated loop at its line", fn() {
    r := run_source("a := []int{1, 2}\ni := 0\nfor i = 0; a[i] > 0; i++ {\n  print(i)\n}\n")
    expect(r.output).to_equal("0\n1\nRuntime error in main.caju, line 3: Index 2 out of range (length 2).")
  })
  it("report a division by zero in a loop of a function", fn() {
    r := run_source("fn f(n: int) -> int {\n  s := 0\n  for i := 3; i >= 0; i-- {\n    s += 12 / i\n  }\n  return s\n}\nprint(f(3))\n")
    expect(r.output).to_equal("Runtime error in main.caju, line 4: Integer division by zero.")
  })
  it("report a nil pointer inside a range loop", fn() {
    r := run_source("struct P { x: int }\nps := []*P{&P{x: 1}, nil}\ns := 0\nfor _, p := range ps {\n  s += p.x\n}\n")
    expect(r.output).to_equal("Runtime error in main.caju, line 5: Access to field \"x\" through a nil pointer.")
  })
  it("report too much recursion", fn() {
    r := run_source("fn down(n: int) -> int {\n  if n == 0 { return 0 }\n  return down(n - 1) + 1\n}\nprint(down(20000))\n")
    expect(r.output).to_equal("Runtime error in main.caju, line 3: Too much recursion: more than 10,000 nested function calls.")
  })
  it("recover from an error raised in cold code", fn() {
    expect(safe_div(7, 0)).to_equal(0)
    expect(safe_div(7, 2)).to_equal(3)
  })
})
