struct Node { v: int, next: *Node }
let list: *Node = nil
for i := 0; i < 300000; i++ {
  list = &Node{v: i, next: list}
  if i % 1000 == 0 { list = nil }
}
m := map[int]str{}
for i := 0; i < 50000; i++ {
  m[i] = "v" + str(i)
  if i % 3 == 0 { delete(m, i / 2) }
}
print(len(m), m[49999], m[10])
fs := []fn() -> int{}
for i := 0; i < 1000; i++ { fs = append(fs, fn() -> int { return i * i }) }
s := 0
for _, f := range fs { s += f() }
print(s)
txt := ""
for i := 0; i < 2000; i++ { txt = txt + "ab" }
print(len(txt))
mat := [][]int{}
for i := 0; i < 300; i++ {
  row := make([]int, 300)
  for j := range row { row[j] = i * j }
  mat = append(mat, row)
}
print(mat[299][299], len(mat))
