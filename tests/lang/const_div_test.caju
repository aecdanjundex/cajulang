  return bad
}

fn q_uint8_0(x: uint8) -> uint8 { return x / 1 }
fn r_uint8_0(x: uint8) -> uint8 { return x % 1 }
fn qa_uint8_0(x: uint8) -> uint8 {
  y := x
  y /= 1
  return y
}
fn ra_uint8_0(x: uint8) -> uint8 {
  a := []uint8{x, x}
  a[1] %= 1
  a[0] /= 1
  return a[0] * 3 + a[1]
}
fn q_uint8_1(x: uint8) -> uint8 { return x / 2 }
fn r_uint8_1(x: uint8) -> uint8 { return x % 2 }
fn qa_uint8_1(x: uint8) -> uint8 {
  y := x
  y /= 2
  return y
}
fn ra_uint8_1(x: uint8) -> uint8 {
  a := []uint8{x, x}
  a[1] %= 2
  a[0] /= 2
  return a[0] * 3 + a[1]
}
fn q_uint8_2(x: uint8) -> uint8 { return x / 3 }
fn r_uint8_2(x: uint8) -> uint8 { return x % 3 }
fn qa_uint8_2(x: uint8) -> uint8 {
  y := x
  y /= 3
  return y
}
fn ra_uint8_2(x: uint8) -> uint8 {
  a := []uint8{x, x}
  a[1] %= 3
  a[0] /= 3
  return a[0] * 3 + a[1]
}
fn q_uint8_3(x: uint8) -> uint8 { return x / 7 }
fn r_uint8_3(x: uint8) -> uint8 { return x % 7 }
fn qa_uint8_3(x: uint8) -> uint8 {
  y := x
  y /= 7
  return y
}
fn ra_uint8_3(x: uint8) -> uint8 {
  a := []uint8{x, x}
  a[1] %= 7
  a[0] /= 7
  return a[0] * 3 + a[1]
}
fn q_uint8_4(x: uint8) -> uint8 { return x / 10 }
fn r_uint8_4(x: uint8) -> uint8 { return x % 10 }
fn qa_uint8_4(x: uint8) -> uint8 {
  y := x
  y /= 10
  return y
}
fn ra_uint8_4(x: uint8) -> uint8 {
  a := []uint8{x, x}
  a[1] %= 10
  a[0] /= 10
  return a[0] * 3 + a[1]
}
fn q_uint8_5(x: uint8) -> uint8 { return x / 16 }
fn r_uint8_5(x: uint8) -> uint8 { return x % 16 }
fn qa_uint8_5(x: uint8) -> uint8 {
  y := x
  y /= 16
  return y
}
fn ra_uint8_5(x: uint8) -> uint8 {
  a := []uint8{x, x}
  a[1] %= 16
  a[0] /= 16
  return a[0] * 3 + a[1]
}
fn q_uint8_6(x: uint8) -> uint8 { return x / 128 }
fn r_uint8_6(x: uint8) -> uint8 { return x % 128 }
fn qa_uint8_6(x: uint8) -> uint8 {
  y := x
  y /= 128
  return y
}
fn ra_uint8_6(x: uint8) -> uint8 {
  a := []uint8{x, x}
  a[1] %= 128
  a[0] /= 128
  return a[0] * 3 + a[1]
}
fn q_uint8_7(x: uint8) -> uint8 { return x / 255 }
fn r_uint8_7(x: uint8) -> uint8 { return x % 255 }
fn qa_uint8_7(x: uint8) -> uint8 {
  y := x
  y /= 255
  return y
}
fn ra_uint8_7(x: uint8) -> uint8 {
  a := []uint8{x, x}
  a[1] %= 255
  a[0] /= 255
  return a[0] * 3 + a[1]
}
fn check_uint8() -> []str {
  ds := []uint8{1, 2, 3, 7, 10, 16, 128, 255}
  bad := []str{}
  for _, v := range values() {
    x := uint8(v)
    if q_uint8_0(x) != x / ds[0] || r_uint8_0(x) != x % ds[0] || qa_uint8_0(x) != x / ds[0] || ra_uint8_0(x) != (x / ds[0]) * 3 + x % ds[0] { bad = append(bad, str(x) + " by " + str(ds[0])) }
    if q_uint8_1(x) != x / ds[1] || r_uint8_1(x) != x % ds[1] || qa_uint8_1(x) != x / ds[1] || ra_uint8_1(x) != (x / ds[1]) * 3 + x % ds[1] { bad = append(bad, str(x) + " by " + str(ds[1])) }
    if q_uint8_2(x) != x / ds[2] || r_uint8_2(x) != x % ds[2] || qa_uint8_2(x) != x / ds[2] || ra_uint8_2(x) != (x / ds[2]) * 3 + x % ds[2] { bad = append(bad, str(x) + " by " + str(ds[2])) }
    if q_uint8_3(x) != x / ds[3] || r_uint8_3(x) != x % ds[3] || qa_uint8_3(x) != x / ds[3] || ra_uint8_3(x) != (x / ds[3]) * 3 + x % ds[3] { bad = append(bad, str(x) + " by " + str(ds[3])) }
    if q_uint8_4(x) != x / ds[4] || r_uint8_4(x) != x % ds[4] || qa_uint8_4(x) != x / ds[4] || ra_uint8_4(x) != (x / ds[4]) * 3 + x % ds[4] { bad = append(bad, str(x) + " by " + str(ds[4])) }
    if q_uint8_5(x) != x / ds[5] || r_uint8_5(x) != x % ds[5] || qa_uint8_5(x) != x / ds[5] || ra_uint8_5(x) != (x / ds[5]) * 3 + x % ds[5] { bad = append(bad, str(x) + " by " + str(ds[5])) }
    if q_uint8_6(x) != x / ds[6] || r_uint8_6(x) != x % ds[6] || qa_uint8_6(x) != x / ds[6] || ra_uint8_6(x) != (x / ds[6]) * 3 + x % ds[6] { bad = append(bad, str(x) + " by " + str(ds[6])) }
    if q_uint8_7(x) != x / ds[7] || r_uint8_7(x) != x % ds[7] || qa_uint8_7(x) != x / ds[7] || ra_uint8_7(x) != (x / ds[7]) * 3 + x % ds[7] { bad = append(bad, str(x) + " by " + str(ds[7])) }
  }
  return bad
}

describe("integer division by a constant", fn() {
  it("matches the general division for int", fn() { expect(check_int()).to_equal([]str{}) })
  it("matches the general division for int64", fn() { expect(check_int64()).to_equal([]str{}) })
  it("matches the general division for int32", fn() { expect(check_int32()).to_equal([]str{}) })
  it("matches the general division for int16", fn() { expect(check_int16()).to_equal([]str{}) })
  it("matches the general division for int8", fn() { expect(check_int8()).to_equal([]str{}) })
  it("matches the general division for uint", fn() { expect(check_uint()).to_equal([]str{}) })
  it("matches the general division for uint64", fn() { expect(check_uint64()).to_equal([]str{}) })
  it("matches the general division for uint32", fn() { expect(check_uint32()).to_equal([]str{}) })
  it("matches the general division for uint16", fn() { expect(check_uint16()).to_equal([]str{}) })
  it("matches the general division for uint8", fn() { expect(check_uint8()).to_equal([]str{}) })
  it("rounds toward zero and keeps the sign of the dividend in the remainder", fn() {
    x := -7
    expect([]int{x / 2, x % 2, x / -2, x % -2, x / 4, x % 4, x / 3, x % 3, x / -3, x % -3}).to_equal([]int{-3, -1, 3, -1, -1, -3, -2, -1, 2, -1})
    y := 7
    expect([]int{y / 2, y % 2, y / -2, y % -2, y / 3, y % 3, y / -3, y % -3, y / -1, y % -1}).to_equal([]int{3, 1, -3, 1, 2, 1, -2, 1, -7, 0})
  })
  it("wraps the minimum divided by -1 and keeps small kinds in range", fn() {
    m := 1 << 63
    expect(m / -1 == m).to_equal(true)
    expect(m % -1).to_equal(0)
    expect(m / 1 == m).to_equal(true)
    let b: int8 = -128
    expect(int(b / 1)).to_equal(-128)
    let u: uint8 = 255
    expect(int(u / 2)).to_equal(127)
    expect(int(u % 16)).to_equal(15)
  })
  it("still reports a division by a literal zero at run time", fn() {
    r := run_source("x := 5\nprint(x / 0)\n")
    expect(r.output).to_equal("Runtime error in main.caju, line 2: Integer division by zero.")
    r2 := run_source("x := 5\nx %= 0\n")
    expect(r2.output).to_equal("Runtime error in main.caju, line 2: Remainder of integer division by zero.")
    r3 := run_source("a := []int{1}\na[0] /= 0\n")
    expect(r3.output).to_equal("Runtime error in main.caju, line 2: Integer division by zero.")
  })
})
