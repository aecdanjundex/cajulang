# Integer division and remainder by a constant: the native compiler replaces the check and the
# idiv by shifts or a multiplication by a magic number (const_div). Every result must match the
# same operation with the divisor in a variable (the general path), for every integer kind.
# Generated; the divisors cover 1, -1, powers of two, magic numbers with and without the extra add.
import { describe, it, expect, run_source } from "std/testing"

# test values: small numbers, powers of two and their neighbours, the extremes, pseudo-random
fn values() -> []int {
  v := []int{}
  for i := -300; i <= 300; i++ { v = append(v, i) }
  for k := 1; k < 64; k++ {
    p := 1 << k
    v = append(v, p - 1, p, p + 1, -p + 1, -p, -p - 1)
  }
  m := 1 << 63
  v = append(v, m, m + 1, m + 2, m - 1, m - 2, 1000000007, -1000000007, 999999999999, -999999999999)
  x := 88172645463325252
  for i := 0; i < 3000; i++ {
    x = x ^ (x << 13)
    x = x ^ ((x >> 7) & ((1 << 57) - 1))
    x = x ^ (x << 17)
    v = append(v, x, x >> (i % 64))
  }
  return v
}

fn q_int_0(x: int) -> int { return x / 1 }
fn r_int_0(x: int) -> int { return x % 1 }
fn qa_int_0(x: int) -> int {
  y := x
  y /= 1
  return y
}
fn ra_int_0(x: int) -> int {
  a := []int{x, x}
  a[1] %= 1
  a[0] /= 1
  return a[0] * 3 + a[1]
}
