fn check_int() -> []str {
  ds := []int{1, -1, 2, -2, 3, -3, 5, -5, 6, 7, -7, 10, -10, 16, -16, 25, 60, 100, 125, 641, 1000, -1000, 1000000007, 2147483647, 2147483648, -2147483648, 4294967296, 1099511627775, 1099511627776, -1099511627776, 6700417, 9007199254740991, 4503599627370496}
  bad := []str{}
  for _, v := range values() {
    x := int(v)
    if q_int_0(x) != x / ds[0] || r_int_0(x) != x % ds[0] || qa_int_0(x) != x / ds[0] || ra_int_0(x) != (x / ds[0]) * 3 + x % ds[0] { bad = append(bad, str(x) + " by " + str(ds[0])) }
    if q_int_1(x) != x / ds[1] || r_int_1(x) != x % ds[1] || qa_int_1(x) != x / ds[1] || ra_int_1(x) != (x / ds[1]) * 3 + x % ds[1] { bad = append(bad, str(x) + " by " + str(ds[1])) }
    if q_int_2(x) != x / ds[2] || r_int_2(x) != x % ds[2] || qa_int_2(x) != x / ds[2] || ra_int_2(x) != (x / ds[2]) * 3 + x % ds[2] { bad = append(bad, str(x) + " by " + str(ds[2])) }
    if q_int_3(x) != x / ds[3] || r_int_3(x) != x % ds[3] || qa_int_3(x) != x / ds[3] || ra_int_3(x) != (x / ds[3]) * 3 + x % ds[3] { bad = append(bad, str(x) + " by " + str(ds[3])) }
    if q_int_4(x) != x / ds[4] || r_int_4(x) != x % ds[4] || qa_int_4(x) != x / ds[4] || ra_int_4(x) != (x / ds[4]) * 3 + x % ds[4] { bad = append(bad, str(x) + " by " + str(ds[4])) }
    if q_int_5(x) != x / ds[5] || r_int_5(x) != x % ds[5] || qa_int_5(x) != x / ds[5] || ra_int_5(x) != (x / ds[5]) * 3 + x % ds[5] { bad = append(bad, str(x) + " by " + str(ds[5])) }
    if q_int_6(x) != x / ds[6] || r_int_6(x) != x % ds[6] || qa_int_6(x) != x / ds[6] || ra_int_6(x) != (x / ds[6]) * 3 + x % ds[6] { bad = append(bad, str(x) + " by " + str(ds[6])) }
    if q_int_7(x) != x / ds[7] || r_int_7(x) != x % ds[7] || qa_int_7(x) != x / ds[7] || ra_int_7(x) != (x / ds[7]) * 3 + x % ds[7] { bad = append(bad, str(x) + " by " + str(ds[7])) }
