import { describe, it, expect } from "std/testing"

fn classify(n: int) -> str {
  switch {
  case n < 0: return "negative"
  case n == 0: return "zero"
  case n < 10: return "small"
  default: return "large"
  }
}

describe("switch", fn() {
  it("without a value works as a chain of ifs", fn() {
    expect([]str{classify(-1), classify(0), classify(5), classify(50)}).to_equal([]str{"negative", "zero", "small", "large"})
  })
  it("accepts several values per case, and fallthrough enters the next case", fn() {
    log := []str{}
    for i := 0; i < 4; i++ {
      switch i {
      case 0, 1:
        log = append(log, str(i) + " zero or one")
      case 2:
        log = append(log, str(i) + " two")
        fallthrough
      case 3:
        log = append(log, str(i) + " three")
      }
    }
    expect(log).to_equal([]str{"0 zero or one", "1 zero or one", "2 two", "2 three", "3 three"})
  })
})

describe("loops", fn() {
  it("continue and break inside a for", fn() {
    total := 0
    for i := 0; i < 10; i++ {
      if i % 2 == 0 { continue }
      if i > 7 { break }
      total += i
    }
    expect(total).to_equal(16)
  })
  it("labels let continue and break leave an outer loop", fn() {
    pairs := []str{}
    outer:
    for i := 0; i < 3; i++ {
      for j := 0; j < 3; j++ {
        if j == 2 { continue outer }
        if i == 2 { break outer }
        pairs = append(pairs, str(i) + str(j))
      }
    }
    expect(pairs).to_equal([]str{"00", "01", "10", "11"})
  })
  it("range over a number counts from 0", fn() {
    n := 0
    for range 3 { n++ }
    expect(n).to_equal(3)
    got := []int{}
    for i := range 3 { got = append(got, i) }
    expect(got).to_equal([]int{0, 1, 2})
  })
  it("for i = a to b includes both ends", fn() {
    let t = 0
    for i = 1 to 4 { t = t + i }
    expect(t).to_equal(10)
  })
  it("while repeats while the condition holds", fn() {
    n := 1
    while n < 100 { n *= 3 }
    expect(n).to_equal(243)
  })
})

describe("multiple assignment", fn() {
  it("swaps values", fn() {
    a, b := 1, 2
    a, b = b, a
    expect([]int{a, b}).to_equal([]int{2, 1})
  })
})
