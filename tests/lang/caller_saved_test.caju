# Besides RBX, R12, R13, R14, the native compiler keeps variables in the caller-saved registers
# RSI, RDI, R8..R11: every call stores them in the frame before and reloads them after. Lists
# indexed by a loop without calls keep their length and data pointer in those registers too.
# Values must survive calls, recursion, closures, panics and the garbage collector.
import { describe, it, expect, run_source } from "std/testing"

fn add3(a: int, b: int, c: int) -> int { return a + b + c }

fn many_ints(n: int) -> int {
  a := 1
  b := 2
  c := 3
  d := 4
  e := 5
  f := 6
  g := 7
  h := 8
  k := 9
  m := 10
  s := 0
  for i := 0; i < n; i++ {
    a = a + 1
    b = b + a
    c = add3(a, b, c) % 1000
    d = d + c
    e = e ^ d
    f = f + e % 7
    g = add3(g, f, 1) % 997
    h = h + g
    k = k * 3 % 1009
    m = m + k
    s = s + a + b + c + d + e + f + g + h + k + m
  }
  return s
}

fn many_nums(n: int) -> num {
  x := 0.5
  y := 1.5
  z := 2.5
  u := 3.5
  v := 4.5
  w := 5.5
  t := 0.0
  for i := 0; i < n; i++ {
    t = x * y - z + u / v + w
    x = y + 0.25
    y = num(add3(i, 1, 2)) * 0.5
    z = u - 1.0
    u = v + x
    v = w * 0.5
    w = t * 0.125
  }
  return x + y + z + u + v + w + t
}

# a loop without calls: the num variables take the caller-saved registers; calls around it
fn nums_loop(n: int) -> num {
  cr := num(add3(n, 0, 0)) * 0.01
  ci := num(add3(0, n, 1)) * 0.02
  zr := 0.0
  zi := 0.0
  a := 0.0
  b := 0.0
  i := 0
  while i < 40 && zr * zr + zi * zi <= 4.0 {
    t := zr * zr - zi * zi + cr
    zi = 2.0 * zr * zi + ci
    zr = t
    a = a + zr
    b = b - zi
    i++
  }
  return num(add3(i, 0, 0)) + zr + zi + a + b + cr + ci
}

fn qsort(a: []int, lo: int, hi: int) {
  while lo < hi {
    p := a[(lo + hi) / 2]
    i := lo
    j := hi
    while i <= j {
      while a[i] < p { i++ }
      while a[j] > p { j-- }
      if i <= j {
        t := a[i]
        a[i] = a[j]
        a[j] = t
        i++
        j--
      }
    }
    if j - lo < hi - i {
      qsort(a, lo, j)
      lo = i
    } else {
      qsort(a, i, hi)
      hi = j
    }
  }
}

# recursion with many values live across the recursive call
fn deep(n: int, a: int, b: int, c: int, d: int, e: int, f: int) -> int {
  if n == 0 { return a + b + c + d + e + f }
  x := a + 1
  y := b + 2
  z := c + 3
  w := d + 4
  r := deep(n - 1, x, y, z, w, e, f)
  return r + x + y + z + w + e + f
}

fn boom(x: int) -> int {
  if x == 3 { panic("boom") }
  return x * 2
}

fn safe_boom(x: int) -> int {
  defer fn() { recover() }()
  return boom(x)
}

struct Acc { total: int }
fn (a: *Acc) add(x: int) -> int {
  a.total += x
  return a.total
}

describe("variables in caller-saved registers", fn() {
  it("keep ten live integers across calls inside a loop", fn() {
    expect(many_ints(50)).to_equal(2057700)
    expect(many_ints(0)).to_equal(0)
    expect(many_ints(3)).to_equal(1509)
  })
  it("keep num variables across calls", fn() {
    expect(int(many_nums(10) * 1000.0)).to_equal(62244)
  })
  it("keep num variables of a loop without calls", fn() {
    s := 0.0
    for n := 0; n < 30; n++ { s += nums_loop(n) }
    expect(int(s * 1000.0)).to_equal(861734)
  })
  it("sort with recursion and lists kept in registers", fn() {
    a := make([]int, 2000)
    seed := 7
    for i := 0; i < len(a); i++ {
      seed = (seed * 1103515245 + 12345) % 2147483648
      a[i] = seed % 1000
    }
    qsort(a, 0, len(a) - 1)
    ok := true
    for i := 1; i < len(a); i++ { if a[i - 1] > a[i] { ok = false } }
    expect(ok).to_equal(true)
  })
  it("keep values live across a recursive call", fn() {
    expect(deep(0, 1, 2, 3, 4, 5, 6)).to_equal(21)
    expect(deep(3, 1, 2, 3, 4, 5, 6)).to_equal(174)
  })
  it("keep values across closures and method calls", fn() {
    k := 3
    mul := fn(x: int) -> int { return x * k }
    acc := &Acc{total: 0}
    adder := acc.add
    a := 1
    b := 2
    c := 3
    d := 4
    e := 5
    f := 6
    g := 0
    for i := 0; i < 10; i++ {
      g = g + mul(i) + a + b + c + d + e + f
      g = g + adder(1)
      for q := 0; q < 3; q++ {
        a = a + q
        b = (b + a) % 10007
        c = c ^ b
        d = (d + c) % 10009
        e = e + d % 3
        f = f + e % 5
      }
      a++
      b += 2
      c += 3
      d--
      e = e * 1
      f = f + a
    }
    expect(g).to_equal(17307)
    expect(acc.total).to_equal(10)
  })
  it("keep values across a recovered panic", fn() {
    a := 10
    b := 20
    c := 30
    d := 40
    e := 50
    f := 60
    s := 0
    for i := 0; i < 6; i++ {
      s = s + safe_boom(i) + a + b + c + d + e + f
      for q := 0; q < 3; q++ {
        a = a + q
        b = (b + a) % 10007
        c = c ^ b
        d = (d + c) % 10009
        e = e + d % 3
        f = f + e % 5
      }
      a++
      f--
    }
    expect(s).to_equal(5595)
    expect(a + f).to_equal(122)
  })
  it("keep a list alive while the loop allocates", fn() {
    a := make([]int, 1000)
    for i := 0; i < len(a); i++ { a[i] = i }
    total := 0
    n := 0
    for r := 0; r < 300; r++ {
      for i := 0; i < len(a); i++ {
        t := str(a[i])
        n += len(t)
        total += a[i]
      }
      # a garbage list per round
      b := make([]int, 2000)
      b[0] = r
      total += b[0]
    }
    expect(n).to_equal(300 * 2890)
    expect(total).to_equal(300 * 499500 + 44850)
    s := 0
    for i := 0; i < len(a); i++ { s += a[i] }
    expect(s).to_equal(499500)
  })
  it("keep a list in registers while the loop boxes values (the collector runs)", fn() {
    expect(box_loop()).to_equal(999499500)
  })
  it("keep inner loop copies of outer lists across break and continue", fn() {
    a := []int{5, 1, 4, 2, 3}
    b := []int{10, 20, 30, 40, 50}
    s := 0
    outer: for i := 0; i < len(a); i++ {
      j := 0
      while j < len(b) {
        if b[j] > a[i] * 10 { continue outer }
        if a[i] == 2 && j == 1 { break outer }
        s += a[i] * b[j]
        j++
      }
      s += print_free(a[i])
    }
    expect(s).to_equal(1185)
  })
  it("run the same in the top-level code", fn() {
    src := "a := make([]int, 500)\nfor i := 0; i < len(a); i++ { a[i] = (i * 37) % 101 }\nx := 0\ny := 1\nz := 2\nw := 3\nv := 4\nu := 5\nfor r := 0; r < 50; r++ {\n  for i := 0; i < len(a); i++ {\n    x += a[i]\n    y = (y + a[i] * 3) % 1000\n    z = z ^ a[i]\n    w = w + 1\n    v = (v * 7 + a[i]) % 9973\n    u = u + z % 5\n  }\n  s := str(r) + \"!\"\n  x += len(s)\n}\nprint(x, y, z, w, v, u)\n"
    r := run_source(src)
    expect(r.code).to_equal(0)
    expect(r.output).to_equal("1249990 551 2 25003 8675 51180")
  })
  it("report an index error from a list kept in a register", fn() {
    r := run_source("a := []int{1, 2, 3}\ns := 0\ni := 0\nwhile i < 5 {\n  s += a[i]\n  i++\n}\n")
    expect(r.output).to_equal("Runtime error in main.caju, line 5: Index 3 out of range (length 3).")
  })
})

fn print_free(x: int) -> int { return x }

# boxing into an any allocates, but the loop looks free of calls: its lists stay in registers,
# stored in the frame around each allocation; 2 million boxes make the collector run
fn box_loop() -> int {
  a := make([]int, 1000)
  for i := 0; i < len(a); i++ { a[i] = i }
  keep := make([]any, 10)
  let v: any = 0
  total := 0
  for r := 0; r < 2000; r++ {
    for i := 0; i < len(a); i++ {
      v = a[i] * 3
      keep[i % 10] = v
      total += a[i]
    }
  }
  s := 0
  for i := 0; i < len(a); i++ { s += a[i] }
  return total + s
}
