# &x is the address of x; *p is the value it points to.
fn zero(p: *int) { *p = 0 }
x := 42
p := &x
*p += 8
print(x)
zero(&x)
print(x)

# struct with a pointer: a linked list
struct Node { value: int, next: *Node }
list := &Node{value: 1, next: &Node{value: 2, next: &Node{value: 3}}}
for n := list; n != nil; n = n.next { print("node", n.value) }

# methods with a *T receiver change the original
struct Point { x: int, y: int }
fn (p: *Point) move(dx: int, dy: int) { p.x += dx; p.y += dy }
fn (p: Point) dist() -> int { return p.x * p.x + p.y * p.y }
pt := Point{3, 4}
pt.move(1, 1)
print(pt, pt.dist())

# embedded struct: Car gets the fields and methods of Engine
struct Engine { power: int }
fn (m: Engine) roar() -> str { return "vroom " + str(m.power) }
fn (m: *Engine) boost() { m.power *= 2 }
struct Car { Engine; model: str }
car := Car{Engine{90}, "beetle"}
car.boost()
print(car.model, car.power, car.roar())

q := new(int)
print(*q, q != nil)
