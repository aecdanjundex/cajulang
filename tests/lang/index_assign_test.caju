# a[i] op= v has a fast path in the native compiler (index_op_assign): the element's address is
# computed once and the element is read before v is evaluated.
import { describe, it, expect, run_source } from "std/testing"

let data: []int = []int{}

fn bump() -> int {
  data[0] = 100
  return 1
}

describe("a[i] op= v", fn() {
  it("works with every integer operator", fn() {
    a := []int{10, 10, 10, 10, 10, 10, 10, 10, 10, 10}
    a[0] += 3
    a[1] -= 3
    a[2] *= 3
    a[3] /= 3
    a[4] %= 3
    a[5] &= 3
    a[6] |= 3
    a[7] ^= 3
    a[8] <<= 3
    a[9] >>= 1
    expect(a).to_equal([]int{13, 7, 30, 3, 1, 2, 11, 9, 80, 5})
  })
  it("computes the index once and accepts expressions on both sides", fn() {
    a := []int{0, 0, 0, 0}
    i := 1
    a[i + 1] += i * 10 + 2
    a[len(a) - 1] -= 5
    expect(a).to_equal([]int{0, 0, 12, -5})
  })
  it("wraps fixed-size integers", fn() {
    b := []uint8{250}
    b[0] += 10
    c := []int8{127}
    c[0] += 1
    expect(int(b[0])).to_equal(4)
    expect(int(c[0])).to_equal(-128)
  })
  it("works on arrays and with floats", fn() {
    let arr: [3]int = [3]int{1, 2, 3}
    arr[2] *= 7
    f := []num{1.5, 2.0}
    f[0] += 1.0
    f[1] /= 4.0
    f[0] *= f[1] + 0.5
    expect(arr[2]).to_equal(21)
    expect(f).to_equal([]num{2.5, 0.5})
  })
  it("reads the element before evaluating the right side", fn() {
    data = []int{1}
    data[0] += bump()
    expect(data[0]).to_equal(2)
  })
  it("reports a division by zero and an index out of range with the line", fn() {
    r := run_source("a := []int{1}\nz := 0\na[0] /= z\n")
    expect(r.output).to_equal("Runtime error in main.caju, line 3: Integer division by zero.")
    r2 := run_source("a := []int{1}\ni := 5\na[i] += 1\n")
    expect(r2.output).to_equal("Runtime error in main.caju, line 3: Index 5 out of range (length 1).")
  })
})
