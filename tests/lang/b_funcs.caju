fn divide(a: int, b: int) -> (int, error) {
  if b == 0 { return 0, errors.New("division by zero") }
  return a / b, nil
}
q, err := divide(10, 3)
print(q, err)
q, err = divide(1, 0)
if err != nil { print("error:", err) }

fn counter() -> fn() -> int {
  n := 0
  return fn() -> int {
    n++
    return n
  }
}
c1 := counter()
c2 := counter()
print(c1(), c1(), c1(), c2())

fn apply(xs: []int, f: fn(int) -> int) -> []int {
  out := []int{}
  for _, x := range xs { out = append(out, f(x)) }
  return out
}
print(apply([]int{1, 2, 3}, fn(x: int) -> int { return x * x }))
double := fn(x: int) -> int { return 2 * x }
print(apply([]int{1, 2, 3}, double))

fns := []fn() -> int{}
for i := 0; i < 3; i++ {
  fns = append(fns, fn() -> int { return i })
}
for _, f := range fns { print(f()) }

fn minmax(xs: []int) -> (lo: int, hi: int) {
  lo = xs[0]
  hi = xs[0]
  for _, x := range xs {
    if x < lo { lo = x }
    if x > hi { hi = x }
  }
  return
}
lo, hi := minmax([]int{5, 2, 9, 1})
print(lo, hi)

fn safe(a: int, b: int) -> (r: int, err: error) {
  defer fn() {
    if x := recover(); x != nil {
      err = errors.New("recovered: " + str(x))
    }
  }()
  r = a / b
  return
}
print(safe(10, 2))
print(safe(1, 0))

fn order() {
  for i := 0; i < 3; i++ { defer print("defer", i) }
  print("body")
}
order()
a, b := 1, 2
a, b = b, a
print(a, b)
