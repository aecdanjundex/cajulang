jobs := make(chan int, 100)
res := make(chan int, 100)
fn worker(id: int, jobs: chan int, res: chan int) {
  for j := range jobs {
    sleep(0.01 * id)
    res <- j * j
  }
}
for w := 1; w <= 3; w++ { go worker(w, jobs, res) }
for j := 1; j <= 9; j++ { jobs <- j }
close(jobs)
sum := 0
for k := 0; k < 9; k++ { sum += <-res }
print("sum", sum)
tick := make(chan bool)
done := make(chan bool)
go fn() {
  for i := 0; i < 3; i++ { sleep(0.05); tick <- true }
  done <- true
}()
n := 0
outer:
for {
  select {
  case <-tick: n++
  case <-done: break outer
  }
}
print("ticks", n)
sem := make(chan int)
select {
case v := <-sem: print("no", v)
default: print("default")
}
