import "std/os"
import "std/strconv"

fn quicksort(a: []int, lo: int, hi: int) {
  while lo < hi {
    p := a[(lo + hi) / 2]
    i := lo
    j := hi
    while i <= j {
      while a[i] < p { i++ }
      while a[j] > p { j-- }
      if i <= j {
        t := a[i]
        a[i] = a[j]
        a[j] = t
        i++
        j--
      }
    }
    # recurse into the smaller side, loop on the larger
    if j - lo < hi - i {
      quicksort(a, lo, j)
      lo = i
    } else {
      quicksort(a, i, hi)
      hi = j
    }
  }
}

n, _ := strconv.atoi(os.args()[1])
a := make([]int, n)
seed := 42
for i := 0; i < n; i++ {
  seed = (seed * 1103515245 + 12345) % 2147483648
  a[i] = seed
}
quicksort(a, 0, n - 1)
sum := 0
for i := 0; i < n; i++ {
  if i > 0 && a[i - 1] > a[i] { print("not sorted") }
  sum = (sum + (a[i] % 1000) * (i % 1000)) % 1000000007
}
print(sum)
