import "std/os"
import "std/strconv"

n, _ := strconv.atoi(os.args()[1])
buckets := n / 2
m := map[int]int{}
for i := 0; i < n; i++ {
  k := (i * 7919) % buckets
  m[k] = m[k] + i
}
sum := 0
for i := 0; i < n; i++ {
  v, ok := m[(i * 31) % n]
  if ok { sum = (sum + v) % 1000000007 }
}
print(len(m), sum)
