import "std/os"
import "std/strconv"

size, _ := strconv.atoi(os.args()[1])
fs := num(size)
inside := 0
for py := 0; py < size; py++ {
  ci := num(py) * 2.5 / fs - 1.25
  for px := 0; px < size; px++ {
    cr := num(px) * 2.5 / fs - 2.0
    zr := 0.0
    zi := 0.0
    i := 0
    while i < 50 && zr * zr + zi * zi <= 4.0 {
      t := zr * zr - zi * zi + cr
      zi = 2.0 * zr * zi + ci
      zr = t
      i++
    }
    if i == 50 { inside++ }
  }
}
print(inside)
