# quicksort on a slice of integers (pseudo-random data)
fn quicksort(a: []int, lo: int, hi: int) {
  while lo < hi {
    p := a[(lo + hi) / 2]
    i := lo
    j := hi
    while i <= j {
      while a[i] < p { i++ }
      while a[j] > p { j-- }
      if i <= j {
        a[i], a[j] = a[j], a[i]
        i++
        j--
      }
    }
    if j - lo < hi - i {
      quicksort(a, lo, j)
      lo = i
    } else {
      quicksort(a, i, hi)
      hi = j
    }
  }
}
n := 1000000
a := make([]int, n)
x := 12345
for i := 0; i < n; i++ {
  x = (x * 1103515245 + 12345) % 2147483648
  a[i] = x
}
quicksort(a, 0, n - 1)
ok := true
for i := 1; i < n; i++ { if a[i - 1] > a[i] { ok = false } }
print(ok, a[0], a[n / 2])
