# many small objects: allocation and garbage collection
struct Node { value: int, next: *Node }
total := 0
for round := 0; round < 30; round++ {
  head := &Node{value: 0}
  for i := 1; i < 100000; i++ { head = &Node{value: i, next: head} }
  for p := head; p != nil; p = p.next { total += p.value }
}
print(total)
