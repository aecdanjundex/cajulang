# Native runtime: the Windows part (kernel32 functions)
extern "kernel32.dll" fn GetStdHandle(n: i32) -> ptr
extern "kernel32.dll" fn WriteFile(h: ptr, buf: ptr, n: u32, written: ptr, ov: ptr) -> bool
extern "kernel32.dll" fn ExitProcess(code: u32)
extern "kernel32.dll" fn VirtualAlloc(addr: ptr, n: u64, kind: u32, prot: u32) -> ptr
extern "kernel32.dll" fn Sleep(ms: u32)
extern "kernel32.dll" fn GetEnvironmentVariableA(name: ptr, buf: ptr, n: u32) -> u32
extern "kernel32.dll" fn SetConsoleOutputCP(cp: u32) -> bool

let rt_stdout: int = 0

fn rt_os_init() {
  SetConsoleOutputCP(65001)
  rt_stdout = GetStdHandle(-11)
  name := "CAJU_SKIP_SLEEP"
  if GetEnvironmentVariableA(__strp(name) + 8, 0, 0) > 0 { rt_skip_sleep = true }
}
fn rt_os_write(p: int, n: int) { WriteFile(rt_stdout, p, n, rt_tmp + 64, 0) }
fn rt_os_mem(n: int) -> int { return VirtualAlloc(0, n, 12288, 4) }
fn rt_os_reserve(n: int) -> int { return VirtualAlloc(0, n, 8192, 1) }
fn rt_os_commit(p: int, n: int) { VirtualAlloc(p, n, 4096, 4) }
# free pages keep their memory on Windows (rt_alloc_x zeroes reused pages anyway)
fn rt_os_release(p: int, n: int) { }
fn rt_os_exit(c: int) { ExitProcess(c) }
fn rt_os_sleep(s: num) { Sleep(int(s * 1000.0)) }
