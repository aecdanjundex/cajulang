# Native runtime, phase 2: composite values.
# Every value takes one 8-byte word. Struct and array: pointer to the words of the fields
# (or elements); slice: pointer to [data, length, capacity]; map: pointer to the table;
# pointer to a simple value: address of a word.
#
# Type descriptor (generated by the compiler): [0] kind, [8] n (array elements / fields),
# [16] element, [24] key, [32] name, [40] fields ([name, descriptor, value?] × n), [48] integer kind code.
# Kinds: 1 int, 2 uint, 3 num, 4 bool, 5 str, 6 slice, 7 array, 8 struct, 9 pointer, 10 map, 11 other.

fn rt_cell(v: int) -> int {
  p := rt_alloc(8)
  __store64(p, v)
  return p
}
fn rt_dk(d: int) -> int { return __load64(d) }
# bytes per element of a list or array whose element descriptor is ed: bool takes 1, the rest 8
fn rt_esize(ed: int) -> int {
  if __load64(ed) == 4 { return 1 }
  return 8
}
# element i of a list/array data block with es-byte elements
fn rt_eload(p: int, i: int, es: int) -> int {
  if es == 1 { return __load8(p + i) }
  return __load64(p + 8 * i)
}
fn rt_estore(p: int, i: int, es: int, v: int) {
  if es == 1 {
    __store8(p + i, v)
    return
  }
  __store64(p + 8 * i, v)
}
# copies n elements of es bytes one by one, from the first (like the element loops it replaces)
fn rt_ecopy(d: int, s: int, n: int, es: int) {
  if es == 8 {
    rt_copy(d, s, 8 * n)
    return
  }
  i := 0
  while i < n {
    __store8(d + i, __load8(s + i))
    i++
  }
}
# a data block for c elements (+8 bytes: an empty slice at the end points inside it); zeroed
fn rt_edata(ed: int, c: int) -> int {
  if rt_esize(ed) == 1 { return rt_alloc_ns(c + 8) }
  return rt_alloc(8 * c + 8)
}
fn rt_is_value(d: int) -> bool {
  k := __load64(d)
  return k == 7 or k == 8
}

# ---------------------------------------------------------------- zero, copy, equality
# the zero value of the type is the word 0 (everything but texts, structs and arrays: rt_zero)
fn rt_zero_is_0(d: int) -> bool {
  k := __load64(d)
  return k != 5 && k != 7 && k != 8
}
fn rt_zero(d: int) -> int {
  k := __load64(d)
  if k == 5 { return __strp("") }
  if k == 8 {
    n := __load64(d + 8)
    p := rt_alloc(8 * n + 8)
    f := __load64(d + 40)
    i := 0
    while i < n {
      __store64(p + 8 * i, rt_zero(__load64(f + 24 * i + 8)))
      i++
    }
    return p
  }
  if k == 7 {
    n := __load64(d + 8)
    e := __load64(d + 16)
    p := rt_edata(e, n)
    if rt_zero_is_0(e) { return p }               # (bool, numbers, pointers): the block is zeroed
    i := 0
    while i < n {
      __store64(p + 8 * i, rt_zero(e))
      i++
    }
    return p
  }
  return 0
}
# structs and arrays are values: assigning copies (fields that are also values are copied too)
fn rt_copy_val(v: int, d: int) -> int {
  k := __load64(d)
  if v == 0 { return v }
  if k == 8 {
    n := __load64(d + 8)
    f := __load64(d + 40)
    p := rt_alloc(8 * n + 8)
    i := 0
    while i < n {
      w := __load64(v + 8 * i)
      fd := __load64(f + 24 * i + 8)
      if __load64(f + 24 * i + 16) != 0 { w = rt_copy_val(w, fd) }
      __store64(p + 8 * i, w)
      i++
    }
    return p
  }
  if k == 7 {
    n := __load64(d + 8)
    e := __load64(d + 16)
    p := rt_edata(e, n)
    if rt_esize(e) == 1 {
      rt_ecopy(p, v, n, 1)
      return p
    }
    deep := rt_is_value(e)
    i := 0
    while i < n {
      w := __load64(v + 8 * i)
      if deep { w = rt_copy_val(w, e) }
      __store64(p + 8 * i, w)
      i++
    }
    return p
  }
  return v
}
# writes src over dst, keeping the object (pointers to it stay valid)
fn rt_copy_into(dst: int, src: int, d: int) {
  k := __load64(d)
  if dst == 0 or src == 0 { return }
  n := __load64(d + 8)
  if k == 7 and rt_esize(__load64(d + 16)) == 1 {
    rt_ecopy(dst, src, n, 1)
    return
  }
  i := 0
  while i < n {
    fd := __load64(d + 16)
    deep := false
    if k == 8 {
      f := __load64(d + 40)
      fd = __load64(f + 24 * i + 8)
      deep = __load64(f + 24 * i + 16) != 0
    } else {
      deep = rt_is_value(fd)
    }
    w := __load64(dst + 8 * i)
    if deep and w != 0 {
      rt_copy_into(w, __load64(src + 8 * i), fd)
    } else {
      __store64(dst + 8 * i, __load64(src + 8 * i))
    }
    i++
  }
}
fn rt_eq_flat(a: int, b: int, d: int) -> bool {
  k := __load64(d)
  if k == 11 or k == 12 { return rt_dyn_eq(a, b) }
  if k == 3 { return __bitsf(a) == __bitsf(b) }
  if k == 5 { return rt_streq(__pstr(a), __pstr(b)) }
  return a == b
}
# VM equality: structs and arrays field by field, pointers by identity
fn rt_eq(a: int, b: int, d: int) -> bool {
  if a == b { return true }
  k := __load64(d)
  if k != 7 and k != 8 { return rt_eq_flat(a, b, d) }
  if a == 0 or b == 0 { return false }
  n := __load64(d + 8)
  if k == 7 and rt_esize(__load64(d + 16)) == 1 {
    j := 0
    while j < n {
      if __load8(a + j) != __load8(b + j) { return false }
      j++
    }
    return true
  }
  i := 0
  while i < n {
    fd := __load64(d + 16)
    deep := true
    if k == 8 {
      f := __load64(d + 40)
      fd = __load64(f + 24 * i + 8)
      deep = __load64(f + 24 * i + 16) != 0
    }
    x := __load64(a + 8 * i)
    y := __load64(b + 8 * i)
    if deep {
      if not rt_eq(x, y, fd) { return false }
    } else if x != y and not rt_eq_flat(x, y, fd) {
      return false
    }
    i++
  }
  return true
}

# ---------------------------------------------------------------- slices
fn rt_hdr(data: int, n: int, c: int) -> int {
  h := rt_alloc(24)
  __store64(h, data)
  __store64(h + 8, n)
  __store64(h + 16, c)
  return h
}
fn rt_slen(s: int) -> int {
  if s == 0 { return 0 }
  return __load64(s + 8)
}
fn rt_scap(s: int) -> int {
  if s == 0 { return 0 }
  return __load64(s + 16)
}
fn rt_sdata(s: int) -> int {
  if s == 0 { return 0 }
  return __load64(s)
}
fn rt_make_slice(ed: int, n: int, c: int) -> int {
  data := rt_edata(ed, c)
  if rt_esize(ed) == 1 { return rt_hdr(data, n, c) }
  if rt_zero_is_0(ed) { return rt_hdr(data, n, c) }   # the new block is already zeroed
  i := 0
  while i < c {
    __store64(data + 8 * i, rt_zero(ed))
    i++
  }
  return rt_hdr(data, n, c)
}
fn rt_grow_cap(old: int, need: int) -> int {
  if need > 2 * old { return need }
  if old < 256 {
    if 2 * old > need { return 2 * old }
    return need
  }
  c := old
  while c < need { c = c + (c + 768) / 4 }
  return c
}
# append: writes into the same backing array if it fits; otherwise, into a larger one
fn rt_append(s: int, src: int, n: int, ed: int) -> int {
  data := rt_sdata(s)
  ln := rt_slen(s)
  cp := rt_scap(s)
  total := ln + n
  if rt_is_value(ed) {
    # structs and arrays go in as copies
    cp2 := rt_alloc(8 * n + 8)
    j := 0
    while j < n {
      __store64(cp2 + 8 * j, rt_copy_val(__load64(src + 8 * j), ed))
      j++
    }
    src = cp2
  }
  es := rt_esize(ed)
  if total <= cp {
    rt_ecopy(data + es * ln, src, n, es)
    return rt_hdr(data, total, cp)
  }
  nc := rt_grow_cap(cp, total)
  nd := rt_edata(ed, nc)
  rt_ecopy(nd, data, ln, es)
  rt_ecopy(nd + es * ln, src, n, es)
  if es == 1 { return rt_hdr(nd, total, nc) }    # bool: the rest is already false
  z := rt_zero(ed)
  fresh := rt_is_value(ed)
  i := total
  while i < nc {
    if fresh {
      __store64(nd + 8 * i, rt_zero(ed))
    } else {
      __store64(nd + 8 * i, z)
    }
    i++
  }
  return rt_hdr(nd, total, nc)
}
fn rt_copy_slice(d: int, s: int, ed: int) -> int {
  if d == 0 { return 0 }
  n := rt_slen(d)
  m := rt_slen(s)
  if m < n { n = m }
  dd := rt_sdata(d)
  sd := rt_sdata(s)
  if rt_esize(ed) == 1 {
    rt_ecopy(dd, sd, n, 1)
    return n
  }
  i := 0
  while i < n {
    __store64(dd + 8 * i, rt_copy_val(__load64(sd + 8 * i), ed))
    i++
  }
  return n
}
fn rt_copy_str(d: int, s: str) -> int {
  if d == 0 { return 0 }
  p := __strp(s)
  n := rt_slen(d)
  m := __load64(p)
  if m < n { n = m }
  dd := rt_sdata(d)
  i := 0
  while i < n {
    __store64(dd + 8 * i, __load8(p + 8 + i))
    i++
  }
  return n
}
fn rt_nil_index(where: str, i: int, write: bool) {
  if write { rt_fail(where, "Assignment to a nil map or slice") }
  rt_fail(where, "Index " + rt_int_str(i) + " in a nil slice")
}
fn rt_make_check(where: str, n: int, c: int) {
  if n < 0 { rt_fail(where, "Invalid size in make: " + rt_int_str(n)) }
  if c < 0 { rt_fail(where, "Invalid size in make: " + rt_int_str(c)) }
  if c < n { rt_fail(where, "make: capacity (" + rt_int_str(c) + ") is less than length (" + rt_int_str(n) + ")") }
  if c > 100000000 { rt_fail(where, "make: size too large") }
}
fn rt_index_fail(where: str, i: int, n: int) {
  rt_fail(where, "Index " + rt_int_str(i) + " out of range (length " + rt_int_str(n) + ")")
}
fn rt_slice_fail(where: str, lo: int, hi: int, n: int, c: int, hascap: bool) {
  msg := "Slice [" + rt_int_str(lo) + ":" + rt_int_str(hi) + "] out of bounds (length " + rt_int_str(n)
  if hascap { msg = msg + ", capacity " + rt_int_str(c) }
  rt_fail(where, msg + ")")
}
# s[lo:hi] of a slice (hi = -1 when omitted)
fn rt_sub_slice(where: str, s: int, lo: int, hi: int, es: int) -> int {
  n := rt_slen(s)
  c := rt_scap(s)
  if hi == -1 { hi = n }
  if lo < 0 or hi < lo or hi > c { rt_slice_fail(where, lo, hi, n, c, s != 0) }
  if s == 0 { return 0 }
  return rt_hdr(rt_sdata(s) + es * lo, hi - lo, c - lo)
}
fn rt_sub_array(where: str, a: int, n: int, lo: int, hi: int, es: int) -> int {
  if hi == -1 { hi = n }
  if lo < 0 or hi < lo or hi > n { rt_slice_fail(where, lo, hi, n, n, false) }
  return rt_hdr(a + es * lo, hi - lo, n - lo)
}
fn rt_sub_str(where: str, s: str, lo: int, hi: int) -> str {
  p := __strp(s)
  n := __load64(p)
  if hi == -1 { hi = n }
  if lo < 0 or hi < lo or hi > n { rt_slice_fail(where, lo, hi, n, n, false) }
  return rt_utf8_fix(p + 8 + lo, hi - lo)
}

# ---------------------------------------------------------------- UTF-8
# bytes → string, replacing invalid sequences with U+FFFD (like TextDecoder)
fn rt_utf8_fix(p: int, n: int) -> str {
  out := rt_alloc_ns(3 * n + 8)
  o := 0
  i := 0
  while i < n {
    b := __load8(p + i)
    if b < 128 {
      __store8(out + o, b)
      o++
      i++
      continue
    }
    need := 0
    lo := 128
    hi := 191
    if b >= 194 and b <= 223 { need = 1 }
    if b >= 224 and b <= 239 { need = 2 }
    if b >= 240 and b <= 244 { need = 3 }
    if b == 224 { lo = 160 }
    if b == 237 { hi = 159 }
    if b == 240 { lo = 144 }
    if b == 244 { hi = 143 }
    if need == 0 {
      o = rt_put_fffd(out, o)
      i++
      continue
    }
    j := 1
    good := true
    while j <= need {
      if i + j >= n {
        good = false
        break
      }
      c := __load8(p + i + j)
      if j == 1 {
        if c < lo or c > hi {
          good = false
          break
        }
      } else if c < 128 or c > 191 {
        good = false
        break
      }
      j++
    }
    if good {
      rt_copy(out + o, p + i, need + 1)
      o = o + need + 1
      i = i + need + 1
    } else {
      o = rt_put_fffd(out, o)
      i = i + j
    }
  }
  return rt_mkstr(out, o)
}
fn rt_put_fffd(out: int, o: int) -> int {
  __store8(out + o, 239)
  __store8(out + o + 1, 191)
  __store8(out + o + 2, 189)
  return o + 3
}
fn rt_rune_put(out: int, o: int, r: int) -> int {
  if r < 0 or r > 1114111 or (r >= 55296 and r <= 57343) { return rt_put_fffd(out, o) }
  if r < 128 {
    __store8(out + o, r)
    return o + 1
  }
  if r < 2048 {
    __store8(out + o, 192 | (r >> 6))
    __store8(out + o + 1, 128 | (r & 63))
    return o + 2
  }
  if r < 65536 {
    __store8(out + o, 224 | (r >> 12))
    __store8(out + o + 1, 128 | ((r >> 6) & 63))
    __store8(out + o + 2, 128 | (r & 63))
    return o + 3
  }
  __store8(out + o, 240 | (r >> 18))
  __store8(out + o + 1, 128 | ((r >> 12) & 63))
  __store8(out + o + 2, 128 | ((r >> 6) & 63))
  __store8(out + o + 3, 128 | (r & 63))
  return o + 4
}
fn rt_rune_str(r: int) -> str {
  o := rt_rune_put(rt_tmp, 0, r)
  return rt_mkstr(rt_tmp, o)
}
let rt_rune_n: int = 0
# rune starting at byte i of a valid string; its length goes to rt_rune_n
fn rt_rune_at(p: int, i: int) -> int {
  b := __load8(p + i)
  if b < 128 {
    rt_rune_n = 1
    return b
  }
  if b < 224 {
    rt_rune_n = 2
    return ((b & 31) << 6) | (__load8(p + i + 1) & 63)
  }
  if b < 240 {
    rt_rune_n = 3
    return ((b & 15) << 12) | ((__load8(p + i + 1) & 63) << 6) | (__load8(p + i + 2) & 63)
  }
  rt_rune_n = 4
  return ((b & 7) << 18) | ((__load8(p + i + 1) & 63) << 12) | ((__load8(p + i + 2) & 63) << 6) | (__load8(p + i + 3) & 63)
}
fn rt_str_bytes(s: str) -> int {
  p := __strp(s)
  n := __load64(p)
  data := rt_alloc(8 * n + 8)
  i := 0
  while i < n {
    __store64(data + 8 * i, __load8(p + 8 + i))
    i++
  }
  return rt_hdr(data, n, n)
}
fn rt_str_runes(s: str) -> int {
  p := __strp(s) + 8
  n := __load64(p - 8)
  data := rt_alloc(8 * n + 8)
  k := 0
  i := 0
  while i < n {
    __store64(data + 8 * k, rt_rune_at(p, i))
    i = i + rt_rune_n
    k++
  }
  return rt_hdr(data, k, k)
}
fn rt_bytes_str(s: int) -> str {
  n := rt_slen(s)
  d := rt_sdata(s)
  tmp := rt_alloc_ns(n + 8)
  i := 0
  while i < n {
    __store8(tmp + i, __load64(d + 8 * i) & 255)
    i++
  }
  return rt_utf8_fix(tmp, n)
}
fn rt_runes_str(s: int) -> str {
  n := rt_slen(s)
  d := rt_sdata(s)
  out := rt_alloc_ns(4 * n + 8)
  o := 0
  i := 0
  while i < n {
    o = rt_rune_put(out, o, __load64(d + 8 * i))
    i++
  }
  return rt_mkstr(out, o)
}

# ---------------------------------------------------------------- maps
# [0] count, [8] entries, [16] entries used, [24] capacity, [32] index, [40] index size,
# [48] key kind, [56] deleted flags (0 while nothing was deleted: one byte per entry, 1 = deleted),
# [64] 1 when neither keys nor values are pointers (the entries are allocated without pointers)
# entry: [key, value] (16 bytes, in insertion order: range walks this array)
# index (no pointers, power-of-two size, at most half full): 32-bit slots, 0 = empty,
# 0xFFFFFFFF = deleted, otherwise tag | (entry position + 1). The position takes the low bits
# (below the index size, as the index is at most half full) and the tag the bits above, up to
# bit 30: hash bits 32 and up (rt_map_tag). A probe rejects the slot of another key by its tag,
# without reading the entries array (one cache miss less): slot ^ tag is the position + 1 when
# the tags match, and above the index mask otherwise (a deleted slot has bit 31 set, which no
# tag has). Growing the index hashes the keys again, walking the entries in order.
# kk: the key kind (0 int, 1 num, 2 str), plus 256 when the entries hold no pointers
# one block of 168 bytes (a size class): the 72-byte header, the first 4 entries and the first
# index (8 slots); when the map grows, the new arrays are separate objects
fn rt_map_new(kk: int) -> int {
  m := rt_alloc(72 + 64 + 32)
  ns := kk >> 8
  kk = kk & 255
  __store64(m + 64, ns)
  __store64(m + 8, m + 72)
  __store64(m + 24, 4)
  __store64(m + 32, m + 136)
  __store64(m + 40, 8)
  __store64(m + 48, kk)
  return m
}
fn rt_mix(h: int) -> int {
  h = h ^ (h >> 33)
  h = h * -(49064778 * 1000000000 + 989728563)
  h = h ^ (h >> 33)
  return h
}
fn rt_hash(k: int, kk: int) -> int {
  if kk == 0 { return rt_mix(k) }
  if kk == 1 {
    x := __bitsf(k)
    if x == 0.0 { return rt_mix(0) }
    if x != x { return rt_mix(4095 << 51) }
    return rt_mix(k)
  }
  if kk == 2 { return rt_str_hash(k) }
  return rt_mix(k)
}
# the hash of a string: 8 bytes per step. The last step reads the 8 bytes that end at the last
# byte (p + n): they overlap bytes already hashed, or the length in front of a short string, and
# never go past the end of the string.
fn rt_str_hash(k: int) -> int {
  p := __strp(__pstr(k))
  n := __load64(p)
  h := n * -(70460 * 100000000000000 + 29254386353131)
  i := 0
  while i + 8 <= n {
    h = (h ^ __load64(p + 8 + i)) * -(70460 * 100000000000000 + 29254386353131)
    h = h ^ (h >> 32)
    i += 8
  }
  if i < n or n == 0 {
    h = (h ^ __load64(p + n)) * -(70460 * 100000000000000 + 29254386353131)
  }
  return rt_mix(h)
}
# the tag of a hash in an index of size slots, in place
fn rt_map_tag(h: int, size: int) -> int { return ((h >> 32) * size) & 2147483647 }
fn rt_keq(a: int, b: int, kk: int) -> bool {
  if kk == 1 {
    x := __bitsf(a)
    y := __bitsf(b)
    return x == y or (x != x and y != y)
  }
  if kk == 2 { return rt_streq(__pstr(a), __pstr(b)) }
  return a == b
}
# the hash of the last key rt_map_find did not find (rt_map_set inserts it without hashing again)
let rt_map_lh: int = 0
# integer keys (the common case): the hash and the comparison without calls (so every variable
# can stay in a register); m is not nil
fn rt_map_fi(m: int, k: int) -> int {
  idx := __load64(m + 32)
  size := __load64(m + 40)
  mask := size - 1
  e := __load64(m + 8) - 16
  h := k ^ (k >> 33)
  h = h * -(49064778 * 1000000000 + 989728563)
  h = h ^ (h >> 33)
  t := ((h >> 32) * size) & 2147483647
  p := h & mask
  for {
    s := __load32(idx + p * 4)
    if s == 0 {
      rt_map_lh = h
      return -1
    }
    s = s ^ t
    if s <= mask and __load64(e + s * 16) == k { return s - 1 }
    p = (p + 1) & mask
  }
  return -1
}
fn rt_map_find(m: int, k: int) -> int {
  if m == 0 { return -1 }
  kk := __load64(m + 48)
  if kk == 0 { return rt_map_fi(m, k) }
  idx := __load64(m + 32)
  size := __load64(m + 40)
  mask := size - 1
  e := __load64(m + 8) - 16
  h := rt_hash(k, kk)
  t := rt_map_tag(h, size)
  p := h & mask
  for {
    s := __load32(idx + 4 * p)
    if s == 0 {
      rt_map_lh = h
      return -1
    }
    s = s ^ t
    if s <= mask and rt_keq(__load64(e + 16 * s), k, kk) { return s - 1 }
    p = (p + 1) & mask
  }
  return -1
}
# m[k]: the value (0 if k is not there); rt_map_ok tells whether it was found
let rt_map_ok: bool = false
fn rt_map_get(m: int, k: int) -> int {
  if m != 0 and __load64(m + 48) == 0 {
    # rt_map_fi written again here (one call less on the most common path)
    idx := __load64(m + 32)
    size := __load64(m + 40)
    mask := size - 1
    e := __load64(m + 8) - 16
    h := k ^ (k >> 33)
    h = h * -(49064778 * 1000000000 + 989728563)
    h = h ^ (h >> 33)
    t := ((h >> 32) * size) & 2147483647
    p := h & mask
    for {
      s := __load32(idx + p * 4)
      if s == 0 {
        rt_map_ok = false
        return 0
      }
      s = s ^ t
      if s <= mask and __load64(e + s * 16) == k {
        rt_map_ok = true
        return __load64(e + s * 16 + 8)
      }
      p = (p + 1) & mask
    }
  }
  i := rt_map_find(m, k)
  if i < 0 {
    rt_map_ok = false
    return 0
  }
  rt_map_ok = true
  return __load64(__load64(m + 8) + 16 * i + 8)
}
# a new index of size slots with the live entries (deleted ones go away), hashed again
fn rt_map_reindex(m: int, size: int) {
  idx := rt_alloc_ns(4 * size)
  mask := size - 1
  e := __load64(m + 8)
  n := __load64(m + 16)
  d := __load64(m + 56)
  kk := __load64(m + 48)
  i := 0
  while i < n {
    if d == 0 or __load8(d + i) == 0 {
      k := __load64(e + 16 * i)
      h := 0
      if kk == 0 {
        h = k ^ (k >> 33)
        h = h * -(49064778 * 1000000000 + 989728563)
        h = h ^ (h >> 33)
      } else {
        h = rt_hash(k, kk)
      }
      p := h & mask
      while __load32(idx + 4 * p) != 0 { p = (p + 1) & mask }
      __store32(idx + 4 * p, (((h >> 32) * size) & 2147483647) | (i + 1))
    }
    i++
  }
  old := __load64(m + 32)
  __store64(m + 32, idx)
  __store64(m + 40, size)
  rt_free_big(old)
}
fn rt_map_set(where: str, m: int, k: int, v: int) {
  if m == 0 { rt_fail(where, "Assignment to a nil map or slice") }
  i := rt_map_find(m, k)
  if i >= 0 {
    __store64(__load64(m + 8) + 16 * i + 8, v)
    return
  }
  rt_map_ins(m, k, v)
}
# m[k] op= v and m[k] = m[k] op v in one probe: the address of k's value, inserted with the
# value 0 when missing (only for value types whose zero is 0). The address is valid until the
# next insertion: the generated code stores through it right away (no call in between).
fn rt_map_slot(where: str, m: int, k: int) -> int {
  if m == 0 { rt_fail(where, "Assignment to a nil map or slice") }
  if __load64(m + 48) == 0 {
    # rt_map_fi written again here (one call less on the most common path)
    idx := __load64(m + 32)
    size := __load64(m + 40)
    mask := size - 1
    e := __load64(m + 8) - 16
    h := k ^ (k >> 33)
    h = h * -(49064778 * 1000000000 + 989728563)
    h = h ^ (h >> 33)
    t := ((h >> 32) * size) & 2147483647
    p := h & mask
    for {
      s := __load32(idx + p * 4)
      if s == 0 {
        rt_map_lh = h
        i := rt_map_ins(m, k, 0)                  # (may move the entries: e is old)
        return __load64(m + 8) + 16 * i + 8
      }
      s = s ^ t
      if s <= mask and __load64(e + s * 16) == k { return e + s * 16 + 8 }
      p = (p + 1) & mask
    }
  }
  i := rt_map_find(m, k)
  if i < 0 { i = rt_map_ins(m, k, 0) }
  return __load64(m + 8) + 16 * i + 8
}
# inserts k, which is not in m (rt_map_find just missed it and left its hash in rt_map_lh);
# returns its position
fn rt_map_ins(m: int, k: int, v: int) -> int {
  e := __load64(m + 8)
  h := rt_map_lh
  n := __load64(m + 16)
  if n == __load64(m + 24) {
    nc := 2 * n
    ne := rt_alloc_x(16 * nc, __load64(m + 64) != 0)
    rt_copy(ne, e, 16 * n)
    __store64(m + 8, ne)
    __store64(m + 24, nc)
    rt_free_big(e)
    e = ne
    d := __load64(m + 56)
    if d != 0 {
      nd := rt_alloc_ns(nc)
      rt_copy(nd, d, n)
      __store64(m + 56, nd)
      rt_free_big(d)
    }
  }
  size := __load64(m + 40)
  if 4 * (n + 1) >= 3 * size {
    # the new index has the entries before this one (entries used is still n): it goes in below
    size = 2 * size
    rt_map_reindex(m, size)
  }
  __store64(e + 16 * n, k)
  __store64(e + 16 * n + 8, v)
  __store64(m + 16, n + 1)
  __store64(m, __load64(m) + 1)
  idx := __load64(m + 32)
  mask := size - 1
  p := h & mask
  while __load32(idx + 4 * p) != 0 and __load32(idx + 4 * p) != 4294967295 { p = (p + 1) & mask }
  __store32(idx + 4 * p, rt_map_tag(h, size) | (n + 1))
  return n
}
fn rt_map_del(m: int, k: int) {
  i := rt_map_find(m, k)
  if i < 0 { return }
  e := __load64(m + 8)
  d := __load64(m + 56)
  if d == 0 {
    d = rt_alloc_ns(__load64(m + 24))
    __store64(m + 56, d)
  }
  __store8(d + i, 1)
  # the dead entry no longer keeps its key and value alive
  __store64(e + 16 * i, 0)
  __store64(e + 16 * i + 8, 0)
  __store64(m, __load64(m) - 1)
  idx := __load64(m + 32)
  size := __load64(m + 40)
  mask := size - 1
  h := rt_hash(k, __load64(m + 48))
  s := rt_map_tag(h, size) | (i + 1)
  p := h & mask
  while __load32(idx + 4 * p) != s { p = (p + 1) & mask }
  __store32(idx + 4 * p, 4294967295)
}
fn rt_map_len(m: int) -> int {
  if m == 0 { return 0 }
  return __load64(m)
}
fn rt_map_val(m: int, i: int) -> int { return __load64(__load64(m + 8) + 16 * i + 8) }
fn rt_map_key(m: int, i: int) -> int { return __load64(__load64(m + 8) + 16 * i) }
fn rt_map_live(m: int, i: int) -> bool {
  d := __load64(m + 56)
  return d == 0 or __load8(d + i) == 0
}
fn rt_map_used(m: int) -> int {
  if m == 0 { return 0 }
  return __load64(m + 16)
}

# ---------------------------------------------------------------- string of a value (print, str, +)
let rt_sb: int = 0
let rt_sb_n: int = 0
let rt_sb_cap: int = 0
fn rt_sb_put(p: int, n: int) {
  if rt_sb_n + n > rt_sb_cap {
    nc := 2 * rt_sb_cap + n + 64
    nb := rt_alloc_ns(nc)
    rt_copy(nb, rt_sb, rt_sb_n)
    rt_sb = nb
    rt_sb_cap = nc
  }
  rt_copy(rt_sb + rt_sb_n, p, n)
  rt_sb_n = rt_sb_n + n
}
fn rt_sb_str(s: str) {
  p := __strp(s)
  rt_sb_put(p + 8, __load64(p))
}
fn rt_cmp_key(a: int, b: int, d: int) -> int {
  k := __load64(d)
  if k == 5 { return rt_strcmp(__pstr(a), __pstr(b)) }
  if k == 3 {
    x := __bitsf(a)
    y := __bitsf(b)
    if x < y { return -1 }
    if x > y { return 1 }
    return 0
  }
  if k == 2 {
    a = a ^ (1 << 63)
    b = b ^ (1 << 63)
  }
  if a < b { return -1 }
  if a > b { return 1 }
  return 0
}
fn rt_fmt(v: int, d: int, nested: bool) {
  k := __load64(d)
  if k == 1 {
    rt_sb_str(rt_int_str(v))
  } else if k == 2 {
    rt_sb_str(rt_uint_str(uint64(v)))
  } else if k == 3 {
    rt_sb_str(rt_num_str(__bitsf(v)))
  } else if k == 4 {
    if v != 0 { rt_sb_str("true") } else { rt_sb_str("false") }
  } else if k == 5 {
    if nested { rt_sb_str("\"") }
    rt_sb_str(__pstr(v))
    if nested { rt_sb_str("\"") }
  } else if v == 0 {
    rt_sb_str("nil")
  } else if k == 11 or k == 12 {
    bd := __load64(v)
    x := __load64(v + 8)
    if __load64(bd) == 9 and __load64(__load64(bd + 16)) == 8 {
      rt_sb_str("&")
      rt_fmt(x, __load64(bd + 16), nested)
    } else {
      rt_fmt(x, bd, nested)
    }
  } else if k == 13 {
    rt_sb_str(__pstr(v))
  } else if k == 14 {
    rt_sb_str("fn")
  } else if k == 6 or k == 7 {
    n := __load64(d + 8)
    data := v
    if k == 6 {
      n = __load64(v + 8)
      data = __load64(v)
    }
    e := __load64(d + 16)
    es := rt_esize(e)
    rt_sb_str("[")
    i := 0
    while i < n {
      if i > 0 { rt_sb_str(" ") }
      rt_fmt(rt_eload(data, i, es), e, true)
      i++
    }
    rt_sb_str("]")
  } else if k == 8 {
    rt_sb_str(__pstr(__load64(d + 32)))
    rt_sb_str("{")
    n := __load64(d + 8)
    f := __load64(d + 40)
    i := 0
    while i < n {
      if i > 0 { rt_sb_str(", ") }
      rt_sb_str(__pstr(__load64(f + 24 * i)))
      rt_sb_str(": ")
      rt_fmt(__load64(v + 8 * i), __load64(f + 24 * i + 8), true)
      i++
    }
    rt_sb_str("}")
  } else if k == 9 {
    e := __load64(d + 16)
    if rt_is_value(e) {
      rt_fmt(v, e, nested)
    } else {
      rt_sb_str("&")
      if __load64(e) == 4 { rt_fmt(__load8(v), e, true) } else { rt_fmt(__load64(v), e, true) }
    }
  } else if k == 10 {
    kd := __load64(d + 24)
    vd := __load64(d + 16)
    n := __load64(v + 16)
    ord := rt_alloc(8 * n + 8)
    c := 0
    i := 0
    while i < n {
      if rt_map_live(v, i) {
        j := c
        while j > 0 and rt_cmp_key(rt_map_key(v, __load64(ord + 8 * (j - 1))), rt_map_key(v, i), kd) > 0 {
          __store64(ord + 8 * j, __load64(ord + 8 * (j - 1)))
          j--
        }
        __store64(ord + 8 * j, i)
        c++
      }
      i++
    }
    rt_sb_str("map[")
    i = 0
    while i < c {
      if i > 0 { rt_sb_str(" ") }
      x := __load64(ord + 8 * i)
      rt_fmt(rt_map_key(v, x), kd, true)
      rt_sb_str(":")
      rt_fmt(rt_map_val(v, x), vd, true)
      i++
    }
    rt_sb_str("]")
  } else {
    rt_sb_str("?")
  }
}
fn rt_val_str(v: int, d: int) -> str {
  rt_sb_n = 0
  rt_fmt(v, d, false)
  return rt_mkstr(rt_sb, rt_sb_n)
}
fn rt_out_val(v: int, d: int) { rt_out_str(rt_val_str(v, d)) }
