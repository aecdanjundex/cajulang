# Runtime of the native compiler, written in Caju (phase 1).
# Uses low-level operations (__load8, __store64, __strp...) that are only allowed here.
# A string is a pointer to [length: 8 bytes][UTF-8 bytes][0].

let rt_buf: int = 0
let rt_buf_n: int = 0
let rt_tmp: int = 0
let rt_skip_sleep: bool = false
let rt_bR: int = 0
let rt_bS: int = 0
let rt_bT: int = 0
let rt_dig: int = 0
let rt_ndig: int = 0

fn rt_init() {
  rt_gc_init()
  rt_buf = rt_alloc_ns(4096)
  rt_tmp = rt_alloc_ns(128)
  rt_bR = rt_alloc_ns(8 * 120)
  rt_bS = rt_alloc_ns(8 * 120)
  rt_bT = rt_alloc_ns(8 * 120)
  rt_dig = rt_alloc_ns(64)
  rt_os_init()
}

# ---------------------------------------------------------------- memory
fn rt_copy(d: int, s: int, n: int) {
  i := 0
  while i + 8 <= n {
    __store64(d + i, __load64(s + i))
    i += 8
  }
  while i < n {
    __store8(d + i, __load8(s + i))
    i++
  }
}

# ---------------------------------------------------------------- strings
fn rt_newstr(n: int) -> int {
  p := rt_alloc_ns(n + 9)
  __store64(p, n)
  __store8(p + 8 + n, 0)
  return p
}
fn rt_mkstr(src: int, n: int) -> str {
  p := rt_newstr(n)
  rt_copy(p + 8, src, n)
  return __pstr(p)
}
fn rt_len(s: str) -> int { return __load64(__strp(s)) }
fn rt_concat(a: str, b: str) -> str {
  pa := __strp(a)
  pb := __strp(b)
  na := __load64(pa)
  nb := __load64(pb)
  if na == 0 { return b }
  if nb == 0 { return a }
  p := rt_newstr(na + nb)
  rt_copy(p + 8, pa + 8, na)
  rt_copy(p + 8 + na, pb + 8, nb)
  return __pstr(p)
}
# compares by UTF-8 bytes (same order as the code points); skips equal 8-byte words first
fn rt_strcmp(a: str, b: str) -> int {
  pa := __strp(a)
  pb := __strp(b)
  if pa == pb { return 0 }
  na := __load64(pa)
  nb := __load64(pb)
  n := na
  if nb < n { n = nb }
  i := 0
  while i + 8 <= n and __load64(pa + 8 + i) == __load64(pb + 8 + i) { i += 8 }
  while i < n {
    x := __load8(pa + 8 + i)
    y := __load8(pb + 8 + i)
    if x != y {
      if x < y { return -1 }
      return 1
    }
    i++
  }
  if na == nb { return 0 }
  if na < nb { return -1 }
  return 1
}
# a == b: the same length and bytes, 8 at a time; the last word is the 8 bytes ending at the last
# byte (it overlaps bytes already compared, or the equal lengths in front of short strings)
fn rt_streq(a: str, b: str) -> bool {
  pa := __strp(a)
  pb := __strp(b)
  if pa == pb { return true }
  n := __load64(pa)
  if n != __load64(pb) { return false }
  i := 0
  while i + 8 < n {
    if __load64(pa + 8 + i) != __load64(pb + 8 + i) { return false }
    i += 8
  }
  return __load64(pa + n) == __load64(pb + n)
}
fn rt_bool_str(b: bool) -> str {
  if b { return "true" }
  return "false"
}

# ---------------------------------------------------------------- integers to strings
fn rt_int_str(x: int) -> str {
  if x == 0 { return "0" }
  neg := x < 0
  i := 40
  while x != 0 {
    d := x % 10
    if d < 0 { d = -d }
    i--
    __store8(rt_tmp + i, 48 + d)
    x = x / 10
  }
  if neg {
    i--
    __store8(rt_tmp + i, 45)
  }
  return rt_mkstr(rt_tmp + i, 40 - i)
}
fn rt_uint_str(x: uint64) -> str {
  if x == 0 { return "0" }
  i := 40
  while x != 0 {
    i--
    __store8(rt_tmp + i, 48 + int(x % 10))
    x = x / 10
  }
  return rt_mkstr(rt_tmp + i, 40 - i)
}

# ---------------------------------------------------------------- big numbers
# [number of limbs, 32-bit limbs, least to most significant]
fn rt_big_set(p: int, v: int) {
  n := 0
  while v != 0 {
    n++
    __store64(p + 8 * n, v & 4294967295)
    v = v >> 32
  }
  __store64(p, n)
}
fn rt_big_copy(d: int, s: int) {
  n := __load64(s)
  i := 0
  while i <= n {
    __store64(d + 8 * i, __load64(s + 8 * i))
    i++
  }
}
# p = p * k, with k < 2^31
fn rt_big_mul(p: int, k: int) {
  n := __load64(p)
  c := 0
  i := 1
  while i <= n {
    v := __load64(p + 8 * i) * k + c
    __store64(p + 8 * i, v & 4294967295)
    c = v >> 32
    i++
  }
  if c != 0 {
    n++
    __store64(p + 8 * n, c)
    __store64(p, n)
  }
}
# p = p * 2^s
fn rt_big_shl(p: int, s: int) {
  while s >= 32 {
    n := __load64(p)
    if n > 0 {
      i := n
      while i >= 1 {
        __store64(p + 8 * (i + 1), __load64(p + 8 * i))
        i--
      }
      __store64(p + 8, 0)
      __store64(p, n + 1)
    }
    s -= 32
  }
  if s > 0 { rt_big_mul(p, 1 << s) }
}
fn rt_big_cmp(a: int, b: int) -> int {
  na := __load64(a)
  nb := __load64(b)
  if na != nb {
    if na < nb { return -1 }
    return 1
  }
  i := na
  while i >= 1 {
    x := __load64(a + 8 * i)
    y := __load64(b + 8 * i)
    if x != y {
      if x < y { return -1 }
      return 1
    }
    i--
  }
  return 0
}
# a = a - b, with a >= b
fn rt_big_sub(a: int, b: int) {
  na := __load64(a)
  nb := __load64(b)
  br := 0
  i := 1
  while i <= na {
    y := 0
    if i <= nb { y = __load64(b + 8 * i) }
    v := __load64(a + 8 * i) - y - br
    if v < 0 {
      v = v + 4294967296
      br = 1
    } else {
      br = 0
    }
    __store64(a + 8 * i, v)
    i++
  }
  while na > 0 and __load64(a + 8 * na) == 0 { na-- }
  __store64(a, na)
}

# Exact decimal digits of m × 2^e: `want` significant digits (ties rounded up, like
# JavaScript's toPrecision), or all of them (want = 0, for integers).
# Stores the digits in rt_dig/rt_ndig and returns k, the exponent of the first: x ≈ d.ddd × 10^k.
fn rt_digits(m: int, e: int, want: int) -> int {
  R := rt_bR
  S := rt_bS
  T := rt_bT
  rt_big_set(R, m)
  rt_big_set(S, 1)
  if e > 0 { rt_big_shl(R, e) }
  if e < 0 { rt_big_shl(S, -e) }
  bits := 0
  t := m
  while t != 0 {
    bits++
    t = t >> 1
  }
  k := int(num(e + bits - 1) * 0.30102999566398114)
  if k >= 0 {
    i := 0
    while i < k {
      rt_big_mul(S, 10)
      i++
    }
  } else {
    i := 0
    while i < -k {
      rt_big_mul(R, 10)
      i++
    }
  }
  while rt_big_cmp(R, S) < 0 {
    rt_big_mul(R, 10)
    k--
  }
  rt_big_copy(T, S)
  rt_big_mul(T, 10)
  while rt_big_cmp(R, T) >= 0 {
    rt_big_mul(S, 10)
    rt_big_mul(T, 10)
    k++
  }
  if want == 0 { want = k + 1 }
  nd := 0
  while nd < want {
    d := 0
    while rt_big_cmp(R, S) >= 0 {
      rt_big_sub(R, S)
      d++
    }
    __store8(rt_dig + nd, d)
    nd++
    rt_big_mul(R, 10)
  }
  rt_big_copy(T, S)
  rt_big_mul(T, 5)
  if rt_big_cmp(R, T) >= 0 {
    i := nd - 1
    for {
      if i < 0 {
        __store8(rt_dig, 1)
        j := 1
        while j < nd {
          __store8(rt_dig + j, 0)
          j++
        }
        k++
        break
      }
      d := __load8(rt_dig + i) + 1
      if d < 10 {
        __store8(rt_dig + i, d)
        break
      }
      __store8(rt_dig + i, 0)
      i--
    }
  }
  while nd > 1 and __load8(rt_dig + nd - 1) == 0 { nd-- }
  rt_ndig = nd
  return k
}

# Number to string, like the web page: integers (below 1e21) with all digits,
# everything else with 12 significant digits, following JavaScript's String(Number) rules.
fn rt_num_str(x: num) -> str {
  if x != x { return "NaN" }
  if x == 0.0 { return "0" }
  neg := x < 0.0
  if neg { x = -x }
  if x > 1.7976931348623157e308 {
    if neg { return "-Infinity" }
    return "Infinity"
  }
  if x < 9.0e18 {
    i := int(x)
    if num(i) == x {
      if neg { i = -i }
      return rt_int_str(i)
    }
  }
  b := __fbits(x)
  ex := (b >> 52) & 2047
  m := b & 4503599627370495
  e := -1074
  if ex > 0 {
    m = m | 4503599627370496
    e = ex - 1075
  }
  want := 12
  if x < 1.0e21 and x >= 9007199254740992.0 { want = 0 }
  k := rt_digits(m, e, want)
  nd := rt_ndig
  n := k + 1
  out := rt_tmp
  o := 0
  if neg {
    __store8(out, 45)
    o++
  }
  if nd <= n and n <= 21 {
    i := 0
    while i < nd {
      __store8(out + o, 48 + __load8(rt_dig + i))
      o++
      i++
    }
    while i < n {
      __store8(out + o, 48)
      o++
      i++
    }
  } else if 0 < n and n <= 21 {
    i := 0
    while i < nd {
      if i == n {
        __store8(out + o, 46)
        o++
      }
      __store8(out + o, 48 + __load8(rt_dig + i))
      o++
      i++
    }
  } else if -6 < n and n <= 0 {
    __store8(out + o, 48)
    __store8(out + o + 1, 46)
    o += 2
    i := 0
    while i < -n {
      __store8(out + o, 48)
      o++
      i++
    }
    i = 0
    while i < nd {
      __store8(out + o, 48 + __load8(rt_dig + i))
      o++
      i++
    }
  } else {
    __store8(out + o, 48 + __load8(rt_dig))
    o++
    if nd > 1 {
      __store8(out + o, 46)
      o++
      i := 1
      while i < nd {
        __store8(out + o, 48 + __load8(rt_dig + i))
        o++
        i++
      }
    }
    __store8(out + o, 101)
    o++
    ee := n - 1
    if ee >= 0 {
      __store8(out + o, 43)
    } else {
      __store8(out + o, 45)
      ee = -ee
    }
    o++
    es := rt_int_str(ee)
    pe := __strp(es)
    rt_copy(out + o, pe + 8, __load64(pe))
    o += __load64(pe)
  }
  return rt_mkstr(out, o)
}

# ---------------------------------------------------------------- arithmetic
fn rt_pow(a: num, b: num) -> num {
  if b != b { return b }
  if b == 0.0 { return 1.0 }
  if a != a { return a }
  inf := __bitsf(2047 << 52)
  if (a == 1.0 or a == -1.0) and (b == inf or b == -inf) { return __bitsf(4095 << 51) }
  if b == 0.5 and a != -inf { return __sqrt(a + 0.0) }
  if b >= -1.0e9 and b <= 1.0e9 and num(int(b)) == b {
    n := int(b)
    neg := n < 0
    if neg { n = -n }
    r := 1.0
    base := a
    while n > 0 {
      if (n & 1) == 1 { r = r * base }
      base = base * base
      n = n >> 1
    }
    if neg { return 1.0 / r }
    return r
  }
  return rt_exp(b * rt_log(a))
}
# simple exp and log (phase 1): good enough for the 12 digits print shows
fn rt_log(x: num) -> num {
  if x != x or x < 0.0 { return __bitsf(4095 << 51) }
  if x == 0.0 { return -__bitsf(2047 << 52) }
  if x > 1.7976931348623157e308 { return x }
  e := 0
  while x >= 2.0 {
    x = x / 2.0
    e++
  }
  while x < 1.0 {
    x = x * 2.0
    e--
  }
  if x > 1.4142135623730951 {
    x = x / 2.0
    e++
  }
  s := (x - 1.0) / (x + 1.0)
  s2 := s * s
  t := s
  sum := 0.0
  i := 1
  while i < 60 {
    sum = sum + t / num(i)
    t = t * s2
    i += 2
  }
  return 2.0 * sum + num(e) * 0.6931471805599453
}
fn rt_exp(x: num) -> num {
  if x != x { return x }
  if x > 709.8 { return __bitsf(2047 << 52) }
  if x < -745.2 { return 0.0 }
  k := int(x / 0.6931471805599453)
  r := x - num(k) * 0.6931471805599453
  t := 1.0
  sum := 1.0
  i := 1
  while i < 30 {
    t = t * r / num(i)
    sum = sum + t
    i++
  }
  while k > 0 {
    sum = sum * 2.0
    k--
  }
  while k < 0 {
    sum = sum / 2.0
    k++
  }
  return sum
}

# ---------------------------------------------------------------- output
fn rt_flush() {
  if rt_buf_n > 0 {
    rt_os_write(rt_buf, rt_buf_n)
    rt_buf_n = 0
  }
}
fn rt_out_mem(p: int, n: int) {
  if rt_buf_n + n > 4096 { rt_flush() }
  if n > 4096 {
    rt_os_write(p, n)
    return
  }
  rt_copy(rt_buf + rt_buf_n, p, n)
  rt_buf_n = rt_buf_n + n
}
fn rt_out_str(s: str) {
  p := __strp(s)
  rt_out_mem(p + 8, __load64(p))
}
fn rt_out_byte(b: int) {
  if rt_buf_n >= 4096 { rt_flush() }
  __store8(rt_buf + rt_buf_n, b)
  rt_buf_n++
}
fn rt_out_space() { rt_out_byte(32) }
fn rt_out_nl() {
  rt_out_byte(10)
  rt_flush()
}
fn rt_out_int(x: int) { rt_out_str(rt_int_str(x)) }
fn rt_out_uint(x: uint64) { rt_out_str(rt_uint_str(x)) }
fn rt_out_num(x: num) { rt_out_str(rt_num_str(x)) }
fn rt_out_bool(b: bool) { rt_out_str(rt_bool_str(b)) }

# ---------------------------------------------------------------- exit and errors
fn rt_exit(code: int) {
  rt_flush()
  rt_os_exit(code)
}
# error that ends the program (a panic nobody recovered)
fn rt_fatal(where: str, msg: str) {
  rt_flush()
  rt_out_str("Runtime error in ")
  rt_out_str(where)
  rt_out_str(": ")
  rt_out_str(msg)
  rt_out_str(".")
  rt_out_nl()
  rt_os_exit(1)
}
fn rt_sleep(where: str, s: num) {
  if not (s >= 0.0 and s <= 30.0) { rt_fail(where, "sleep accepts 0 to 30 seconds") }
  if rt_skip_sleep { return }
  rt_flush()
  rt_os_sleep(s)
}
fn rt_cstr_prefix(c: int, s: str) -> bool {
  p := __strp(s)
  n := __load64(p)
  i := 0
  while i < n {
    if __load8(c + i) != __load8(p + 8 + i) { return false }
    i++
  }
  return true
}
