fn divide(a: int, b: int) -> (int, error) {
  if b == 0 { return 0, errors.New("divisão por zero") }
  return a / b, nil
}
q, err := divide(10, 3)
print(q, err)
q, err = divide(1, 0)
if err != nil { print("erro:", err) }

fn contador() -> fn() -> int {
  n := 0
  return fn() -> int {
    n++
    return n
  }
}
c1 := contador()
c2 := contador()
print(c1(), c1(), c1(), c2())

fn aplica(xs: []int, f: fn(int) -> int) -> []int {
  out := []int{}
  for _, x := range xs { out = append(out, f(x)) }
  return out
}
print(aplica([]int{1, 2, 3}, fn(x: int) -> int { return x * x }))
dobro := fn(x: int) -> int { return 2 * x }
print(aplica([]int{1, 2, 3}, dobro))

fns := []fn() -> int{}
for i := 0; i < 3; i++ {
  fns = append(fns, fn() -> int { return i })
}
for _, f := range fns { print(f()) }

fn minmax(xs: []int) -> (lo: int, hi: int) {
  lo = xs[0]
  hi = xs[0]
  for _, x := range xs {
    if x < lo { lo = x }
    if x > hi { hi = x }
  }
  return
}
lo, hi := minmax([]int{5, 2, 9, 1})
print(lo, hi)

fn seguro(a: int, b: int) -> (r: int, err: error) {
  defer fn() {
    if x := recover(); x != nil {
      err = errors.New("recuperado: " + str(x))
    }
  }()
  r = a / b
  return
}
print(seguro(10, 2))
print(seguro(1, 0))

fn ordem() {
  for i := 0; i < 3; i++ { defer print("defer", i) }
  print("corpo")
}
ordem()
a, b := 1, 2
a, b = b, a
print(a, b)
