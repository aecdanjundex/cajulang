struct No { valor: int, prox: *No }
lista := &No{valor: 1}
lista.prox = &No{valor: 2, prox: &No{valor: 3}}
for p := lista; p != nil; p = p.prox { print(p.valor) }

struct Ponto { x: int, y: int }
fn (p: *Ponto) escala(k: int) { p.x *= k; p.y *= k }
fn (p: Ponto) soma() -> int { return p.x + p.y }
a := Ponto{1, 2}
pa := &a
pa.escala(10)
print(a, pa.soma(), *pa)
b := *pa
b.x = 0
print(a.x, b.x)
a = Ponto{5, 5}
print(pa)
x := 10
px := &x
*px = 20
*px += 1
print(x, *px)
fn incr(n: *int) { *n++ }
incr(&x)
print(x)
q := new(int)
*q = 7
print(*q)
r := new(Ponto)
r.x = 3
print(r, *r)
nums := []int{1, 2, 3}
pe := &nums[1]
*pe = 50
print(nums)
fn swap(a: *int, b: *int) { *a, *b = *b, *a }
u, v := 1, 2
swap(&u, &v)
print(u, v)
let nilp: *Ponto = nil
print(nilp == nil)
print(nilp.x)
