fn classe(n: int) -> str {
  switch {
  case n < 0: return "negativo"
  case n == 0: return "zero"
  case n < 10: return "pequeno"
  default: return "grande"
  }
}
print(classe(-1), classe(0), classe(5), classe(50))
for i := 0; i < 4; i++ {
  switch i {
  case 0, 1:
    print(i, "zero ou um")
  case 2:
    print(i, "dois, e cai no próximo")
    fallthrough
  case 3:
    print(i, "três")
  }
}
externo:
for i := 0; i < 3; i++ {
  for j := 0; j < 3; j++ {
    if j == 2 { continue externo }
    if i == 2 { break externo }
    print(i, j)
  }
}
let b: uint8 = 250
b += 10
print(b)
let i8: int8 = 127
i8++
print(i8)
let u: uint32 = 0
u--
print(u)
x := 1 << 40
print(x, x >> 38, x & 0xFF, 7 &^ 5, 6 ^ 3, ^0)
print(7 / 2, -7 / 2, 7 % 3, -7 % 3, 7.0 / 2)
print(int(3.9), int(-3.9), int64(1e18) * 10)
let h: uint32 = 2166136261
for _, c := range []byte("caju") { h ^= uint32(c); h *= 16777619 }
print("fnv32", h)
s := "Olá, mundo"
print(len(s), s[0], s[1:4], s[5:])
r := 'é'
print(r, string(r), string(rune(65)))
print(str(3) + "!", "a" < "b", "maçã" > "maca")
let f32: float32 = 0.1
print(f32 * 3)
if v, ok := map[str]int{"a": 1}["a"]; ok { print("achou", v) }
