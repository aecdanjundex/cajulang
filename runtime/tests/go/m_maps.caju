m := map[str]int{"b": 2, "a": 1, "c": 3}
delete(m, "b")
m["d"] = 4
print(m, len(m))
v, ok := m["z"]
print(v, ok)
for k, v := range m { print(k, v) }
type_m := map[int][]str{}
type_m[3] = append(type_m[3], "x", "y")
print(type_m)
s := make([]int, 0, 2)
t := append(s, 1)
u := append(s, 2)
print(t, u, len(s), cap(s))
s = append(s, 1, 2, 3)
print(s, len(s), cap(s))
arr := [3]int{1, 2, 3}
arr2 := arr
arr2[0] = 99
print(arr, arr2, arr == [3]int{1, 2, 3})
fs := arr[1:]
fs[0] = 7
print(arr, fs, cap(fs))
n := copy(s, []int{9, 9})
print(n, s)
print("olá"[1:3] == "l\xc3", len("olá"))
