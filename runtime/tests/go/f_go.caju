fn trabalhador(id: int, tarefas: chan int, resultados: chan str) {
  for t := range tarefas {
    resultados <- "w" + str(id) + ":" + str(t * t)
  }
}
tarefas := make(chan int, 10)
resultados := make(chan str, 10)
for w := 1; w <= 3; w++ { go trabalhador(w, tarefas, resultados) }
for i := 1; i <= 5; i++ { tarefas <- i }
close(tarefas)
for i := 0; i < 5; i++ { print(<-resultados) }

ping := make(chan str)
pong := make(chan str)
go fn() {
  for i := 0; i < 3; i++ {
    msg := <-ping
    pong <- msg + " pong"
  }
}()
for i := 0; i < 3; i++ {
  ping <- "ping" + str(i)
  print(<-pong)
}

done := make(chan bool)
dados := make(chan int)
go fn() {
  for i := 0; i < 3; i++ { dados <- i; sleep(0.1) }
  done <- true
}()
fim := false
for !fim {
  select {
  case v := <-dados:
    print("dado", v)
  case <-done:
    print("acabou")
    fim = true
  }
}
c := make(chan int, 1)
select {
case v := <-c: print("recebi", v)
default: print("nada pronto")
}
v, ok := <-tarefas
print(v, ok)
go fn() { sleep(0.2); print("goroutine dormiu") }()
sleep(0.5)
print("fim do main")
bloq := make(chan int)
<-bloq
