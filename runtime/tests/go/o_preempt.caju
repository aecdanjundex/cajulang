c := make(chan int, 10)
fn conta(id: int, n: int, c: chan int) {
  t := 0
  for i := 0; i < n; i++ { t += i % 7 }
  c <- id * 1000000 + t
}
for k := 1; k <= 5; k++ { go conta(k, 3000 * k, c) }
for k := 1; k <= 5; k++ { print(<-c) }
done := make(chan bool)
let total = 0
for k := 0; k < 4; k++ {
  go fn() {
    for i := 0; i < 2500; i++ { total++ }
    done <- true
  }()
}
for k := 0; k < 4; k++ { <-done }
print("total", total)
