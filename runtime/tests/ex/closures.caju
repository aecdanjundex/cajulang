# Funções são valores: dá para guardar, passar e devolver.
fn aplica(xs: []int, f: fn(int) -> int) -> []int {
  r := []int{}
  for _, x := range xs { r = append(r, f(x)) }
  return r
}
dobro := fn(x: int) -> int { return x * 2 }
print(aplica([]int{1, 2, 3}, dobro))
print(aplica([]int{1, 2, 3}, fn(x: int) -> int { return x * x }))

# uma closure enxerga as variáveis de fora e continua com elas
fn contador() -> fn() -> int {
  n := 0
  return fn() -> int {
    n++
    return n
  }
}
a := contador()
b := contador()
print(a(), a(), a(), b())

# cada volta do laço tem a sua variável (como no Go 1.22)
fs := []fn() -> int{}
for i := 0; i < 3; i++ { fs = append(fs, fn() -> int { return i * 10 }) }
for _, f := range fs { print(f()) }

# método como valor: o receptor fica preso
struct Conta { saldo: int }
fn (c: *Conta) deposita(v: int) { c.saldo += v }
c := &Conta{}
dep := c.deposita
dep(50)
dep(25)
print(c.saldo)
