# Erros são valores: a função devolve o resultado e um error.
fn divide(a: int, b: int) -> (int, error) {
  if b == 0 { return 0, errors.New("divisão por zero") }
  return a / b, nil
}
for _, d := range []int{3, 0} {
  q, err := divide(10, d)
  if err != nil {
    print("erro:", err)
    continue
  }
  print("10 /", d, "=", q)
}

# defer agenda uma chamada para a saída da função (do último para o primeiro)
fn tarefa() {
  defer print("3. arruma a mesa")
  defer print("2. lava a louça")
  print("1. janta")
}
tarefa()

# panic desfaz as chamadas; recover, dentro de um defer, para o panic
fn seguro(f: fn()) -> (err: error) {
  defer fn() {
    if r := recover(); r != nil { err = errors.New("recuperado: " + str(r)) }
  }()
  f()
  return nil
}
print(seguro(fn() { panic("algo deu errado") }))
print(seguro(fn() {
  lista := []int{1, 2, 3}
  i := 5
  print(lista[i])               # erro ao rodar também vira panic
}))
print(seguro(fn() { print("tudo certo") }))
