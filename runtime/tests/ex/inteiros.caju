# Cada tipo inteiro tem o seu tamanho e dá a volta, como no Go.
let b: uint8 = 250
for i := 0; i < 8; i++ { b++ }
print("uint8 250 + 8 =", b)
let c: int8 = 127
c++
print("int8 127 + 1 =", c)
print(int8(200), uint16(70000), uint32(-1))

# divisão inteira corta; ** é potência
print(7 / 2, -7 / 2, 7 % 3, 7.0 / 2, 2 ** 10)

# bits: & | ^ (ou exclusivo) &^ << >>
let flags: uint8 = 0b0000_0101
print(flags & 0b100, flags | 0b10, flags ^ 0xFF, flags &^ 1, 1 << 7, 200 >> 3)
print("^0 =", ^0)

# runas e bytes
for i, r := range "Olá ☕" { print(i, r, string(r)) }
print([]byte("é"), len("é"), len([]rune("é")))
