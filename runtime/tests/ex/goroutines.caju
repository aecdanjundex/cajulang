# go começa uma goroutine; canais levam valores entre elas.
fn trabalhador(id: int, tarefas: chan int, resultados: chan str) {
  for t := range tarefas {
    sleep(0.1)                  # finge que trabalha
    resultados <- "trabalhador " + str(id) + " fez a tarefa " + str(t)
  }
}
tarefas := make(chan int, 10)
resultados := make(chan str, 10)
for w := 1; w <= 3; w++ { go trabalhador(w, tarefas, resultados) }
for t := 1; t <= 6; t++ { tarefas <- t }
close(tarefas)
for i := 0; i < 6; i++ { print(<-resultados) }

# select espera o primeiro canal que ficar pronto
relogio := make(chan int)
fim := make(chan bool)
go fn() {
  for i := 1; i <= 3; i++ {
    sleep(0.2)
    relogio <- i
  }
  fim <- true
}()
laço:
for {
  select {
  case n := <-relogio: print("tique", n)
  case <-fim:
    print("acabou")
    break laço
  }
}

# se todas as goroutines ficam esperando, o programa para: deadlock
c := make(chan int)
print("esperando um valor que nunca vem...")
print(<-c)
