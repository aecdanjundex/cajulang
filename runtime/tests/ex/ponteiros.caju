# &x é o endereço de x; *p é o valor apontado.
fn zera(p: *int) { *p = 0 }
x := 42
p := &x
*p += 8
print(x)
zera(&x)
print(x)

# struct com ponteiro: uma lista ligada
struct No { valor: int, prox: *No }
lista := &No{valor: 1, prox: &No{valor: 2, prox: &No{valor: 3}}}
for n := lista; n != nil; n = n.prox { print("nó", n.valor) }

# métodos com receptor *T mudam o original
struct Ponto { x: int, y: int }
fn (p: *Ponto) move(dx: int, dy: int) { p.x += dx; p.y += dy }
fn (p: Ponto) dist() -> int { return p.x * p.x + p.y * p.y }
pt := Ponto{3, 4}
pt.move(1, 1)
print(pt, pt.dist())

# struct embutida: Carro ganha os campos e métodos de Motor
struct Motor { potencia: int }
fn (m: Motor) ronco() -> str { return "vrum " + str(m.potencia) }
fn (m: *Motor) turbina() { m.potencia *= 2 }
struct Carro { Motor; modelo: str }
car := Carro{Motor{90}, "fusca"}
car.turbina()
print(car.modelo, car.potencia, car.ronco())

q := new(int)
print(*q, q != nil)
