#include <winver.h>
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3FL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "CompanyName", "{{CAJU:COMPANY}}################################################################################"
      VALUE "FileDescription", "{{CAJU:DESCRIPTION}}############################################################################################################"
      VALUE "FileVersion", "{{CAJU:FILEVERSION}}############"
      VALUE "InternalName", "{{CAJU:INTERNAL}}###############################################"
      VALUE "LegalCopyright", "{{CAJU:COPYRIGHT}}##############################################################################################################"
      VALUE "OriginalFilename", "{{CAJU:ORIGINAL}}###############################################"
      VALUE "ProductName", "{{CAJU:PRODUCT}}################################################################################"
      VALUE "ProductVersion", "{{CAJU:PRODUCTVERSION}}#########"
      VALUE "Comments", "{{CAJU:COMMENTS}}###############################################################################################################################################"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END

1 24 "caju-runtime.manifest"
