# x86-64 assembler: port of class X64 of bootstrap/native.js.
# Machine code goes into a bytes.Buffer. Symbols (labels, functions, data) are strings; their
# position is kept in syms as off * 2 + section (0 text, 1 data). Jumps, calls and RIP-relative
# operands leave a fixup (a 32-bit hole) resolved when the section addresses are known.

import "std/bytes"

export const RAX = 0
export const RCX = 1
export const RDX = 2
export const RBX = 3
export const RSP = 4
export const RBP = 5
export const RSI = 6
export const RDI = 7
export const R8 = 8
export const R9 = 9
export const R10 = 10
export const R11 = 11
export const R12 = 12
export const R13 = 13
export const R14 = 14
export const R15 = 15

# condition codes
export const CC_O = 0
export const CC_B = 2
export const CC_AE = 3
export const CC_E = 4
export const CC_NE = 5
export const CC_BE = 6
export const CC_A = 7
export const CC_S = 8
export const CC_NS = 9
export const CC_P = 10
export const CC_NP = 11
export const CC_L = 12
export const CC_GE = 13
export const CC_LE = 14
export const CC_G = 15

export const SEC_TEXT = 0
export const SEC_DATA = 1

# one level of cold code: its bytes and the fixups, labels and jumps recorded in them
struct Cold {
  b: *bytes.Buffer
  fix: []int
  syms: []str
  jat: []int
  jfix: []int
  jcc: []int
}
fn new_cold() -> *Cold {
  return &Cold{b: bytes.new_buffer(1 << 10), fix: []int{}, syms: []str{}, jat: []int{}, jfix: []int{}, jcc: []int{}}
}

export struct X64 {
  b: *bytes.Buffer
  syms: map[str]int        # symbol -> off * 2 + section
  fix_at: []int
  fix_sym: []str
  fix_end: []int
  nlab: int
  # num variables kept in XMM registers (caller-saved): each call stores them in their frame
  # slot before and reloads them after
  xs_reg: []int
  xs_off: []int
  # the same for integer variables kept in RSI, RDI, R8..R11
  sv_regs: []int
  sv_offs: []int
  # cold code (error paths): emitted into a side buffer between cold_begin and cold_end, and
  # appended after the function by flush_cold, so that the hot path falls through. Cold code
  # inside cold code goes to the next level (it must not be on the path of the outer one).
  hot: *bytes.Buffer
  colds: []*Cold
  in_cold: int             # current level (0: hot)
  # jumps (jmp: cc -1) to relax at the end: rel8 when the target is near, none when it is next
  j_at: []int
  j_fix: []int
  j_cc: []int
  add8_end: int            # end of the last `add rsp, 8` (-1: none), for push (peephole)
  bind_at: int             # position of the last label bound
}

export fn new_x64() -> *X64 {
  return &X64{b: bytes.new_buffer(1 << 16), syms: map[str]int{}, fix_at: []int{}, fix_sym: []str{}, fix_end: []int{}, nlab: 0,
    hot: nil, colds: []*Cold{}, in_cold: 0, j_at: []int{}, j_fix: []int{}, j_cc: []int{}, add8_end: -1, bind_at: -1,
    xs_reg: []int{}, xs_off: []int{}, sv_regs: []int{}, sv_offs: []int{}}
}

export fn (a: *X64) pos() -> int { return a.b.n }
export fn (a: *X64) byte(x: int) { a.b.byte(x & 255) }
export fn (a: *X64) byte2(x: int, y: int) {
  a.b.byte(x & 255)
  a.b.byte(y & 255)
}
export fn (a: *X64) byte3(x: int, y: int, z: int) {
  a.b.byte(x & 255)
  a.b.byte(y & 255)
  a.b.byte(z & 255)
}
export fn (a: *X64) byte4(x: int, y: int, z: int, w: int) {
  a.b.byte(x & 255)
  a.b.byte(y & 255)
  a.b.byte(z & 255)
  a.b.byte(w & 255)
}
export fn (a: *X64) d32(v: int) { a.b.u32(v) }
export fn (a: *X64) d64(v: int) { a.b.u64(v) }

# an opcode of one or two bytes (0x0FAF = 0F AF)
fn (a: *X64) op(op: int) {
  if op > 255 { a.b.byte(op >> 8) }
  a.b.byte(op & 255)
}
fn (a: *X64) pre(p: int) { if p != 0 { a.b.byte(p) } }

export fn (a: *X64) rex(w: int, r: int, bb: int, force: bool) {
  v := 0x40 | (w << 3) | (((r >> 3) & 1) << 2) | ((bb >> 3) & 1)
  if v != 0x40 || force { a.b.byte(v) }
}
# register with register: modrm 11 reg rm
export fn (a: *X64) rrx(op: int, reg: int, rm: int, w: int, pre: int) {
  a.pre(pre)
  a.rex(w, reg, rm, false)
  a.op(op)
  a.b.byte(0xC0 | ((reg & 7) << 3) | (rm & 7))
}
export fn (a: *X64) rr(op: int, reg: int, rm: int) { a.rrx(op, reg, rm, 1, 0) }
export fn (a: *X64) rr32(op: int, reg: int, rm: int) { a.rrx(op, reg, rm, 0, 0) }
# register with [base + disp] (disp8 when it fits, else disp32)
export fn (a: *X64) rmx(op: int, reg: int, base: int, disp: int, w: int, pre: int) {
  a.pre(pre)
  a.rex(w, reg, base, false)
  a.op(op)
  if disp >= -128 && disp <= 127 {
    a.b.byte(0x40 | ((reg & 7) << 3) | (base & 7))
    if (base & 7) == 4 { a.b.byte(0x24) }
    a.b.byte(disp & 255)
    return
  }
  a.b.byte(0x80 | ((reg & 7) << 3) | (base & 7))
  if (base & 7) == 4 { a.b.byte(0x24) }
  a.b.u32(disp)
}
export fn (a: *X64) rm(op: int, reg: int, base: int, disp: int) { a.rmx(op, reg, base, disp, 1, 0) }
# register with [base + index * (1 << scale)], no displacement (base: not rbp nor r13)
export fn (a: *X64) rsib(op: int, reg: int, base: int, index: int, scale: int, w: int) {
  v := 0x40 | (w << 3) | (((reg >> 3) & 1) << 2) | (((index >> 3) & 1) << 1) | ((base >> 3) & 1)
  if v != 0x40 { a.b.byte(v) }
  a.op(op)
  a.b.byte(0x04 | ((reg & 7) << 3))
  a.b.byte((scale << 6) | ((index & 7) << 3) | (base & 7))
}
# register with [rip + symbol]
export fn (a: *X64) ripx(op: int, reg: int, sym: str, w: int, pre: int, after: int) {
  a.pre(pre)
  a.rex(w, reg, 0, false)
  a.op(op)
  a.b.byte(0x05 | ((reg & 7) << 3))
  at := a.b.n
  a.b.u32(0)
  a.add_fix(at, sym, at + 4 + after)
}
export fn (a: *X64) rip(op: int, reg: int, sym: str) { a.ripx(op, reg, sym, 1, 0, 0) }
fn (a: *X64) add_fix(at: int, sym: str, end: int) {
  if a.in_cold > 0 {
    c := a.colds[a.in_cold - 1]
    c.fix = append(c.fix, len(a.fix_at))
  }
  a.fix_at = append(a.fix_at, at)
  a.fix_sym = append(a.fix_sym, sym)
  a.fix_end = append(a.fix_end, end)
}
export fn (a: *X64) label() -> str {
  s := ".L" + str(a.nlab)
  a.nlab++
  return s
}
export fn (a: *X64) bind(sym: str) {
  a.syms[sym] = a.b.n * 2 + SEC_TEXT
  a.bind_at = a.b.n
  if a.in_cold > 0 {
    c := a.colds[a.in_cold - 1]
    c.syms = append(c.syms, sym)
  }
}
export fn (a: *X64) bind_data(sym: str, off: int) { a.syms[sym] = off * 2 + SEC_DATA }
fn (a: *X64) add_jump(at: int, cc: int) {
  if a.in_cold > 0 {
    c := a.colds[a.in_cold - 1]
    c.jat = append(c.jat, at)
    c.jfix = append(c.jfix, len(a.fix_at))
    c.jcc = append(c.jcc, cc)
    return
  }
  a.j_at = append(a.j_at, at)
  a.j_fix = append(a.j_fix, len(a.fix_at))
  a.j_cc = append(a.j_cc, cc)
}
export fn (a: *X64) jmp(sym: str) {
  a.add_jump(a.b.n, -1)
  a.b.byte(0xE9)
  at := a.b.n
  a.b.u32(0)
  a.add_fix(at, sym, at + 4)
}
export fn (a: *X64) jcc(cc: int, sym: str) {
  a.add_jump(a.b.n, cc)
  a.b.byte(0x0F)
  a.b.byte(0x80 + cc)
  at := a.b.n
  a.b.u32(0)
  a.add_fix(at, sym, at + 4)
}

# ---- cold code ----
export fn (a: *X64) cold_begin() {
  if a.in_cold == 0 { a.hot = a.b }
  if a.in_cold == len(a.colds) { a.colds = append(a.colds, new_cold()) }
  a.b = a.colds[a.in_cold].b
  a.in_cold++
  a.add8_end = -1
  a.bind_at = -1
}
export fn (a: *X64) cold_end() {
  a.in_cold--
  if a.in_cold == 0 { a.b = a.hot } else { a.b = a.colds[a.in_cold - 1].b }
  a.add8_end = -1
  a.bind_at = -1
}
# appends the cold code to the text (after a function's ret: it is only reached by jumps)
export fn (a: *X64) flush_cold() {
  if a.in_cold != 0 { panic("x64: flush_cold inside cold code") }
  for _, c := range a.colds {
    base := a.b.n
    a.b.append(c.b)
    for _, i := range c.fix {
      a.fix_at[i] += base
      a.fix_end[i] += base
    }
    for _, s := range c.syms { a.syms[s] = a.syms[s] + base * 2 }
    for i, at := range c.jat {
      a.j_at = append(a.j_at, at + base)
      a.j_fix = append(a.j_fix, c.jfix[i])
      a.j_cc = append(a.j_cc, c.jcc[i])
    }
    c.b.reset()
    c.fix = []int{}
    c.syms = []str{}
    c.jat = []int{}
    c.jfix = []int{}
    c.jcc = []int{}
  }
}

# ---- final layout: short jumps (rel8), jumps to the next instruction removed ----
# the number of positions in xs (sorted) below p
fn count_below(xs: []int, p: int) -> int {
  lo := 0
  hi := len(xs)
  while lo < hi {
    mid := (lo + hi) / 2
    if xs[mid] < p { lo = mid + 1 } else { hi = mid }
  }
  return lo
}
fn jump_len(cc: int) -> int {
  if cc < 0 { return 5 }
  return 6
}
export fn (a: *X64) finish() {
  a.flush_cold()
  nj := len(a.j_at)
  # the target of each jump (-1: not a text label, stays rel32)
  tgt := []int{}
  for k := 0; k < nj; k++ {
    t := -1
    s, ok := a.syms[a.fix_sym[a.j_fix[k]]]
    if ok && (s & 1) == SEC_TEXT { t = s >> 1 }
    tgt = append(tgt, t)
  }
  # state: 0 rel32, 1 rel8, 2 removed; shrinking only brings code closer, so it converges
  st := make([]int, nj)
  cum := make([]int, nj + 1)                      # bytes removed by the jumps before k
  changed := true
  while changed {
    changed = false
    for k := 0; k < nj; k++ {
      r := 0
      if st[k] == 1 { r = jump_len(a.j_cc[k]) - 2 } else if st[k] == 2 { r = jump_len(a.j_cc[k]) }
      cum[k + 1] = cum[k] + r
    }
    for k := 0; k < nj; k++ {
      t := tgt[k]
      if t < 0 || st[k] == 2 { continue }
      at := a.j_at[k]
      jl := 2                                      # bytes this jump has now
      if st[k] == 0 { jl = jump_len(a.j_cc[k]) }
      nat := at - cum[k]
      nt := t - cum[count_below(a.j_at, t)]
      if t > at && nt - (nat + jl) == 0 {
        st[k] = 2
        changed = true
        continue
      }
      if st[k] == 1 { continue }
      if t > at { nt -= jl - 2 }
      d := nt - (nat + 2)
      if d >= -128 && d <= 127 {
        st[k] = 1
        changed = true
      }
    }
  }
  for k := 0; k < nj; k++ {
    r := 0
    if st[k] == 1 { r = jump_len(a.j_cc[k]) - 2 } else if st[k] == 2 { r = jump_len(a.j_cc[k]) }
    cum[k + 1] = cum[k] + r
  }
  # rewrite the code
  out := bytes.new_buffer(a.b.n + 16)
  src := a.b
  cur := 0
  for k := 0; k < nj; k++ {
    at := a.j_at[k]
    copy_range(out, src, cur, at)
    cur = at
    if st[k] == 1 {
      disp := a.final_pos(tgt[k], cum) - (a.final_pos(at, cum) + 2)
      if a.j_cc[k] < 0 { out.byte(0xEB) } else { out.byte(0x70 + a.j_cc[k]) }
      out.byte(disp & 255)
      cur = at + jump_len(a.j_cc[k])
    } else if st[k] == 2 {
      cur = at + jump_len(a.j_cc[k])
    }
  }
  copy_range(out, src, cur, src.n)
  # fixups of the jumps that went away; the others move
  drop := make([]bool, len(a.fix_at))
  for k2 := 0; k2 < nj; k2++ { if st[k2] != 0 { drop[a.j_fix[k2]] = true } }
  fa := []int{}
  fs := []str{}
  fe := []int{}
  for x := 0; x < len(a.fix_at); x++ {
    if drop[x] { continue }
    # the end moves with the instruction (a position right after it may move differently)
    nf := a.final_pos(a.fix_at[x], cum)
    fa = append(fa, nf)
    fs = append(fs, a.fix_sym[x])
    fe = append(fe, nf + a.fix_end[x] - a.fix_at[x])
  }
  a.fix_at = fa
  a.fix_sym = fs
  a.fix_end = fe
  for name, s := range a.syms {
    if (s & 1) == SEC_TEXT { a.syms[name] = a.final_pos(s >> 1, cum) * 2 + SEC_TEXT }
  }
  a.b = out
  a.j_at = []int{}
  a.j_fix = []int{}
  a.j_cc = []int{}
}
# where position p goes in the final layout
fn (a: *X64) final_pos(p: int, cum: []int) -> int { return p - cum[count_below(a.j_at, p)] }
fn copy_range(out: *bytes.Buffer, src: *bytes.Buffer, lo: int, hi: int) {
  for x := lo; x < hi; x++ { out.byte(src.get(x)) }
}
export fn (a: *X64) call(sym: str) {
  a.spill()
  a.b.byte(0xE8)
  at := a.b.n
  a.b.u32(0)
  a.add_fix(at, sym, at + 4)
  a.fill()
}
# a call that never returns (a runtime error): nothing to keep
export fn (a: *X64) call_noret(sym: str) {
  a.b.byte(0xE8)
  at := a.b.n
  a.b.u32(0)
  a.add_fix(at, sym, at + 4)
}
# call rax
export fn (a: *X64) call_rax() {
  a.spill()
  a.byte2(0xFF, 0xD0)
  a.fill()
}
# caller-saved registers that hold variables: to their frame slots before a call, back after
export fn (a: *X64) spill() {
  for i, x := range a.xs_reg { a.movsd_store(RBP, a.xs_off[i], x) }
  for i, r := range a.sv_regs { a.store(RBP, a.sv_offs[i], r) }
}
export fn (a: *X64) fill() {
  for i, x := range a.xs_reg { a.movsd_load(x, RBP, a.xs_off[i]) }
  for i, r := range a.sv_regs { a.load(r, RBP, a.sv_offs[i]) }
}
export fn (a: *X64) ret() { a.b.byte(0xC3) }
export fn (a: *X64) mov_imm(r: int, x: int) {
  if x == 0 {
    a.rr32(0x31, r, r)              # xor r32, r32
    return
  }
  if x > 0 && x < 0x80000000 {
    a.rex(0, 0, r, false)
    a.b.byte(0xB8 + (r & 7))
    a.b.u32(x)
    return
  }
  a.rex(1, 0, r, false)
  a.b.byte(0xB8 + (r & 7))
  a.b.u64(x)
}
export fn (a: *X64) mov(dst: int, src: int) { a.rr(0x89, src, dst) }
export fn (a: *X64) load(r: int, base: int, disp: int) { a.rm(0x8B, r, base, disp) }
export fn (a: *X64) store(base: int, disp: int, r: int) { a.rm(0x89, r, base, disp) }
export fn (a: *X64) load_sym(r: int, sym: str) { a.rip(0x8B, r, sym) }
export fn (a: *X64) store_sym(sym: str, r: int) { a.rip(0x89, r, sym) }
export fn (a: *X64) lea(r: int, sym: str) { a.rip(0x8D, r, sym) }
export fn (a: *X64) push(r: int) {
  # add rsp, 8; push rax -> mov [rsp], rax (the slot just freed is reused; nothing jumps between)
  if r == RAX && a.add8_end == a.b.n && a.bind_at != a.b.n {
    a.b.truncate(a.b.n - 4)
    a.add8_end = -1
    a.byte4(0x48, 0x89, 0x04, 0x24)
    return
  }
  if r >= 8 { a.b.byte(0x41) }
  a.b.byte(0x50 + (r & 7))
}
export fn (a: *X64) pop(r: int) {
  if r >= 8 { a.b.byte(0x41) }
  a.b.byte(0x58 + (r & 7))
}
# add sub and or xor cmp test
export fn (a: *X64) alu(op: str, dst: int, src: int) {
  c := 0
  switch op {
  case "add": c = 0x01
  case "sub": c = 0x29
  case "and": c = 0x21
  case "or": c = 0x09
  case "xor": c = 0x31
  case "cmp": c = 0x39
  case "test": c = 0x85
  }
  a.rr(c, src, dst)
}
export fn (a: *X64) imul(dst: int, src: int) { a.rr(0x0FAF, dst, src) }
export fn (a: *X64) add_imm(r: int, v: int) { a.alu_imm(0, r, v) }
export fn (a: *X64) sub_imm(r: int, v: int) { a.alu_imm(5, r, v) }
# sub r, imm32 always (its immediate is patched later: the frame size)
export fn (a: *X64) sub_imm32(r: int, v: int) {
  a.rex(1, 0, r, false)
  a.b.byte(0x81)
  a.b.byte(0xE8 | (r & 7))
  a.b.u32(v)
}
export fn (a: *X64) cmp_imm(r: int, v: int) { a.alu_imm(7, r, v) }
# 0 add, 1 or, 4 and, 5 sub, 6 xor, 7 cmp: r op= v (v must fit in 32 bits, sign-extended)
export fn (a: *X64) alu_imm(ext: int, r: int, v: int) {
  a.rex(1, 0, r, false)
  if v >= -128 && v <= 127 {
    a.b.byte(0x83)
    a.b.byte(0xC0 | (ext << 3) | (r & 7))
    a.b.byte(v & 255)
    if ext == 0 && r == RSP && v == 8 { a.add8_end = a.b.n }
    return
  }
  a.b.byte(0x81)
  a.b.byte(0xC0 | (ext << 3) | (r & 7))
  a.b.u32(v)
}
# r op= [base + disp] (op: 0x03 add, 0x2B sub, 0x23 and, 0x0B or, 0x33 xor, 0x3B cmp)
export fn (a: *X64) alu_mem(op: int, r: int, base: int, disp: int) { a.rmx(op, r, base, disp, 1, 0) }
# 2 not, 3 neg, 6 div, 7 idiv
export fn (a: *X64) unary(ext: int, r: int) {
  a.rex(1, 0, r, false)
  a.b.byte(0xF7)
  a.b.byte(0xC0 | (ext << 3) | (r & 7))
}
# 4 shl, 5 shr, 7 sar
export fn (a: *X64) shift_cl(ext: int, r: int) {
  a.rex(1, 0, r, false)
  a.b.byte(0xD3)
  a.b.byte(0xC0 | (ext << 3) | (r & 7))
}
export fn (a: *X64) cqo() { a.byte2(0x48, 0x99) }
# 4 shl, 5 shr, 7 sar by an immediate count (1..63)
export fn (a: *X64) shift_imm(ext: int, r: int, c: int) {
  a.rex(1, 0, r, false)
  a.b.byte(0xC1)
  a.b.byte(0xC0 | (ext << 3) | (r & 7))
  a.b.byte(c)
}
# imul dst, src, v (v fits in a sign-extended 32-bit immediate)
export fn (a: *X64) imul_imm(dst: int, src: int, v: int) {
  if v >= -128 && v <= 127 {
    a.rr(0x6B, dst, src)
    a.b.byte(v & 255)
    return
  }
  a.rr(0x69, dst, src)
  a.b.u32(v)
}
export fn (a: *X64) setcc(cc: int, r8: int) {
  a.rex(0, 0, r8, r8 >= 4)
  a.b.byte(0x0F)
  a.b.byte(0x90 + cc)
  a.b.byte(0xC0 | (r8 & 7))
}
# movzx r32, r8 (zeroes the rest)
export fn (a: *X64) movzxb(dst: int, src: int) { a.rr32(0x0FB6, dst, src) }
# floating point
export fn (a: *X64) movq_x(x: int, r: int) { a.rrx(0x0F6E, x, r, 1, 0x66) }     # movq xmm, r64
export fn (a: *X64) movq_r(r: int, x: int) { a.rrx(0x0F7E, x, r, 1, 0x66) }     # movq r64, xmm
# addsd 58, mulsd 59, subsd 5C, divsd 5E, sqrtsd 51 (pre F2); cvtsd2ss 5A
export fn (a: *X64) ssep(op: int, x: int, y: int, pre: int) { a.rrx(0x0F00 | op, x, y, 0, pre) }
export fn (a: *X64) sse(op: int, x: int, y: int) { a.rrx(0x0F00 | op, x, y, 0, 0xF2) }
export fn (a: *X64) movsd_load(x: int, base: int, disp: int) { a.rmx(0x0F10, x, base, disp, 0, 0xF2) }
export fn (a: *X64) movsd_store(base: int, disp: int, x: int) { a.rmx(0x0F11, x, base, disp, 0, 0xF2) }
export fn (a: *X64) ucomisd(x: int, y: int) { a.rrx(0x0F2E, x, y, 0, 0x66) }
export fn (a: *X64) cvtsi2sd(x: int, r: int) { a.rrx(0x0F2A, x, r, 1, 0xF2) }
export fn (a: *X64) cvttsd2si(r: int, x: int) { a.rrx(0x0F2C, r, x, 1, 0xF2) }
