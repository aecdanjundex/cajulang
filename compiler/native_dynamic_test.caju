# Untyped functions, any, interfaces, type switches and errors in the native compiler
# (migrated from tests/native/dynamic.caju).
import { describe, it, expect } from "std/testing"

fn sum(a, b) { return a + b }
fn divide(a, b) { return a / b }
fn largest(a, b) {
  if a > b { return a }
  return b
}
fn truthy(x) {
  if x { return "yes" }
  return "no"
}
fn halves(x: int) -> (int, int) { return x / 2, x % 2 }
fn names() -> (first: str, last: str) {
  first = "Ana"
  last = "Lima"
  return
}
fn forward() -> (str, str) { return names() }
fn factory(base: int) -> (fn(int) -> int, fn() -> int) {
  total := base
  add := fn(x: int) -> int { total += x; return total }
  get := fn() -> int { return total }
  return add, get
}
fn compose(f: fn(int) -> int, g: fn(int) -> int) -> fn(int) -> int {
  return fn(x: int) -> int { return g(f(x)) }
}
fn add3(x: int) -> int { return x + 3 }

struct Op { name: str, f: fn(int, int) -> int }
struct Counter { n: int }
fn (c: Counter) value() -> int { return c.n }
fn (c: *Counter) plus() { c.n++ }

interface Speaker { speak() -> str }
struct Cat { name: str }
fn (g: Cat) speak() -> str { return g.name + ": meow" }
struct Robot { id: int }
fn (r: *Robot) speak() -> str { r.id++; return "beep " + str(r.id) }

fn kind(x: any) -> str {
  switch y := x.(type) {
  case int, num: return "number " + str(y)
  case str: return "text " + y
  case Speaker: return "speaker " + y.speak()
  case nil: return "nothing"
  }
  return "other"
}

fn attempt(x: int) -> (int, error) {
  if x < 0 { return 0, errors.New("negative: " + str(x)) }
  return x * 10, nil
}

struct Box { content: any }

describe("untyped functions", fn() {
  it("add numbers and join texts by the types of the values", fn() {
    expect(str([]any{sum(1, 2), sum(1.5, 2), sum("a", 1), sum(2, "b"), divide(7, 2), divide(6, 3)})).to_equal("[3 3.5 \"a1\" \"2b\" 3.5 2]")
    expect(str([]any{sum(0.5, 0.5), divide(1, 3), sum(-3, 3)})).to_equal("[1 0.333333333333 0]")
  })
  it("compare numbers and texts", fn() {
    expect(str([]any{largest(3, 9), largest("pear", "café"), largest(2.5, 1)})).to_equal("[9 \"pear\" 2.5]")
  })
  it("treat zero, empty text, nil and false as false, and everything else as true", fn() {
    got := []str{truthy(0), truthy(1), truthy(""), truthy("x"), truthy(nil), truthy(false), truthy(0.0), truthy([]int{})}
    expect(got).to_equal([]str{"no", "yes", "no", "yes", "no", "no", "yes", "yes"})
  })
})

describe("any", fn() {
  it("holds values of every type and knows which are nil", fn() {
    let xs: []any = []any{1, 2.5, "three", true, nil, []int{4}, map[str]int{"a": 1}}
    expect(str(xs)).to_equal("[1 2.5 \"three\" true nil [4] map[\"a\":1]]")
    expect(xs).to_have_length(7)
    nils := []bool{}
    for _, x := range xs { nils = append(nils, x == nil) }
    expect(nils).to_equal([]bool{false, false, false, false, true, false, false})
  })
  it("compares an int and a float as different values", fn() {
    let a: any = 5
    let b: any = 5
    let c: any = 5.0
    expect([]bool{a == b, a == c, a != c, a == 5, c == 5.0}).to_equal([]bool{true, false, true, true, true})
  })
  it("converts back to int and num", fn() {
    let a: any = 5
    let c: any = 5.0
    let n: int = a
    let f: num = c
    expect(str([]any{n + 1, f / 2, int(c) + 1, num(a) / 2})).to_equal("[6 2.5 6 2.5]")
  })
  it("prints inside maps and structs", fn() {
    let mm: map[str]any = map[str]any{"n": 1, "s": "x", "l": []any{1, "two"}}
    expect(str(mm)).to_equal("map[\"l\":[1 \"two\"] \"n\":1 \"s\":\"x\"]")
    expect(mm["n"]).to_equal(1)
    expect(mm["zz"]).to_be_nil()
    expect(str([]any{Box{3}, Box{"hi"}, Box{nil}, Box{&Robot{1}}})).to_equal("[Box{content: 3} Box{content: \"hi\"} Box{content: nil} Box{content: &Robot{id: 1}}]")
  })
})

describe("multiple results", fn() {
  it("are received, skipped with _, and forwarded", fn() {
    q, r := halves(17)
    expect([]int{q, r}).to_equal([]int{8, 1})
    _, r2 := halves(4)
    expect(r2).to_equal(0)
    p1, p2 := forward()
    expect([]str{p1, p2}).to_equal([]str{"Ana", "Lima"})
  })
})

describe("function values", fn() {
  it("share state between closures returned together", fn() {
    add, get := factory(10)
    add(5)
    add(7)
    expect(get()).to_equal(22)
  })
  it("compose", fn() {
    inc := fn(x: int) -> int { return x + 1 }
    dbl := fn(x: int) -> int { return x * 2 }
    expect(compose(inc, dbl)(3)).to_equal(8)
    expect(compose(dbl, inc)(3)).to_equal(7)
    expect(compose(add3, add3)(1)).to_equal(7)
  })
  it("capture each value of a range over texts", fn() {
    let fs: []fn() -> str = nil
    for _, s := range []str{"a", "b", "c"} { fs = append(fs, fn() -> str { return s + s }) }
    got := []str{}
    for _, fx := range fs { got = append(got, fx()) }
    expect(got).to_equal([]str{"aa", "bb", "cc"})
  })
  it("live in struct fields", fn() {
    ops := []Op{Op{"plus", fn(a: int, b: int) -> int { return a + b }}, Op{"times", fn(a: int, b: int) -> int { return a * b }}}
    expect(ops[0].f(6, 7)).to_equal(13)
    expect(ops[1].f(6, 7)).to_equal(42)
  })
  it("bind methods: a value receiver is copied, a pointer receiver is shared", fn() {
    ct := Counter{1}
    v := ct.value
    m := ct.plus
    m()
    m()
    expect([]int{v(), ct.n, ct.value()}).to_equal([]int{1, 3, 3})
  })
})

describe("interfaces", fn() {
  it("call value and pointer methods", fn() {
    let fl: []Speaker = []Speaker{Cat{"Tom"}, &Robot{7}}
    got := []str{}
    for _, x := range fl { got = append(got, x.speak(), x.speak()) }
    expect(got).to_equal([]str{"Tom: meow", "Tom: meow", "beep 8", "beep 9"})
    expect(str(fl)).to_equal("[Cat{name: \"Tom\"} &Robot{id: 9}]")
  })
  it("assert the dynamic type", fn() {
    let g: Speaker = Cat{"Mia"}
    gg, ok := g.(Cat)
    expect(gg.name).to_equal("Mia")
    expect(ok).to_be_true()
    _, ok2 := g.(*Robot)
    expect(ok2).to_be_false()
  })
  it("pick the case of a type switch", fn() {
    got := []str{kind(1), kind(2.5), kind("x"), kind(Cat{"Lu"}), kind(nil), kind(true)}
    expect(got).to_equal([]str{"number 1", "number 2.5", "text x", "speaker Lu: meow", "nothing", "other"})
  })
})

describe("errors", fn() {
  it("are values that can be nil", fn() {
    e1 := errors.New("failed")
    let e2: error = nil
    expect(e1).to_be_error("failed")
    expect(e2).to_be_nil()
    expect(e1 == nil).to_be_false()
    expect(e2 == nil).to_be_true()
  })
  it("come back as the last result", fn() {
    w, err := attempt(3)
    expect(w).to_equal(30)
    expect(err).to_be_nil()
    _, err2 := attempt(-2)
    expect(err2).to_be_error("negative: -2")
  })
})
