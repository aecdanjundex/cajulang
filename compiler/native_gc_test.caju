# The garbage collector of the native runtime (migrated from tests/native/gc3m.caju and
# gc_mixed.caju): many short-lived objects, and values that must survive many collections.
import { describe, it, expect } from "std/testing"

struct Node { v: int, name: str, next: *Node }
struct Tree { v: int, left: *Tree, right: *Tree }

fn build(d: int, v: int) -> *Tree {
  if d == 0 { return nil }
  garbage := []int{1, 2, 3, 4, 5, 6, 7, 8}
  a := &Tree{v: v + garbage[0] - 1}
  a.left = build(d - 1, 2 * v)
  a.right = build(d - 1, 2 * v + 1)
  return a
}
fn sum(a: *Tree) -> int {
  if a == nil { return 0 }
  return a.v + sum(a.left) + sum(a.right)
}

describe("the garbage collector", fn() {
  it("frees 3 million linked objects when only a few are alive at a time", fn() {
    let list: *Node = nil
    total := 0
    for i := 0; i < 3000000; i++ {
      list = &Node{v: i, name: "n" + str(i % 100), next: list}
      if i % 10000 == 9999 {
        for p := list; p != nil; p = p.next { total += p.v % 7 }
        list = nil
      }
    }
    expect(total).to_equal(8999994)
  })
  it("frees maps and slices that grow and are dropped", fn() {
    total := 0
    for r := 0; r < 200; r++ {
      m := map[int][]int{}
      for k := 0; k < 500; k++ { m[k] = append(m[k], k, r) }
      total += len(m) + m[499][1]
    }
    expect(total).to_equal(119900)
  })
  it("keeps a structure that stays reachable intact", fn() {
    pinned := []*Node{}
    for i := 0; i < 1000; i++ { pinned = append(pinned, &Node{v: i, name: "pinned"}) }
    let garbage: *Node = nil
    for i := 0; i < 1000000; i++ { garbage = &Node{v: i} }
    ok := true
    for i, n := range pinned { if n.v != i or n.name != "pinned" { ok = false } }
    expect(ok).to_be_true()
  })
  it("keeps trees, maps of any and closures alive across collections", fn() {
    pinned := build(12, 1)
    names := map[str]any{}
    fs := []fn() -> str{}
    total := 0
    for r := 0; r < 40; r++ {
      t := build(10, r)
      total += sum(t)
      k := "key" + str(r)
      names[k] = []any{r, k, 2.5 * num(r)}
      fs = append(fs, fn() -> str { return k + "!" })
      if r % 7 == 0 { delete(names, "key" + str(r - 7)) }
    }
    expect(total).to_equal(279599540)
    expect(sum(pinned)).to_equal(8386560)
    expect(names).to_have_length(35)
    expect(names["key39"]).to_equal([]any{39, "key39", 97.5})
    expect(fs[0]()).to_equal("key0!")
    expect(fs[39]()).to_equal("key39!")
  })
  it("builds a long text piece by piece", fn() {
    txt := ""
    for i := 0; i < 3000; i++ { txt = txt + str(i % 10) }
    expect(txt).to_have_length(3000)
    expect(txt[2990:]).to_equal("0123456789")
  })
})
