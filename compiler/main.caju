# caju: the command line of the Caju compiler.
#
#   caju build [-o output] [--target linux|windows] file.caju
#   caju run file.caju [arguments...]      compile in memory and run (nothing written to disk)
#   caju test [-v] [--run text] [--record] [dir|file ...]          run the test suite (tests/*)
#   caju bench [--runs=N] [--note=text] [--history] [filter]
#   caju version
#
# The installation root (CAJU_ROOT, default: the directory above the one holding this program)
# has lib/ (the standard library), rt/ (the runtime, written in Caju) and tests/ and bench/.

import "std/os"
import "std/strings"
import "std/strconv"
import "std/bytes"
import "ast"
import "project"
import "native"
import "pkg"
import "std/fs"
import filepath "std/path"


fn usage() {
  os.stderr("usage:\n  caju build [-o output] [--target linux|windows] file.caju\n  caju run file.caju [arguments...]\n  caju test [-v] [--run text] [--record] [dir|file ...]\n  caju bench [--runs=N] [--note=text] [--history] [filter]\n  caju pkg init|add|remove|update|install|verify|tree|hash ...\n  caju version\n")
  os.exit(2)
}

fn root() -> str {
  r := os.getenv("CAJU_ROOT")
  if r != "" { return r }
  exe := os.executable()
  dir := exe[0:strings.last_index(exe, "/")]
  return dir[0:strings.last_index(dir, "/")]
}

fn die(msg: str) {
  os.eprintln("caju: " + msg)
  os.exit(1)
}

fn read_or_die(path: str) -> str {
  s, err := os.read_file(path)
  if err != nil { die(err.Error()) }
  return s
}

# the runtime sources, in the order the code generator expects
fn rt_sources(target: str) -> []str {
  dir := root() + "/rt/"
  out := []str{}
  for _, n := range []str{"core", "gc", "values", "dynamic", "panic", target} { out = append(out, read_or_die(dir + n + ".caju")) }
  return out
}

# compiles a program; on a compile error returns the message (as the bootstrap prints it)
fn compile(entry: str, target: str) -> (*bytes.Buffer, str) { return compile_as(entry, target, false) }

# with test, the entry is a test file: it must import std/testing, and std/testing's finish()
# runs after its top level (to print the summary and set the exit code)
fn compile_as(entry: str, target: str, test: bool) -> (image: *bytes.Buffer, message: str) {
  files := []*ast.SourceFile{}
  defer fn() {
    r := recover()
    if r != nil {
      e, ok := r.(*ast.CompileError)
      if !ok { panic(r) }
      names := []str{}
      if len(files) == 0 { files = project.loading }      # an error while loading the files
      for _, f := range files { names = append(names, f.name) }
      image = nil
      message = ast.format_error(e, names)
    }
  }()
  pkgs, err := pkg.packages_for(entry)
  if err != nil {
    message = "Package error: " + err.Error()
    return
  }
  files = project.load_project_with(entry, root() + "/lib", pkgs)
  if test {
    found := false
    for _, f := range files { if f.name == "std/testing.caju" { found = true } }
    if !found {
      message = entry + ": a test file must import std/testing (import { describe, it, expect } from \"std/testing\")"
      return
    }
    files[0].src = files[0].src + "\nimport __caju_testing \"std/testing\"\n__caju_testing.finish()\n"
  }
  image = native.compile_native(files, rt_sources(target), target)
  return
}

fn base_name(path: str) -> str {
  i := strings.last_index(path, "/")
  b := path[i + 1:]
  return strings.trim_suffix(b, ".caju")
}

fn cmd_build(args: []str) {
  out := ""
  target := "linux"
  entry := ""
  i := 0
  while i < len(args) {
    a := args[i]
    if a == "-o" && i + 1 < len(args) {
      out = args[i + 1]
      i += 2
      continue
    }
    if a == "--target" && i + 1 < len(args) {
      target = args[i + 1]
      i += 2
      continue
    }
    if entry != "" || strings.has_prefix(a, "-") { usage() }
    entry = a
    i++
  }
  if entry == "" { usage() }
  if target != "linux" && target != "windows" { die("unknown target \"" + target + "\" (linux or windows)") }
  if out == "" {
    out = base_name(entry)
    if target == "windows" { out = out + ".exe" }
  }
  image, msg := compile(entry, target)
  if image == nil {
    os.eprintln(msg)
    os.exit(1)
  }
  err := os.write_file(out, image.string(), 0o755)
  if err != nil { die(err.Error()) }
}

fn cmd_run(args: []str) {
  if len(args) == 0 { usage() }
  image, msg := compile(args[0], "linux")
  if image == nil {
    os.eprintln(msg)
    os.exit(1)
  }
  err := os.exec_bytes(base_name(args[0]), image.string(), args, os.environ())
  die(err.Error())
}

# ---------------------------------------------------------------- tests

fn git_commit() -> str {
  p, err := os.run([]str{"git", "-C", root(), "rev-parse", "--short", "HEAD"}, nil, false)
  if err != nil || p.code != 0 { return "none" }
  c := strings.trim_space(p.output)
  q, _ := os.run([]str{"git", "-C", root(), "status", "--porcelain"}, nil, false)
  if q != nil && strings.trim_space(q.output) != "" { c = c + "+" }
  return c
}

fn now_iso() -> str {
  p, err := os.run([]str{"date", "-u", "+%Y-%m-%dT%H:%M:%SZ"}, nil, false)
  if err != nil { return "" }
  return strings.trim_space(p.output)
}

fn json_list(xs: []str) -> str {
  q := []str{}
  for _, x := range xs { q = append(q, strconv.quote(x)) }
  return "[" + strings.join(q, ",") + "]"
}

fn append_line(path: str, line: str) {
  old, _ := os.read_file(path)
  err := os.write_file(path, old + line + "\n", 0o644)
  if err != nil { die(err.Error()) }
}

# the test files under a path: *_test.caju, skipping testdata/, build/ and hidden directories
fn find_tests(p: str) -> []str {
  if strings.has_suffix(p, ".caju") { return []str{p} }
  files, err := fs.walk_files(p)
  if err != nil { die(err.Error()) }
  out := []str{}
  for _, f := range files {
    if !strings.has_suffix(f, "_test.caju") { continue }
    skip := false
    for _, part := range strings.split(f, "/") {
      if part == "testdata" || part == "build" || part == "node_modules" || strings.has_prefix(part, ".") { skip = true }
    }
    if !skip { out = append(out, filepath.join(p, f)) }
  }
  return out
}

# this program's environment with some variables set (replacing them if present)
fn env_with(vars: []str) -> []str {
  out := []str{}
  for _, kv := range os.environ() {
    keep := true
    for _, v := range vars { if strings.has_prefix(kv, v[0:strings.index(v, "=") + 1]) { keep = false } }
    if keep { out = append(out, kv) }
  }
  for _, v := range vars { out = append(out, v) }
  return out
}

# reads "# P passed, F failed, S skipped" (the last line std/testing prints)
fn parse_summary(out: str) -> (p: int, f: int, s: int, ok: bool) {
  lines := strings.split(strings.trim_suffix(out, "\n"), "\n")
  last := lines[len(lines) - 1]
  if !strings.has_prefix(last, "# ") { return 0, 0, 0, false }
  nums := []int{}
  for _, w := range strings.fields(last[2:]) {
    n, err := strconv.atoi(strings.trim_suffix(w, ","))
    if err == nil { nums = append(nums, n) }
  }
  if len(nums) != 3 { return 0, 0, 0, false }
  return nums[0], nums[1], nums[2], true
}

fn cmd_test(args: []str) {
  record := false
  verbose := false
  filter := ""
  paths := []str{}
  i := 0
  while i < len(args) {
    a := args[i]
    if a == "--record" { record = true } else if a == "-v" { verbose = true } else if a == "--run" && i + 1 < len(args) {
      filter = args[i + 1]
      i++
    } else if strings.has_prefix(a, "-") { usage() } else { paths = append(paths, a) }
    i++
  }
  if len(paths) == 0 { paths = []str{"."} }
  files := []str{}
  for _, dir := range paths { for _, f := range find_tests(dir) { files = append(files, f) } }
  if len(files) == 0 { die("no test files (*_test.caju) in " + strings.join(paths, " ")) }
  tmp, err := fs.temp_dir("", "caju-test-")
  if err != nil { die(err.Error()) }
  bin := tmp + "/t"
  env := env_with([]str{"CAJU_BIN=" + os.executable(), "CAJU_ROOT=" + root(), "CAJU_SKIP_SLEEP=1", "CAJU_TEST_RUN=" + filter})
  tp := 0
  tf := 0
  ts := 0
  bad_files := []str{}
  for _, f := range files {
    image, msg := compile_as(f, "linux", true)
    if image == nil {
      if strings.contains(msg, "not supported yet") {
        print("skip " + f + ": " + msg)
        continue
      }
      print("FAIL " + f + "\n" + msg)
      bad_files = append(bad_files, f)
      continue
    }
    err = os.write_file(bin, image.string(), 0o755)
    if err != nil { die(err.Error()) }
    p, err2 := os.run([]str{"sh", "-c", "cd \"$1\" && exec timeout 120 \"$2\"", "sh", filepath.dir(f), bin}, env, true)
    if err2 != nil { die(err2.Error()) }
    np, nf, ns, ok := parse_summary(p.output)
    tp += np
    tf += nf
    ts += ns
    out := strings.trim_suffix(p.output, "\n")
    if ok && nf == 0 && p.code == 0 {
      if verbose { print(out + "\n") }
      note := str(np) + " tests"
      if ns > 0 { note = note + ", " + str(ns) + " skipped" }
      print("ok   " + f + " (" + note + ")")
      continue
    }
    bad_files = append(bad_files, f)
    if !ok {
      why := "exit code " + str(p.code)
      if p.code == 124 { why = "timed out" }
      out = out + "\n<the test program stopped before the end: " + why + ">"
    }
    print("FAIL " + f + "\n" + out + "\n")
  }
  fs.remove_all(tmp)
  print("\n" + str(tp) + " passed, " + str(tf) + " failed, " + str(ts) + " skipped in " + str(len(files)) + " files")
  if record {
    line := "{\"date\":" + strconv.quote(now_iso()) + ",\"commit\":" + strconv.quote(git_commit())
    line += ",\"compiler\":\"self\",\"passed\":" + str(tp) + ",\"failed\":" + str(tf) + ",\"skipped\":" + str(ts) + ",\"failed_files\":" + json_list(bad_files) + "}"
    append_line(root() + "/tests/history.jsonl", line)
  }
  if len(bad_files) > 0 { os.exit(1) }
}

# ---------------------------------------------------------------- benchmarks

fn ms(ns: int) -> int { return (ns + 500000) / 1000000 }

fn pad_left(s: str, n: int) -> str {
  while len(s) < n { s = " " + s }
  return s
}
fn pad_right(s: str, n: int) -> str {
  while len(s) < n { s = s + " " }
  return s
}

fn cmd_bench(args: []str) {
  runs := 3
  note := ""
  filter := ""
  for _, a := range args {
    if strings.has_prefix(a, "--runs=") {
      runs, _ = strconv.atoi(a[7:])
    } else if strings.has_prefix(a, "--note=") {
      note = a[7:]
    } else if a == "--history" {
      p, err := os.run([]str{"cat", root() + "/bench/history.jsonl"}, nil, false)
      if err == nil { os.stdout(p.output) }
      return
    } else { filter = a }
  }
  dir := root() + "/bench/programs/"
  p, err := os.run([]str{"ls", "-1", dir}, nil, false)
  if err != nil { die(err.Error()) }
  tmp := "/tmp/caju-bench-" + str(os.getpid())
  entries := []str{}
  bad := 0
  print("benchmark          compile ms   size KB    run ms   memory MB")
  for _, f := range strings.split(strings.trim_space(p.output), "\n") {
    if !strings.has_suffix(f, ".caju") || (filter != "" && !strings.contains(f, filter)) { continue }
    name := f[0:len(f) - 5]
    t0 := os.nanotime()
    image, msg := compile(dir + f, "linux")
    compile_ns := os.nanotime() - t0
    if image == nil {
      print(pad_right(name, 18) + " " + msg)
      bad++
      continue
    }
    os.write_file(tmp, image.string(), 0o755)
    best := -1
    rss := 0
    out := ""
    for i := 0; i < runs; i++ {
      t1 := os.nanotime()
      r, err2 := os.run([]str{"/usr/bin/time", "-f", "%M", "-o", tmp + ".mem", tmp}, nil, false)
      dt := os.nanotime() - t1
      if err2 != nil { die(err2.Error()) }
      if best < 0 || dt < best { best = dt }
      m, _ := os.read_file(tmp + ".mem")
      kb, _ := strconv.atoi(strings.trim_space(m))
      if kb > rss { rss = kb }
      out = r.output
    }
    expect, e3 := os.read_file(dir + name + ".out")
    flag := ""
    if e3 == nil && expect != out {
      flag = "WRONG OUTPUT"
      bad++
    }
    print(pad_right(name, 18) + " " + pad_left(str(ms(compile_ns)), 10) + " " + pad_left(str(image.len() / 1024), 9) + " " + pad_left(str(ms(best)), 9) + " " + pad_left(strconv.format_float(num(rss * 10 / 1024) / 10.0), 11) + "   " + flag)
    entries = append(entries, strconv.quote(name) + ":{\"compile_ms\":" + str(ms(compile_ns)) + ",\"size\":" + str(image.len()) + ",\"run_ms\":" + str(ms(best)) + ",\"rss_kb\":" + str(rss) + "}")
  }
  os.remove(tmp)
  os.remove(tmp + ".mem")
  if filter == "" {
    append_line(root() + "/bench/history.jsonl", "{\"date\":" + strconv.quote(now_iso()) + ",\"commit\":" + strconv.quote(git_commit()) + ",\"compiler\":\"self\",\"note\":" + strconv.quote(note) + ",\"results\":{" + strings.join(entries, ",") + "}}")
    print("\nsaved to bench/history.jsonl")
  }
  if bad > 0 { os.exit(1) }
}

let argv = os.args()
if len(argv) < 2 { usage() }
cmd := argv[1]
rest := argv[2:]
if cmd == "build" {
  cmd_build(rest)
} else if cmd == "run" {
  cmd_run(rest)
} else if cmd == "test" {
  cmd_test(rest)
} else if cmd == "bench" {
  cmd_bench(rest)
} else if cmd == "pkg" {
  pkg.command(rest)
} else if cmd == "version" || cmd == "--version" {
  print("caju " + pkg.VERSION)
} else { usage() }
