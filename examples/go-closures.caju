# Functions are values: you can store, pass and return them.
fn apply(xs: []int, f: fn(int) -> int) -> []int {
  r := []int{}
  for _, x := range xs { r = append(r, f(x)) }
  return r
}
double := fn(x: int) -> int { return x * 2 }
print(apply([]int{1, 2, 3}, double))
print(apply([]int{1, 2, 3}, fn(x: int) -> int { return x * x }))

# a closure sees the outer variables and keeps them
fn counter() -> fn() -> int {
  n := 0
  return fn() -> int {
    n++
    return n
  }
}
a := counter()
b := counter()
print(a(), a(), a(), b())

# each loop iteration has its own variable (as in Go 1.22)
fs := []fn() -> int{}
for i := 0; i < 3; i++ { fs = append(fs, fn() -> int { return i * 10 }) }
for _, f := range fs { print(f()) }

# method as a value: the receiver is bound
struct Account { balance: int }
fn (c: *Account) deposit(v: int) { c.balance += v }
c := &Account{}
dep := c.deposit
dep(50)
dep(25)
print(c.balance)
