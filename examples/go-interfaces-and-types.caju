# An interface accepts any type that has its methods.
interface Shape { area() -> num; name() -> str }
struct Rectangle { w: num, h: num }
struct Circle { r: num }
fn (r: Rectangle) area() -> num { return r.w * r.h }
fn (r: Rectangle) name() -> str { return "rectangle" }
fn (c: *Circle) area() -> num { return 3.14159 * c.r * c.r }
fn (c: *Circle) name() -> str { return "circle" }

shapes := []Shape{Rectangle{2, 3}, &Circle{1}}
for _, f := range shapes { print(f.name(), f.area()) }

# x.(T) gets the stored type; with ", ok" it does not panic
if c, ok := shapes[1].(*Circle); ok { print("radius", c.r) }
_, ok := shapes[0].(*Circle)
print("is the first one a circle?", ok)

# type switch
fn describe(x: any) -> str {
  switch v := x.(type) {
  case int: return "integer " + str(v)
  case num: return "number " + str(v)
  case str: return "string of " + str(len(v)) + " bytes"
  case []int: return "slice with " + str(len(v)) + " items"
  case error: return "error: " + v.Error()
  case nil: return "nil"
  default: return "something else"
  }
}
for _, x := range []any{7, 2.5, "café", []int{1, 2}, errors.New("oops"), nil, true} { print(describe(x)) }
